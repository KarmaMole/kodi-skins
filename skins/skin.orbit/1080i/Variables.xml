<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are returned as NAMES from colors/defaults.xml.
	Note: $VAR works in colordiffuse="" and <textcolor>/<focusedcolor>, NOT in diffuse="" or border="".
-->
<includes>
	<!-- ===================================================================== colours -->
	<!-- Orbit has one accent (signal amber). Kept as a variable so inherited windows stay valid. -->
	<variable name="ColorAccent">
		<value>accent</value>
	</variable>
	<variable name="ColorRule">
		<value>line</value>
	</variable>
	<variable name="ColorRuleStrong">
		<value>border_button</value>
	</variable>
	<variable name="ColorCaption">
		<value>text_secondary</value>
	</variable>

	<!-- ==================================================================== textures -->
	<!-- Focus frame for tiles: corner brackets (9-slice border 16 at the item rect -7px each side) -->
	<variable name="FocusFrame">
		<value>focus/outline_2.png</value>
	</variable>
	<variable name="FocusFrameAlways">
		<value>focus/outline_2.png</value>
	</variable>
	<variable name="ButtonFill">
		<value>common/rect_round8.png</value>
	</variable>
	<variable name="ButtonOutline">
		<value>common/rect_outline_1_round8.png</value>
	</variable>
	<variable name="MarkerUnwatched">
		<value>markers/unwatched_pip.png</value>
	</variable>
	<variable name="MarkerWatched">
		<value>markers/watched_badge.png</value>
	</variable>

	<!-- Ring faces (setting "ring style"): engraved ticks + numerals, or the bare track -->
	<variable name="RingFaceRating180"><value condition="$EXP[RingMinimal]">rings/dial_min_180.png</value><value>rings/dial_rating_180.png</value></variable>
	<variable name="RingFaceRating200"><value condition="$EXP[RingMinimal]">rings/dial_min_200.png</value><value>rings/dial_rating_200.png</value></variable>
	<variable name="RingFaceRating260"><value condition="$EXP[RingMinimal]">rings/dial_min_260.png</value><value>rings/dial_rating_260.png</value></variable>
	<variable name="RingFaceClock180"><value condition="$EXP[RingMinimal]">rings/dial_minclock_180.png</value><value>rings/dial_clock_180.png</value></variable>
	<variable name="RingFaceClock200"><value condition="$EXP[RingMinimal]">rings/dial_minclock_200.png</value><value>rings/dial_clock_200.png</value></variable>
	<variable name="RingFaceClock260"><value condition="$EXP[RingMinimal]">rings/dial_minclock_260.png</value><value>rings/dial_clock_260.png</value></variable>
	<variable name="RingFaceProgress180"><value condition="$EXP[RingMinimal]">rings/dial_min_180.png</value><value>rings/dial_progress_180.png</value></variable>
	<variable name="RingFaceProgress200"><value condition="$EXP[RingMinimal]">rings/dial_min_200.png</value><value>rings/dial_progress_200.png</value></variable>
	<variable name="RingFaceProgress260"><value condition="$EXP[RingMinimal]">rings/dial_min_260.png</value><value>rings/dial_progress_260.png</value></variable>

	<!-- ====================================================================== labels -->
	<variable name="DateLabel">
		<value>$INFO[System.Date(ddd d mmm)]</value>
	</variable>
	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>
	<!-- "Sun 18 Oct · 14° light rain" (weather bits only when a weather add-on reports) -->
	<variable name="DateWeatherLabel">
		<value condition="!String.IsEmpty(Weather.Conditions)">$INFO[System.Date(ddd d mmm)]$INFO[Weather.Temperature,  ·  ,]$INFO[Weather.Conditions, ,]</value>
		<value>$INFO[System.Date(ddd d mmm)]</value>
	</variable>

	<!-- Poster/thumb for any list item -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- Kodi stores US certifications as "Rated PG-13": show the bare code -->
	<variable name="ListItemMPAA">
		<value condition="String.StartsWith(ListItem.MPAA,Rated )">$INFO[ListItem.MPAA]</value>
		<value>$INFO[ListItem.MPAA]</value>
	</variable>
	<!-- "2h 25m" -->
	<variable name="ListItemRuntime">
		<value condition="Integer.IsGreater(ListItem.Duration(h),0)">$INFO[ListItem.Duration(h),,h ]$INFO[ListItem.Duration(m),,m]</value>
		<value condition="!String.IsEmpty(ListItem.Duration)">$INFO[ListItem.Duration(m),,m]</value>
	</variable>
	<!-- "ends 23:33" (resume-aware): ListItem.EndTime / EndTimeResume (VideoGUIInfo.cpp) -->
	<variable name="ListItemEnds">
		<value condition="ListItem.IsResumable">$INFO[ListItem.EndTimeResume]</value>
		<value>$INFO[ListItem.EndTime]</value>
	</variable>

	<!-- OSD -->
	<variable name="OSDTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<variable name="OSDKicker">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.Season,S,]$INFO[VideoPlayer.Episode,E,]$INFO[VideoPlayer.Title,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ,]</value>
		<value>$INFO[VideoPlayer.Year]</value>
	</variable>
	<variable name="OSDTimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]$INFO[Player.Duration, / ,]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
	<variable name="OSDStateLabel">
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$INFO[Player.SeekStepSize]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)">$INFO[Player.SeekOffset]</value>
		<value condition="Player.Paused">$LOCALIZE[112]</value>
		<value condition="Player.Forwarding | Player.Rewinding">$INFO[Player.PlaySpeed,,x]</value>
	</variable>
	<variable name="OSDHelpLabel">
		<value condition="Control.HasFocus(87)">$LOCALIZE[31120]</value>
		<value condition="Control.HasFocus(600)">$LOCALIZE[31121]</value>
		<value condition="Control.HasFocus(601)">$LOCALIZE[31122]</value>
		<value condition="Control.HasFocus(602)">$LOCALIZE[31123]</value>
		<value condition="Control.HasFocus(603)">$LOCALIZE[31124]</value>
		<value condition="Control.HasFocus(606)">$LOCALIZE[31125]</value>
		<value condition="Control.HasFocus(607)">$LOCALIZE[31126]</value>
		<value condition="Control.HasFocus(70046)">$LOCALIZE[31127]</value>
		<value condition="Control.HasFocus(70049)">$LOCALIZE[31128]</value>
		<value condition="Control.HasFocus(70048)">$LOCALIZE[31129]</value>
	</variable>

	<!-- ============================================================ skin settings -->
	<!-- Cycle helpers: SkinSettings rows run Skin.SetString(name,$VAR[Next...]) -->
	<variable name="NextLibView"><value condition="String.IsEqual(Skin.String(orbit.libview),grid)">arc</value><value>grid</value></variable>
	<variable name="LabelLibView"><value condition="String.IsEqual(Skin.String(orbit.libview),grid)">Grid</value><value>Arc</value></variable>
	<variable name="NextRingStyle"><value condition="String.IsEqual(Skin.String(orbit.ringstyle),minimal)">full</value><value>minimal</value></variable>
	<variable name="LabelRingStyle"><value condition="String.IsEqual(Skin.String(orbit.ringstyle),minimal)">Minimal</value><value>Engraved</value></variable>
	<variable name="NextArtBackground">
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),faint)">soft</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),soft)">off</value>
		<value>faint</value>
	</variable>
	<variable name="LabelArtBackground">
		<value condition="!System.AddonIsEnabled(plugin.video.themoviedb.helper)">Off (needs TMDb Helper)</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),faint)">Faint</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),soft)">Soft</value>
		<value>Off</value>
	</variable>
	<variable name="NextHomeMovies">
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">inprogress</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">toprated</value>
		<value>recent</value>
	</variable>
	<variable name="LabelHomeMovies">
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">Recently added</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">In progress</value>
		<value>Unwatched, rated 7.5+</value>
	</variable>
	<variable name="NextOSDAutoHide">
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),3)">5</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),10)">off</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),off)">3</value>
		<value>10</value>
	</variable>
	<variable name="PrevOSDAutoHide">
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),3)">off</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),10)">5</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),off)">10</value>
		<value>3</value>
	</variable>
	<variable name="LabelOSDAutoHide">
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),3)">3 seconds</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),10)">10 seconds</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),off)">Never</value>
		<value>5 seconds</value>
	</variable>
	<variable name="PrevHomeMovies">
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">toprated</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">recent</value>
		<value>inprogress</value>
	</variable>
	<variable name="PrevArtBackground">
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),faint)">off</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),soft)">faint</value>
		<value>soft</value>
	</variable>
	<variable name="LabelTrailer"><value condition="Skin.HasSetting(orbit.hidetrailer)">Hidden</value><value>Shown</value></variable>
	<variable name="LabelReduceMotion"><value condition="Skin.HasSetting(orbit.reducemotion)">On</value><value>Off</value></variable>
	<variable name="LabelReset">
		<value condition="!String.IsEmpty(Window(Home).Property(orbit.resetarmed))">[COLOR accent]Press OK again to reset every Orbit setting[/COLOR]</value>
		<value>Reset all skin settings</value>
	</variable>
	<!-- settings instrument (focused row) -->
	<variable name="Set_FocusTitle">
		<value condition="Control.HasFocus(9601)">Library opens in</value>
		<value condition="Control.HasFocus(9602)">Ring style</value>
		<value condition="Control.HasFocus(9603)">Films on the Home dial</value>
		<value condition="Control.HasFocus(9604)">Artwork backdrop</value>
		<value condition="Control.HasFocus(9605)">Watched badges</value>
		<value condition="Control.HasFocus(9606)">Trailer button</value>
		<value condition="Control.HasFocus(9607)">Player controls</value>
		<value condition="Control.HasFocus(9608)">Reduce motion</value>
	</variable>
	<variable name="Set_FocusValue">
		<value condition="Control.HasFocus(9601)">$VAR[LabelLibView]</value>
		<value condition="Control.HasFocus(9602)">$VAR[LabelRingStyle]</value>
		<value condition="Control.HasFocus(9603)">$VAR[LabelHomeMovies]</value>
		<value condition="Control.HasFocus(9604)">$VAR[LabelArtBackground]</value>
		<value condition="Control.HasFocus(9605)">$VAR[LabelWatchedMarkers]</value>
		<value condition="Control.HasFocus(9606)">$VAR[LabelTrailer]</value>
		<value condition="Control.HasFocus(9607)">$VAR[LabelOSDAutoHide]</value>
		<value condition="Control.HasFocus(9608)">$VAR[LabelReduceMotion]</value>
	</variable>
	<variable name="Set_FocusHelp">
		<value condition="Control.HasFocus(9601)">Films, shows and albums open on the arc (choose on a dial) or on the grid (scan a big library fast). VIEW in the options row switches any time.</value>
		<value condition="Control.HasFocus(9602)">Engraved draws the minute ticks and numerals round every gauge. Minimal keeps only the track and the amber sweep.</value>
		<value condition="Control.HasFocus(9603)">Which films sweep out of the Home dial when Movies is selected.</value>
		<value condition="Control.HasFocus(9604)">A blurred copy of the focused fanart behind the library, from TMDb Helper's blur service. Off keeps the pure blue-black ground.</value>
		<value condition="Control.HasFocus(9605)">A small check on watched films and episodes, on the arc, the grid and the lists.</value>
		<value condition="Control.HasFocus(9606)">Shows the Trailer button on info pages when a trailer is known.</value>
		<value condition="Control.HasFocus(9607)">During playback the scrubber hides itself after this long without a key press. It stays while paused.</value>
		<value condition="Control.HasFocus(9608)">Turns the arc slides, dial turns and window motion into quick fades.</value>
	</variable>
	<variable name="Set_Knob">
		<value condition="Control.HasFocus(9601) + String.IsEqual(Skin.String(orbit.libview),grid)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9601)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9602) + String.IsEqual(Skin.String(orbit.ringstyle),minimal)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9602)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9603) + String.IsEqual(Skin.String(orbit.homemovies),recent)">rings/knob/3_1.png</value>
		<value condition="Control.HasFocus(9603) + String.IsEqual(Skin.String(orbit.homemovies),inprogress)">rings/knob/3_2.png</value>
		<value condition="Control.HasFocus(9603)">rings/knob/3_0.png</value>
		<value condition="Control.HasFocus(9604) + String.IsEqual(Skin.String(orbit.artbackground),faint)">rings/knob/3_1.png</value>
		<value condition="Control.HasFocus(9604) + String.IsEqual(Skin.String(orbit.artbackground),soft)">rings/knob/3_2.png</value>
		<value condition="Control.HasFocus(9604)">rings/knob/3_0.png</value>
		<value condition="Control.HasFocus(9605) + Skin.HasSetting(orbit.nowatchedbadges)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9605)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9606) + Skin.HasSetting(orbit.hidetrailer)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9606)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9607) + String.IsEqual(Skin.String(orbit.osdhide),3)">rings/knob/4_0.png</value>
		<value condition="Control.HasFocus(9607) + String.IsEqual(Skin.String(orbit.osdhide),10)">rings/knob/4_2.png</value>
		<value condition="Control.HasFocus(9607) + String.IsEqual(Skin.String(orbit.osdhide),off)">rings/knob/4_3.png</value>
		<value condition="Control.HasFocus(9607)">rings/knob/4_1.png</value>
		<value condition="Control.HasFocus(9608) + Skin.HasSetting(orbit.reducemotion)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9608)">rings/knob/2_0.png</value>
	</variable>

	<!-- retired Majan settings (labels kept so inherited rows stay valid until rewritten) -->
	<variable name="LabelFocusOutline"><value>Brackets</value></variable>
	<variable name="AccentName"><value>Signal amber</value></variable>
	<variable name="LabelWatchedMarkers"><value condition="Skin.HasSetting(orbit.nowatchedbadges)">Off</value><value>On</value></variable>
</includes>
