<?xml version="1.0" encoding="UTF-8"?>
<!--
	The library card and the view picker (request docs/requests/library-panel/BRIEF.md, 0.9.11).
	  Custom_1155_LibraryPanel  the Library card: Update library, Clean library, View, Sort, Order, Show,
	                            Search, Library settings (only what applies). Opened by Left past the first
	                            print / Right past the last one in every library view, and by the Options word.
	  Custom_1156_ViewPicker    the views of this window as small schematic prints (media/pp/views, generated by
	                            _src/make_view_previews.py). Opened by the header's view word and the card's View row.
	  Custom_1157_LibraryTask   Update / Clean, with the choice of library and the confirmation (Kodi's
	                            CleanLibrary() builtin does not ask). Home's System card opens it too.
	Inside a dialog, Container.* and Window.IsVisible() read the media window underneath; Control.IsVisible()
	and Control.IsEnabled() read the dialog itself, so nothing here tests view controls.
	Properties on Window(Home): pp.libtask (update | clean), pp.libtarget (video | music | choose).
-->
<includes>
	<expression name="PP_LibInMusic">Window.IsVisible(music)</expression>
	<expression name="PP_LibCanUpdate">!Container.Content(addons) + String.IsEmpty(Container.PluginName)</expression>
	<expression name="PP_LibScanning">[Window.IsVisible(music) + Library.IsScanningMusic] | [!Window.IsVisible(music) + Library.IsScanningVideo]</expression>
	<expression name="PP_LibHasWatchedFilter">Window.IsVisible(videos) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)] + !String.StartsWith(Container.FolderPath,videodb://inprogresstvshows)</expression>

	<!-- the view on show, in the header's words (the series hang is "The hang" there) -->
	<variable name="PP_ViewName">
		<value condition="String.IsEqual(Container.Viewmode,The series hang)">The hang</value>
		<value>$INFO[Container.Viewmode]</value>
	</variable>
	<variable name="PP_LibCaption">
		<value condition="$EXP[PP_LibInMusic]">$VAR[Music_SectionWord]$INFO[Container.NumItems, · ,]</value>
		<value>$VAR[VidView_Section]$INFO[Container.NumItems, · ,]</value>
	</variable>
	<variable name="PP_LibSortHint">
		<value condition="$EXP[PP_LibInMusic]">$VAR[Music_SortWord]</value>
		<value>$VAR[VidView_SortWord]</value>
	</variable>
	<variable name="PP_LibUpdateLabel">
		<value condition="$EXP[PP_LibScanning]">Stop the update</value>
		<value>Update library</value>
	</variable>
	<variable name="PP_LibUpdateHint">
		<value condition="$EXP[PP_LibScanning]">Updating</value>
		<value condition="$EXP[PP_LibInMusic]">Music</value>
		<value>Films &amp; series</value>
	</variable>
	<variable name="PP_LibOrderHint">
		<value condition="Container.SortDirection(descending)">Descending</value>
		<value>Ascending</value>
	</variable>

	<!-- the task card (1157) -->
	<variable name="PP_TaskHeading">
		<value condition="String.IsEqual(Window(Home).Property(pp.libtask),clean) + String.IsEqual(Window(Home).Property(pp.libtarget),video)">Clean the film &amp; series library?</value>
		<value condition="String.IsEqual(Window(Home).Property(pp.libtask),clean) + String.IsEqual(Window(Home).Property(pp.libtarget),music)">Clean the music library?</value>
		<value condition="String.IsEqual(Window(Home).Property(pp.libtask),clean)">Clean the library?</value>
		<value>Update the library</value>
	</variable>
	<variable name="PP_TaskBody">
		<value condition="String.IsEqual(Window(Home).Property(pp.libtask),clean)">Kodi removes the entries whose files it can no longer find, and what it knew about them. The files themselves are not touched.</value>
		<value>Kodi looks through your sources for new films, episodes and albums. It runs in the background.</value>
	</variable>
	<variable name="PP_TaskUpdateVideo">
		<value condition="Library.IsScanningVideo">Stop updating films &amp; series</value>
		<value>Update films &amp; series</value>
	</variable>
	<variable name="PP_TaskUpdateMusic">
		<value condition="Library.IsScanningMusic">Stop updating music</value>
		<value>Update music</value>
	</variable>

	<!-- the picker's mark on the view on show (ListItem.Property(key) of the static items) -->
	<expression name="PP_PickIsList">!String.IsEqual(Container.Viewmode,The hang) + !String.IsEqual(Container.Viewmode,The series hang) + !String.IsEqual(Container.Viewmode,Salon) + !String.IsEqual(Container.Viewmode,The wall)</expression>
	<expression name="PP_PickCurrent">[String.IsEqual(ListItem.Property(key),hang) + String.IsEqual(Container.Viewmode,The hang)] | [String.IsEqual(ListItem.Property(key),series) + String.IsEqual(Container.Viewmode,The series hang)] | [String.IsEqual(ListItem.Property(key),salon) + String.IsEqual(Container.Viewmode,Salon)] | [String.IsEqual(ListItem.Property(key),wall) + String.IsEqual(Container.Viewmode,The wall)] | [String.IsEqual(ListItem.Property(key),list) + $EXP[PP_PickIsList]]</expression>

	<!-- one entry of the picker: the preview as a small matted print, the view's name in caps under it.
	     The name's underline (the view on show) and placard (focus) have the measured word widths
	     (cap_20: THE HANG 127, THE SERIES HANG 223, SALON 84, THE WALL 126, LIST 55; placard = word + 32). -->
	<include name="PP_PickWordMarks">
		<param name="kind">underline</param>
		<definition>
			<control type="image">
				<left>36</left>
				<top>222</top>
				<width>127</width>
				<height>1</height>
				<texture colordiffuse="ink">common/white.png</texture>
				<visible>String.IsEqual(ListItem.Property(key),hang)</visible>
			</control>
			<control type="image">
				<left>36</left>
				<top>222</top>
				<width>223</width>
				<height>1</height>
				<texture colordiffuse="ink">common/white.png</texture>
				<visible>String.IsEqual(ListItem.Property(key),series)</visible>
			</control>
			<control type="image">
				<left>36</left>
				<top>222</top>
				<width>84</width>
				<height>1</height>
				<texture colordiffuse="ink">common/white.png</texture>
				<visible>String.IsEqual(ListItem.Property(key),salon)</visible>
			</control>
			<control type="image">
				<left>36</left>
				<top>222</top>
				<width>126</width>
				<height>1</height>
				<texture colordiffuse="ink">common/white.png</texture>
				<visible>String.IsEqual(ListItem.Property(key),wall)</visible>
			</control>
			<control type="image">
				<left>36</left>
				<top>222</top>
				<width>55</width>
				<height>1</height>
				<texture colordiffuse="ink">common/white.png</texture>
				<visible>String.IsEqual(ListItem.Property(key),list)</visible>
			</control>
		</definition>
	</include>
	<include name="PP_PickPlacard">
		<control type="image">
			<left>20</left>
			<top>188</top>
			<width>159</width>
			<height>44</height>
			<texture colordiffuse="ink">common/white.png</texture>
			<visible>String.IsEqual(ListItem.Property(key),hang)</visible>
		</control>
		<control type="image">
			<left>20</left>
			<top>188</top>
			<width>255</width>
			<height>44</height>
			<texture colordiffuse="ink">common/white.png</texture>
			<visible>String.IsEqual(ListItem.Property(key),series)</visible>
		</control>
		<control type="image">
			<left>20</left>
			<top>188</top>
			<width>116</width>
			<height>44</height>
			<texture colordiffuse="ink">common/white.png</texture>
			<visible>String.IsEqual(ListItem.Property(key),salon)</visible>
		</control>
		<control type="image">
			<left>20</left>
			<top>188</top>
			<width>158</width>
			<height>44</height>
			<texture colordiffuse="ink">common/white.png</texture>
			<visible>String.IsEqual(ListItem.Property(key),wall)</visible>
		</control>
		<control type="image">
			<left>20</left>
			<top>188</top>
			<width>87</width>
			<height>44</height>
			<texture colordiffuse="ink">common/white.png</texture>
			<visible>String.IsEqual(ListItem.Property(key),list)</visible>
		</control>
	</include>
	<include name="PP_PickLayouts">
		<itemlayout width="296" height="248">
			<control type="group">
				<left>20</left>
				<top>20</top>
				<width>256</width>
				<height>144</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>256</width>
					<height>144</height>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<include>PP_Bevel</include>
			</control>
			<control type="label">
				<left>36</left>
				<top>188</top>
				<width>240</width>
				<height>44</height>
				<font>cap_20</font>
				<textcolor>ink2</textcolor>
				<selectedcolor>ink2</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>!$EXP[PP_PickCurrent]</visible>
			</control>
			<control type="group">
				<visible>$EXP[PP_PickCurrent]</visible>
				<control type="label">
					<left>36</left>
					<top>188</top>
					<width>240</width>
					<height>44</height>
					<font>cap_20</font>
					<textcolor>ink</textcolor>
					<selectedcolor>ink</selectedcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<include>PP_PickWordMarks</include>
			</control>
		</itemlayout>
		<focusedlayout width="296" height="248">
			<control type="group">
				<left>20</left>
				<top>20</top>
				<width>256</width>
				<height>144</height>
				<control type="image">
					<left>-24</left>
					<top>-12</top>
					<right>-24</right>
					<bottom>-40</bottom>
					<texture border="64,48,64,76" colordiffuse="$VAR[ShadowColor]">pp/lift_xs.png</texture>
					<visible>Control.HasFocus(100) + !Skin.HasSetting(passepartout.noshadow)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>256</width>
					<height>144</height>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<include>PP_Bevel</include>
			</control>
			<control type="group">
				<visible>Control.HasFocus(100)</visible>
				<include>PP_PickPlacard</include>
				<control type="label">
					<left>36</left>
					<top>188</top>
					<width>240</width>
					<height>44</height>
					<font>cap_20</font>
					<textcolor>$VAR[PaperColor]</textcolor>
					<selectedcolor>$VAR[PaperColor]</selectedcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</control>
			<control type="label">
				<left>36</left>
				<top>188</top>
				<width>240</width>
				<height>44</height>
				<font>cap_20</font>
				<textcolor>ink</textcolor>
				<selectedcolor>ink</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>!Control.HasFocus(100)</visible>
			</control>
		</focusedlayout>
	</include>

</includes>
