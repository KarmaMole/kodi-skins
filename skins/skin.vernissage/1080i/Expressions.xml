<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Expressions: every boolean used in more than one place. Use as $EXP[Name].
	Skin setting names are documented in docs/skin.vernissage/SETTINGS.md.
	Rule (SPEC section 7): an empty string / unset bool always means the default.
-->
<includes>

	<!-- Setting 2: corners -->
	<expression name="IsRounded">false</expression>

	<expression name="FocusOutlineMedium">String.IsEqual(Skin.String(vernissage.focusoutline),medium)</expression>

	<!-- Setting 4: artwork background (empty = faint). Forced off without TMDb Helper. Wired in M2 (T15). -->
	<expression name="ArtBackgroundOn">false</expression>

</includes>
