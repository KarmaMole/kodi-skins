<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library. Layout + ids: Includes_Views_Video.xml (header sentence, views 500/501/503) and
	Includes_Views.xml (view 50). Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav):
	<views>, menucontrol 9000 (the header sentence), 3 sort-by / 4 sort-order, 14 watched toggle.
	Focus map: header phrases (Left/Right) Down -> view; view Up (top row) -> header. Back = parent folder.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ground</backgroundcolor>
	<views>500,501,503,50</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the header sentence instead -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>VidView_Window</include>
	</controls>
</window>
