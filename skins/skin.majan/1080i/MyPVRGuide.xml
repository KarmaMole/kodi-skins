<?xml version="1.0" encoding="UTF-8"?>
<!--
	TV / Radio guide (SPEC 5: Minimal). Builder F, M4. One plain EPG grid (channels as rows, time
	across) with the selected programme's details underneath. PVR is unused by Omar: correct,
	readable, never stranding.
	Kodi id contract (Estuary Omega MyPVRGuide.xml + GUIWindowPVRBase.h): epggrid view container 50
	(Estuary's alternative grids 51-53 are not offered), scrollbar 60, menucontrol 9000, sort 3 / 4,
	channel-group button 28, header labels 29 / 30. Inside the grid layouts, label 1 / image 2 are
	the controls Kodi stretches to each programme's width. Estuary's channel-group strip (list 11)
	is replaced by the Group button in the options row (6054 -> 28).
-->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include content="Misc_PVRFrame">
			<param name="title" value="$LOCALIZE[19069]"/>
			<param name="group_label" value="$INFO[Control.GetLabel(30)]"/>
			<param name="show_group" value="true"/>
		</include>

		<!-- ====== grid (focus group 9100: grid, else the empty-state button) -->
		<control type="group" id="9100">
			<defaultcontrol always="true">50</defaultcontrol>
			<control type="epggrid" id="50">
				<left>page_margin</left>
				<top>misc_pvr_top</top>
				<width>page_width</width>
				<height>639</height>
				<onup>9001</onup>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<timeblocks>36</timeblocks>
				<rulerunit>6</rulerunit>
				<viewtype label="19069">list</viewtype>
				<progresstexture border="0,0,2,0" colordiffuse="$VAR[ColorAccent]">misc/epg_now.png</progresstexture>
				<rulerlayout height="45" width="238">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>1</width>
						<height>45</height>
						<texture colordiffuse="hairline_strong">common/hairline_v.png</texture>
					</control>
					<control type="label">
						<left>10</left>
						<top>0</top>
						<width>220</width>
						<height>45</height>
						<font>mono_13</font>
						<textcolor>text_tertiary</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</rulerlayout>
				<channellayout height="66" width="300">
					<control type="label">
						<left>12</left>
						<top>0</top>
						<width>60</width>
						<height>66</height>
						<font>num_16</font>
						<textcolor>text_tertiary</textcolor>
						<label>$INFO[ListItem.ChannelNumberLabel]</label>
					</control>
					<control type="label" id="1">
						<left>76</left>
						<top>0</top>
						<width>212</width>
						<height>66</height>
						<font>card_21</font>
						<textcolor>text_secondary</textcolor>
						<label>$INFO[ListItem.ChannelName]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>300</width>
						<height>rule_h</height>
						<texture colordiffuse="hairline">common/hairline.png</texture>
					</control>
				</channellayout>
				<focusedchannellayout height="66" width="300">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>list_bar_w</width>
						<height>66</height>
						<texture colordiffuse="$VAR[ColorAccent]">common/white.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="label">
						<left>12</left>
						<top>0</top>
						<width>60</width>
						<height>66</height>
						<font>num_16</font>
						<textcolor>text_secondary</textcolor>
						<label>$INFO[ListItem.ChannelNumberLabel]</label>
					</control>
					<control type="label" id="1">
						<left>76</left>
						<top>0</top>
						<width>212</width>
						<height>66</height>
						<font>card_21_bold</font>
						<textcolor>text_primary</textcolor>
						<label>$INFO[ListItem.ChannelName]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>300</width>
						<height>rule_h</height>
						<texture colordiffuse="hairline">common/hairline.png</texture>
					</control>
				</focusedchannellayout>
				<itemlayout height="66" width="40">
					<control type="image" id="2">
						<left>0</left>
						<top>0</top>
						<width>40</width>
						<height>66</height>
						<texture border="10" colordiffuse="hairline">common/rect_outline_1.png</texture>
					</control>
					<control type="label" id="1">
						<left>12</left>
						<top>0</top>
						<width>20</width>
						<height>66</height>
						<font>small_19</font>
						<textcolor>text_secondary</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout height="66" width="40">
					<control type="image" id="2">
						<left>0</left>
						<top>0</top>
						<width>40</width>
						<height>66</height>
						<texture border="10" colordiffuse="$VAR[ColorAccent]">common/rect_square.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="image" id="2">
						<left>0</left>
						<top>0</top>
						<width>40</width>
						<height>66</height>
						<texture border="10" colordiffuse="border_control">common/rect_outline_1.png</texture>
						<visible>!Control.HasFocus(50)</visible>
					</control>
					<control type="label" id="1">
						<left>12</left>
						<top>0</top>
						<width>20</width>
						<height>66</height>
						<font>small_19_bold</font>
						<textcolor>ink</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="label" id="1">
						<left>12</left>
						<top>0</top>
						<width>20</width>
						<height>66</height>
						<font>small_19</font>
						<textcolor>text_primary</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(50)</visible>
					</control>
				</focusedlayout>
			</control>
			<include content="Misc_EmptyStateButton">
				<param name="top" value="misc_pvr_top"/>
				<param name="label" value="No guide data. Enable a PVR client add-on in PVR &amp; Live TV settings."/>
			</include>
		</control>
		<include content="Majan_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1828"/>
			<param name="top" value="295"/>
			<param name="height" value="594"/>
			<param name="onleft" value="50"/>
			<param name="onright" value="50"/>
		</include>

		<!-- ====== selected programme -->
		<control type="group">
			<left>page_margin</left>
			<top>910</top>
			<width>page_width</width>
			<visible>Control.IsVisible(50) + Integer.IsGreater(Container.NumItems,0)</visible>
			<include content="Majan_Rule">
				<param name="left" value="0"/>
				<param name="top" value="0"/>
			</include>
			<control type="grouplist">
				<left>0</left>
				<top>16</top>
				<width>page_width</width>
				<height>40</height>
				<orientation>horizontal</orientation>
				<itemgap>24</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="1000">auto</width>
					<height>40</height>
					<font>card_21_bold</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[Misc_PVRTitle]$INFO[ListItem.EpisodeName,  ·  ,]</label>
				</control>
				<control type="label">
					<top>4</top>
					<width max="700">auto</width>
					<height>34</height>
					<font>mono_14</font>
					<textcolor>$VAR[ColorAccent]</textcolor>
					<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, - ,]$INFO[ListItem.Genre,  ·  ,]</label>
				</control>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>62</top>
				<width>page_width</width>
				<height>66</height>
				<font>body_23</font>
				<textcolor>text_body</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>  <!-- standard Kodi plot scroll: wait 6s, roll, pause 10s, repeat -->
			</control>
		</control>
	</controls>
</window>
