<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library: rotary text index (50) or sparse cover wall (52). Includes_Views.xml.
	Kodi id contract (Estuary Omega MyMusicNav.xml / GUIWindowMusicNav.cpp): views in <views>,
	menucontrol 9000, 3 sort by, 4 sort order (hidden). Reserved by Kodi here and not reused:
	2, 5, 8, 12, 15, 16, 17, 19, 20. Void ids: 9320-9326 options (Albums / Artists / Songs / Genres
	jump straight to those nodes).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>50,52</views>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<control type="group">
			<visible>!ControlGroup(9000).HasFocus()</visible>
			<include>Void_Anim_Dwell</include>
			<include content="Void_TopBar">
				<param name="title" value="$VAR[Lib_Title]"/>
				<param name="sub" value="$VAR[Lib_Sub]"/>
			</include>
		</control>
		<include content="Void_View50"><param name="viewlabel" value="Index"/></include>
		<include>Void_View52</include>
		<include content="Void_LibraryEmpty">
			<param name="hint" value="Up for Albums, Artists, Songs or Genres."/>
		</include>
		<control type="grouplist" id="9000">
			<include>Void_OptionsBegin</include>
			<ondown>SetFocus(50)</ondown>
			<onback>SetFocus(50)</onback>
			<include content="Void_SubNavButton">
				<param name="id" value="9320"/>
				<param name="label" value="Albums"/>
				<param name="onclick" value="Container.Update(musicdb://albums/)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9321"/>
				<param name="label" value="Artists"/>
				<param name="onclick" value="Container.Update(musicdb://artists/)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9322"/>
				<param name="label" value="Songs"/>
				<param name="onclick" value="Container.Update(musicdb://songs/)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9323"/>
				<param name="label" value="Genres"/>
				<param name="onclick" value="Container.Update(musicdb://genres/)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9324"/>
				<param name="label" value="Sort  $INFO[Container.SortMethod]"/>
				<param name="onclick" value="SendClick(3)"/>
				<param name="visible" value="Control.IsEnabled(3) + !String.IsEmpty(Container.SortMethod)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9325"/>
				<param name="label" value="$VAR[VidLib_Direction]"/>
				<param name="width" value="213"/>
				<param name="onclick" value="Container.SetSortDirection"/>
				<param name="visible" value="Control.IsEnabled(3) + !String.IsEmpty(Container.SortMethod)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9326"/>
				<param name="label" value="View  $INFO[Container.Viewmode]"/>
				<param name="width" value="239"/>
				<param name="onclick" value="Container.NextViewMode"/>
				<param name="visible" value="Integer.IsGreater(Container.ViewCount,1)"/>
			</include>
		</control>
		<include>Void_OptionsCaption</include>
		<include>Void_SortControls</include>
	</controls>
</window>
