<?xml version="1.0" encoding="UTF-8"?>
<!--
	Generic list window + view 50 for every media window that is not the video/music library
	(programs, pictures, add-ons, files, PVR lists...). Same Daylight layout as Films: a detail panel
	on the left, a soft card with the list on the right, header pills (9000) in the card.
	Kodi media-window ids: 3 sort by, 4 sort order, 10 watched toggle (video windows), views in <views>.
-->
<includes>
	<!-- One list row inside a card (1076 wide, 76 high). params: focused, id -->
	<include name="DL_LibListRow">
		<param name="focused">false</param>
		<param name="id">50</param>
		<definition>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1068</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[DL_Accent]">daylight/card20.png</texture>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1068</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[DL_Raised]">daylight/card20.png</texture>
				<visible>$PARAM[focused] + !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="image">
				<left>22</left>
				<top>14</top>
				<width>48</width>
				<height>48</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="masks/square_round8.png">$VAR[DL_RowIcon]</texture>
			</control>
			<control type="label">
				<left>90</left>
				<top>0</top>
				<width>700</width>
				<height>76</height>
				<font>ui_24</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<label>$VAR[DL_RowLabel]</label>
				<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>90</left>
				<top>0</top>
				<width>700</width>
				<height>76</height>
				<font>ui_24_semibold</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$VAR[DL_RowLabel]</label>
				<scroll>true</scroll>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>800</left>
				<top>0</top>
				<width>250</width>
				<height>76</height>
				<align>right</align>
				<font>small_20</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>800</left>
				<top>0</top>
				<width>250</width>
				<height>76</height>
				<align>right</align>
				<font>small_20</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
		</definition>
	</include>
	<variable name="DL_RowLabel">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="DL_RowIcon">
		<value condition="ListItem.IsParentFolder">daylight/icons/back.png</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- ============================================================ View 50 (generic) -->
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<control type="list" id="50">
				<left>702</left>
				<top>262</top>
				<width>1076</width>
				<height>754</height>
				<onup>9000</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<itemlayout width="1076" height="76">
					<include>DL_LibListRow</include>
				</itemlayout>
				<focusedlayout width="1076" height="76">
					<include content="DL_LibListRow"><param name="focused" value="true"/></include>
				</focusedlayout>
			</control>
		</control>
	</include>

	<!-- Detail panel for generic windows: rounded art, title, label2, plot -->
	<include name="DL_GenericDetail">
		<control type="group">
			<left>page_margin</left>
			<top>168</top>
			<width>500</width>
			<height>848</height>
			<visible>Integer.IsGreater(Container.NumItems,0)</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>500</width>
				<height>420</height>
				<aspectratio align="left" aligny="top">keep</aspectratio>
				<fadetime>160</fadetime>
				<texture background="true" colordiffuse="$VAR[DL_ArtDim]">$VAR[DL_RowIconLarge]</texture>
			</control>
			<control type="group">
				<left>0</left>
				<top>440</top>
				<width>500</width>
				<include content="T_Generic_Title">
					<param name="label" value="$VAR[DL_RowLabel]"/>
					<param name="color" value="$VAR[DL_Ink]"/>
				</include>
			</control>
			<control type="label">
				<left>0</left>
				<top>588</top>
				<width>500</width>
				<height>30</height>
				<font>ui_22</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>632</top>
				<width>500</width>
				<height>180</height>
				<font>body_24</font>
				<textcolor>$VAR[DL_Body]</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="8000" time="3000" repeat="10000">!Container.Scrolling</autoscroll>
			</control>
		</control>
	</include>
	<variable name="DL_RowIconLarge">
		<value condition="ListItem.IsParentFolder"></value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- ===================================================== header pills (generic) -->
	<!-- Card header: page title + count left, pills right. params: show_watched, title -->
	<include name="DL_LibraryHeaderBar">
		<param name="show_watched">false</param>
		<param name="title">$VAR[LibraryTitle]</param>
		<definition>
			<control type="grouplist">
				<left>720</left>
				<top>200</top>
				<width>460</width>  <!-- 0.9.4: ends at 1180, before the fixed-width pills (start >= 1190) -->
				<height>48</height>
				<orientation>horizontal</orientation>
				<itemgap>18</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="380">auto</width>
					<height>48</height>
					<font>serif_32</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$PARAM[title]</label>
				</control>
				<control type="label">
					<width max="200">auto</width>
					<height>48</height>
					<font>small_20_semibold</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$INFO[Container.CurrentItem,, of ]$INFO[Container.NumItems]</label>
				</control>
			</control>
			<control type="grouplist" id="9000">
				<left>1000</left>
				<top>204</top>
				<width>760</width>
				<height>40</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>10</itemgap>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>9400</onup>
				<ondown>50</ondown>
				<onback>50</onback>
				<control type="button" id="6050">
					<include content="VidView_PillFixed"><param name="w" value="176"/></include>
					<label>$VAR[VidView_FilterLabel]</label>
					<onclick>SendClick(10)</onclick>
					<visible>$PARAM[show_watched] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)]</visible>
				</control>
				<control type="button" id="6053">
					<include content="VidView_PillFixed"><param name="w" value="200"/></include>
					<label>Sort: $INFO[Container.SortMethod]</label>
					<onclick>SendClick(3)</onclick>
					<visible>Control.IsEnabled(3)</visible>
				</control>
				<control type="button" id="6052">
					<include content="VidView_PillFixed"><param name="w" value="44"/></include>
					<label>$VAR[VidView_SortArrow]</label>
					<onclick>SendClick(4)</onclick>
					<visible>Control.IsEnabled(4)</visible>
				</control>
				<control type="button" id="6051">
					<include content="VidView_PillFixed"><param name="w" value="124"/></include>
					<label>View: $INFO[Container.Viewmode]</label>
					<onclick>Container.NextViewMode</onclick>
					<visible>Integer.IsGreater(Container.ViewCount,1)</visible>
				</control>
			</control>
			<control type="button" id="3">
				<description>Sort by (Kodi)</description>
				<include>DL_Hidden</include>
			</control>
			<control type="button" id="4">
				<description>Sort order (Kodi)</description>
				<include>DL_Hidden</include>
			</control>
		</definition>
	</include>

	<!-- ========================================== generic list window -->
	<!-- Background + top line + card + header pills + view 50 + detail panel. params: index, title -->
	<include name="DL_GenericListWindow">
		<param name="index"></param>
		<param name="title">$VAR[LibraryTitle]</param>
		<param name="show_watched">false</param>
		<definition>
			<include>DL_Background</include>
			<control type="group">
				<left>680</left>
				<top>168</top>
				<width>1120</width>
				<height>848</height>
				<include>DL_Card</include>
			</control>
			<include>DL_GenericDetail</include>
			<include>View_50_List</include>
			<control type="image">
				<left>680</left>
				<top>866</top>
				<width>1120</width>
				<height>150</height>
				<texture diffuse="daylight/mask_fade_card.png" colordiffuse="$VAR[DL_Surface]">daylight/fade_bottom_150.png</texture>
			</control>
			<include content="DL_LibraryHeaderBar">
				<param name="show_watched" value="$PARAM[show_watched]"/>
				<param name="title" value="$PARAM[title]"/>
			</include>
			<include content="DL_LibraryTopLine">
				<param name="gid" value="9400"/>
				<param name="p" value="940"/>
				<param name="ondown" value="9000"/>
			</include>
			<!-- empty folder / still loading -->
			<control type="group">
				<left>720</left>
				<top>300</top>
				<width>1040</width>
				<height>120</height>
				<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>1040</width>
					<height>48</height>
					<font>serif_34</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>Nothing here.</label>
				</control>
			</control>
		</definition>
	</include>
</includes>
