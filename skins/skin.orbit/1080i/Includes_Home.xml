<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home: the dial (OrbitHome.dc.html). Prefix Home_.
	Ids
	  9000 section dial: hidden 5-item wraplist (Movies, TV, Music, Search, Settings), labels drawn by
	       Arc_HomeDial (Includes_Arc.xml) from Container(9000).ListItem(-2..2).
	  9300 poster arc list (Movies band / TV next up), 9301 album arc list (Music), 9310 settings arc,
	  9302 probe: in-progress shows (decides the TV band when the Next-up helper is missing).
	Window properties: orbit.reload (stamp per Home open, appended to the Next-up plugin path).
	Library totals come from the Home window properties Kodi core sets (RecentlyAddedJob.cpp):
	Movies.Count / Movies.UnWatched / TVShows.Count / Episodes.UnWatched / Music.AlbumsCount /
	Music.ArtistsCount.
-->
<includes>
	<!-- ============================================================== expressions -->
	<expression name="Home_KindMovies">String.IsEqual(Container(9000).ListItem.Property(kind),movies)</expression>
	<expression name="Home_KindTV">String.IsEqual(Container(9000).ListItem.Property(kind),tv)</expression>
	<expression name="Home_KindMusic">String.IsEqual(Container(9000).ListItem.Property(kind),music)</expression>
	<expression name="Home_KindSearch">String.IsEqual(Container(9000).ListItem.Property(kind),search)</expression>
	<expression name="Home_KindSettings">String.IsEqual(Container(9000).ListItem.Property(kind),settings)</expression>
	<expression name="Home_HasNextUpHelper">System.AddonIsEnabled(script.embuary.helper)</expression>
	<expression name="Home_PosterArcReady">[String.IsEqual(Container(9000).ListItem.Property(kind),movies) | String.IsEqual(Container(9000).ListItem.Property(kind),tv)] + Integer.IsGreater(Container(9300).NumItems,0) + !Container(9300).IsUpdating</expression>
	<expression name="Home_AlbumArcReady">String.IsEqual(Container(9000).ListItem.Property(kind),music) + Integer.IsGreater(Container(9301).NumItems,0) + !Container(9301).IsUpdating</expression>
	<!-- the info panel follows the arc that has focus, else the dial's section -->
	<expression name="Home_ItemIsEpisode">String.IsEqual(Container(9300).ListItem.DBType,episode)</expression>
	<expression name="Home_ItemIsShow">String.IsEqual(Container(9300).ListItem.DBType,tvshow)</expression>

	<!-- ================================================================ variables -->
	<!-- Poster arc source. TV when the dial rests on TV, otherwise the Movies band (also while the dial
	     rests on Music / Search / Settings, where the arc is hidden): an empty path made Kodi log
	     "GetDirectory - Error getting" on every Home refresh, and Movies <-> Settings no longer reloads. -->
	<variable name="Home_PathPosters">
		<value condition="$EXP[Home_KindTV] + $EXP[Home_HasNextUpHelper]">plugin://script.embuary.helper/?info=getnextup&amp;reload=$INFO[Window(Home).Property(orbit.reload)]</value>
		<value condition="$EXP[Home_KindTV] + Integer.IsGreater(Container(9302).NumItems,0)">special://skin/playlists/orbit_inprogress_tvshows.xsp</value>
		<value condition="$EXP[Home_KindTV] + !Container(9302).IsUpdating">videodb://recentlyaddedepisodes/</value>
		<!-- while the in-progress probe is still loading: its own playlist (empty -> NumItems 0 keeps the
		     arc hidden until the path settles; never the Movies band under a TV kicker) -->
		<value condition="$EXP[Home_KindTV]">special://skin/playlists/orbit_inprogress_tvshows.xsp</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">videodb://recentlyaddedmovies/</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">special://skin/playlists/orbit_inprogress_movies.xsp</value>
		<value>special://skin/playlists/orbit_home_toprated.xsp</value>
	</variable>
	<!-- always the albums band (hidden away from Music; no empty path, no reload when coming back) -->
	<variable name="Home_PathAlbums">
		<value>musicdb://recentlyaddedalbums/</value>
	</variable>
	<!-- Kicker over the title: which band the arc is showing -->
	<variable name="Home_Band">
		<value condition="$EXP[Home_KindMovies] + String.IsEqual(Skin.String(orbit.homemovies),recent)">Recently added</value>
		<value condition="$EXP[Home_KindMovies] + String.IsEqual(Skin.String(orbit.homemovies),inprogress)">Continue watching</value>
		<value condition="$EXP[Home_KindMovies]">Unwatched · rated 7.5+</value>
		<value condition="$EXP[Home_KindTV] + $EXP[Home_HasNextUpHelper]">Next up</value>
		<value condition="$EXP[Home_KindTV] + Integer.IsGreater(Container(9302).NumItems,0)">Shows in progress</value>
		<value condition="$EXP[Home_KindTV]">New episodes</value>
		<value condition="$EXP[Home_KindMusic]">Recently added albums</value>
	</variable>
	<!-- Ring centre readout per section -->
	<variable name="Home_DialCount">
		<value condition="$EXP[Home_KindMovies]">$INFO[Window(Home).Property(Movies.Count)]</value>
		<value condition="$EXP[Home_KindTV]">$INFO[Window(Home).Property(TVShows.Count)]</value>
		<value condition="$EXP[Home_KindMusic]">$INFO[Window(Home).Property(Music.AlbumsCount)]</value>
	</variable>
	<variable name="Home_DialUnit">
		<value condition="$EXP[Home_KindMovies]">Films</value>
		<value condition="$EXP[Home_KindTV]">Shows</value>
		<value condition="$EXP[Home_KindMusic]">Albums</value>
		<value condition="$EXP[Home_KindSearch]">Search</value>
		<value condition="$EXP[Home_KindSettings]">System</value>
	</variable>
	<variable name="Home_DialSub">
		<value condition="$EXP[Home_KindMovies]">$INFO[Window(Home).Property(Movies.UnWatched),, unwatched]</value>
		<value condition="$EXP[Home_KindTV]">$INFO[Window(Home).Property(Episodes.UnWatched),, episodes to go]</value>
		<value condition="$EXP[Home_KindMusic]">$INFO[Window(Home).Property(Music.ArtistsCount),, artists]</value>
		<value condition="$EXP[Home_KindSettings]">$INFO[System.BuildVersionShort,Kodi ,]</value>
	</variable>
	<!-- Title / meta for the poster arc lens item -->
	<variable name="Home_PosterTitle">
		<value condition="$EXP[Home_ItemIsEpisode]">$INFO[Container(9300).ListItem.TVShowTitle]</value>
		<value>$INFO[Container(9300).ListItem.Title]</value>
	</variable>
	<variable name="Home_PosterMPAA">
		<value condition="String.IsEqual(Container(9300).ListItem.MPAA,Rated R)">R</value>
		<value condition="String.IsEqual(Container(9300).ListItem.MPAA,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(Container(9300).ListItem.MPAA,Rated PG)">PG</value>
		<value condition="String.IsEqual(Container(9300).ListItem.MPAA,Rated G)">G</value>
		<value condition="String.IsEqual(Container(9300).ListItem.MPAA,Rated NR)">NR</value>
		<value condition="String.IsEqual(Container(9300).ListItem.MPAA,Rated NC-17)">NC-17</value>
		<value>$INFO[Container(9300).ListItem.MPAA]</value>
	</variable>
	<variable name="Home_PosterMeta">
		<value condition="$EXP[Home_ItemIsEpisode]">$INFO[Container(9300).ListItem.Season,S,]$INFO[Container(9300).ListItem.Episode,E,]$INFO[Container(9300).ListItem.Title, · ,]</value>
		<value>$INFO[Container(9300).ListItem.Genre]</value>
	</variable>
	<!-- the meta line as one string, for the fit probe 9718 (Home.xml) -->
	<expression name="Home_MetaWraps">Integer.IsGreater(Container(9718).NumPages,1) + !$EXP[Home_ItemIsEpisode]</expression>
	<variable name="Home_MetaProbe">
		<value condition="!$EXP[Home_ItemIsEpisode] + !String.IsEmpty(Container(9300).ListItem.MPAA)">$INFO[Container(9300).ListItem.Year,,  ·  ]$VAR[Home_PosterMPAA]  ·  $VAR[Home_PosterMeta]</value>
		<value condition="!$EXP[Home_ItemIsEpisode]">$INFO[Container(9300).ListItem.Year,,  ·  ]$VAR[Home_PosterMeta]</value>
	</variable>
	<variable name="Home_MetaYear">
		<value condition="$EXP[Home_MetaWraps] + String.IsEmpty(Container(9300).ListItem.MPAA)">$INFO[Container(9300).ListItem.Year]</value>
		<value>$INFO[Container(9300).ListItem.Year,,  ·  ]</value>
	</variable>
	<variable name="Home_MetaMPAA">
		<value condition="$EXP[Home_MetaWraps]">$VAR[Home_PosterMPAA]</value>
		<value>$VAR[Home_PosterMPAA]  ·  </value>
	</variable>
	<variable name="Home_PosterRuntime">
		<value condition="Integer.IsGreater(Container(9300).ListItem.Duration(h),0)">$INFO[Container(9300).ListItem.Duration(h),,h ]$INFO[Container(9300).ListItem.Duration(m),,m]</value>
		<value condition="!String.IsEmpty(Container(9300).ListItem.Duration)">$INFO[Container(9300).ListItem.Duration(m),,m]</value>
	</variable>
	<variable name="Home_PosterEnds">
		<value condition="Container(9300).ListItem.IsResumable">$INFO[Container(9300).ListItem.EndTimeResume]</value>
		<value>$INFO[Container(9300).ListItem.EndTime]</value>
	</variable>
	<variable name="Home_PosterLine">
		<value condition="!String.IsEmpty(Container(9300).ListItem.Tagline)">$INFO[Container(9300).ListItem.Tagline]</value>
		<value>$INFO[Container(9300).ListItem.Plot]</value>
	</variable>
	<variable name="Home_ShowProgressLabel">
		<value condition="Integer.IsGreater(Container(9300).ListItem.Property(WatchedEpisodes),0)">$INFO[Container(9300).ListItem.Property(WatchedEpisodes)] / $INFO[Container(9300).ListItem.Property(TotalEpisodes)] watched</value>
		<value>$INFO[Container(9300).ListItem.Property(TotalEpisodes),, episodes]</value>
	</variable>

	<!-- ================================================================ furniture -->
	<include name="Home_Furniture">
		<control type="image">
			<left>0</left>
			<top>280</top>
			<width>470</width>
			<height>520</height>
			<texture>rings/home_dial.png</texture>
		</control>
		<control type="image">
			<left>760</left>
			<top>0</top>
			<width>1160</width>
			<height>1080</height>
			<texture>rings/home_arc.png</texture>
		</control>
		<control type="label">
			<left>64</left>
			<top>64</top>
			<width>600</width>
			<height>24</height>
			<font>label_20</font>
			<textcolor>text_secondary</textcolor>
			<label>$LOCALIZE[31019]</label>
		</control>
		<include>Orbit_Clock</include>
	</include>

	<!-- ================================================================ data lists -->
	<include name="Home_DataLists">
		<!-- the dial: Up/Down turns it, Right enters the arc, OK opens the section -->
		<control type="wraplist" id="9000">
			<left>200</left>
			<top>538</top>
			<width>1</width>
			<height>5</height>
			<orientation>vertical</orientation>
			<focusposition>2</focusposition>
			<scrolltime>0</scrolltime>
			<onleft>noop</onleft>
			<onright condition="$EXP[Home_PosterArcReady]">9300</onright>
			<onright condition="$EXP[Home_AlbumArcReady]">9301</onright>
			<onright condition="$EXP[Home_KindSettings]">9310</onright>
			<onright condition="$EXP[Home_KindSearch]">ActivateWindow(1150)</onright>
			<onback>noop</onback>
			<itemlayout width="1" height="1"/>
			<focusedlayout width="1" height="1"/>
			<content>
				<item>
					<label>$LOCALIZE[137]</label>
					<property name="kind">search</property>
					<onclick>ActivateWindow(1150)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[5]</label>
					<property name="kind">settings</property>
					<onclick>SetFocus(9310)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[342]</label>
					<label2>$INFO[Window(Home).Property(Movies.Count)]</label2>
					<property name="kind">movies</property>
					<onclick>ActivateWindow(Videos,videodb://movies/titles/,return)</onclick>
				</item>
				<item>
					<label>TV</label>
					<label2>$INFO[Window(Home).Property(TVShows.Count)]</label2>
					<property name="kind">tv</property>
					<onclick>ActivateWindow(Videos,videodb://tvshows/titles/,return)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[2]</label>
					<label2>$INFO[Window(Home).Property(Music.AlbumsCount)]</label2>
					<property name="kind">music</property>
					<onclick>ActivateWindow(Music,musicdb://albums/,return)</onclick>
				</item>
			</content>
		</control>

		<!-- poster arc (Movies band, TV next up) -->
		<control type="wraplist" id="9300">
			<left>1000</left>
			<top>535</top>
			<include>Arc_HiddenList</include>
			<onleft>9000</onleft>
			<onright>noop</onright>
			<onback>9000</onback>
			<content target="videos">$VAR[Home_PathPosters]</content>
		</control>
		<!-- album arc (Music) -->
		<control type="wraplist" id="9301">
			<left>1000</left>
			<top>535</top>
			<include>Arc_HiddenListSquare</include>
			<onleft>9000</onleft>
			<onright>noop</onright>
			<onback>9000</onback>
			<content target="music">$VAR[Home_PathAlbums]</content>
		</control>
		<!-- settings stations -->
		<control type="wraplist" id="9310">
			<left>1000</left>
			<top>535</top>
			<include>Arc_HiddenListIcon</include>
			<onleft>9000</onleft>
			<onright>noop</onright>
			<onback>9000</onback>
			<content>
				<item>
					<label>$LOCALIZE[31021]</label>
					<label2>$LOCALIZE[31227]</label2>
					<icon>icons/knob.png</icon>
					<onclick>ActivateWindow(skinsettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[5]</label>
					<label2>$LOCALIZE[31228]</label2>
					<icon>icons/sliders.png</icon>
					<onclick>ActivateWindow(settings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[24001]</label>
					<label2>$LOCALIZE[31229]</label2>
					<icon>icons/addons.png</icon>
					<onclick>ActivateWindow(addonbrowser)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[1036]</label>
					<label2>$LOCALIZE[31230]</label2>
					<icon>icons/star.png</icon>
					<onclick>ActivateWindow(favouritesbrowser)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[10003]</label>
					<label2>$LOCALIZE[31231]</label2>
					<icon>icons/folder.png</icon>
					<onclick>ActivateWindow(filemanager)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[138]</label>
					<label2>$LOCALIZE[31232]</label2>
					<icon>icons/info.png</icon>
					<onclick>ActivateWindow(systeminfo)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[31022]</label>
					<label2>$LOCALIZE[31233]</label2>
					<icon>icons/power.png</icon>
					<onclick>ActivateWindow(shutdownmenu)</onclick>
				</item>
				<!-- 0.9.9: library upkeep (Library panel 1160, orbit.libmode); after Power so the station's
				     default item (wraplist focus position) stays the same -->
				<item>
					<label>$LOCALIZE[31202]</label>
					<label2>$LOCALIZE[31234]</label2>
					<icon>icons/refresh.png</icon>
					<onclick>SetProperty(orbit.libmode,update,home)</onclick>
					<onclick>ActivateWindow(1160)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[31204]</label>
					<label2>$LOCALIZE[31235]</label2>
					<icon>icons/minus.png</icon>
					<onclick>SetProperty(orbit.libmode,clean,home)</onclick>
					<onclick>ActivateWindow(1160)</onclick>
				</item>
			</content>
		</control>
		<!-- probe: in-progress shows (no art needed: only NumItems is read) -->
		<control type="list" id="9302">
			<left>offscreen</left>
			<top>offscreen</top>
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1"/>
			<focusedlayout width="1" height="1"/>
			<content target="videos">special://skin/playlists/orbit_inprogress_tvshows.xsp</content>
		</control>
	</include>

	<!-- ================================================================ dial centre -->
	<!-- mockup: count mono 58, unit label, sub mono 20, centred on the ring centre (x 200) -->
	<include name="Home_DialReadout">
		<control type="group">
			<left>50</left>
			<top>470</top>
			<width>300</width>
			<height>140</height>
			<animation effect="fade" start="0" end="100" time="200" delay="60" condition="!Container(9000).OnNext + !Container(9000).OnPrevious" reversible="false">Conditional</animation>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>300</width>
				<height>66</height>
				<align>center</align>
				<font>mono_58</font>
				<textcolor>text_primary</textcolor>
				<label>$VAR[Home_DialCount]</label>
			</control>
			<!-- search / settings: an engraved icon instead of a number -->
			<control type="image">
				<left>117</left>
				<top>0</top>
				<width>66</width>
				<height>66</height>
				<texture colordiffuse="text_primary">icons/search.png</texture>
				<visible>$EXP[Home_KindSearch]</visible>
			</control>
			<control type="image">
				<left>117</left>
				<top>0</top>
				<width>66</width>
				<height>66</height>
				<texture colordiffuse="text_primary">icons/knob.png</texture>
				<visible>$EXP[Home_KindSettings]</visible>
			</control>
			<control type="label">
				<left>0</left>
				<top>68</top>
				<width>300</width>
				<height>24</height>
				<align>center</align>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[Home_DialUnit]</label>
			</control>
			<control type="label">
				<left>0</left>
				<top>98</top>
				<width>300</width>
				<height>28</height>
				<align>center</align>
				<font>mono_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[Home_DialSub]</label>
			</control>
		</control>
	</include>

	<!-- ================================================================ arcs -->
	<include name="Home_ArcReveal">
		<animation type="Visible" condition="!$EXP[ReduceMotion]">
			<effect type="fade" start="0" end="100" time="260" tween="cubic" easing="out"/>
			<effect type="slide" start="60,0" end="0,0" time="260" tween="cubic" easing="out"/>
		</animation>
		<animation type="Visible" condition="$EXP[ReduceMotion]">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="0" time="100"/>
		</animation>
	</include>
	<include name="Home_Arcs">
		<control type="group">
			<visible>$EXP[Home_PosterArcReady]</visible>
			<include>Home_ArcReveal</include>
			<include content="Arc_HomePosters">
				<param name="id" value="9300"/>
			</include>
		</control>
		<control type="group">
			<visible>$EXP[Home_AlbumArcReady]</visible>
			<include>Home_ArcReveal</include>
			<!-- record dial: the lens album's record peeks out of the right of its sleeve -->
			<control type="group">
				<left>1010</left>
				<top>400</top>
				<width>280</width>
				<height>280</height>
				<animation effect="slide" start="-110,0" end="0,0" time="320" delay="120" tween="cubic" easing="out" condition="[!Container(9301).OnNext + !Container(9301).OnPrevious] + !Skin.HasSetting(orbit.reducemotion)" reversible="false">Conditional</animation>
				<animation effect="slide" start="-110,0" end="0,0" time="0" delay="0" tween="cubic" easing="out" condition="[!Container(9301).OnNext + !Container(9301).OnPrevious] + Skin.HasSetting(orbit.reducemotion)" reversible="false">Conditional</animation>
				<control type="image">
					<left>45</left>
					<top>45</top>
					<width>190</width>
					<height>190</height>
					<texture background="true" diffuse="masks/circle.png">$INFO[Container(9301).ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>280</width>
					<height>280</height>
					<texture>music/vinyl.png</texture>
				</control>
				<control type="image">
					<left>128</left>
					<top>128</top>
					<width>24</width>
					<height>24</height>
					<texture>music/spindle.png</texture>
				</control>
			</control>
			<include content="Arc_HomeSquares">
				<param name="id" value="9301"/>
			</include>
		</control>
		<control type="group">
			<visible>$EXP[Home_KindSettings]</visible>
			<include>Home_ArcReveal</include>
			<include content="Arc_HomeIcons">
				<param name="id" value="9310"/>
			</include>
		</control>
		<!-- loading / empty band -->
		<control type="label">
			<left>860</left>
			<top>520</top>
			<width>300</width>
			<height>40</height>
			<align>center</align>
			<font>label_20</font>
			<textcolor>text_dim</textcolor>
			<label>$LOCALIZE[31013]</label>
			<visible>[[$EXP[Home_KindMovies] | $EXP[Home_KindTV]] + Container(9300).IsUpdating] | [$EXP[Home_KindMusic] + Container(9301).IsUpdating]</visible>
		</control>
		<control type="label">
			<left>820</left>
			<top>520</top>
			<width>380</width>
			<height>40</height>
			<align>center</align>
			<font>label_20</font>
			<textcolor>text_dim</textcolor>
			<label>$LOCALIZE[31012]</label>
			<visible>[[$EXP[Home_KindMovies] | $EXP[Home_KindTV]] + !Container(9300).IsUpdating + Integer.IsEqual(Container(9300).NumItems,0)] | [$EXP[Home_KindMusic] + !Container(9301).IsUpdating + Integer.IsEqual(Container(9301).NumItems,0)]</visible>
		</control>
	</include>

	<!-- ================================================================ info panels -->
	<!-- Kicker: band name + mono position "005 / 209" -->
	<include name="Home_Kicker">
		<param name="list">9300</param>
		<param name="label">$VAR[Home_Band]</param>
		<definition>
			<control type="grouplist">
				<height>24</height>
				<width>566</width>
				<orientation>horizontal</orientation>
				<itemgap>22</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="400">auto</width>
					<height>24</height>
					<font>label_20</font>
					<textcolor>text_secondary</textcolor>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<width>auto</width>
					<height>24</height>
					<font>mono_20</font>
					<textcolor>text_primary</textcolor>
					<label>$INFO[Container($PARAM[list]).CurrentItem]</label>
				</control>
				<control type="label">
					<left>-14</left>
					<width>auto</width>
					<height>24</height>
					<font>mono_20</font>
					<textcolor>text_dim</textcolor>
					<label>$INFO[Container($PARAM[list]).NumItems,/ ,]</label>
				</control>
			</control>
		</definition>
	</include>

	<include name="Home_InfoPanels">
		<!-- Movies / TV -->
		<control type="grouplist">
			<left>1290</left>
			<top>230</top>
			<width>566</width>
			<height>800</height>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<visible>$EXP[Home_PosterArcReady]</visible>
			<include>Home_ArcReveal</include>
			<include content="Home_Kicker">
				<param name="list" value="9300"/>
			</include>
			<include content="Fit_Home">
				<param name="top" value="22"/>
				<param name="label" value="$VAR[Home_PosterTitle]"/>
			</include>
			<!-- meta: year (mono) + certification / genres or episode code (label). When the whole line
			     does not fit in 566 (probe 9718 in Home.xml), the genres move to a line of their own
			     instead of being clipped ("DRAMA / ROMANCE / FANTA"). -->
			<control type="grouplist">
				<top>12</top>
				<width>566</width>
				<height>26</height>
				<orientation>horizontal</orientation>
				<itemgap>0</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<font>mono_20</font>
					<textcolor>text_meta</textcolor>
					<label>$VAR[Home_MetaYear]</label>
					<visible>!$EXP[Home_ItemIsEpisode]</visible>
				</control>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<font>label_20</font>
					<textcolor>text_meta</textcolor>
					<label>$VAR[Home_MetaMPAA]</label>
					<visible>!$EXP[Home_ItemIsEpisode] + !String.IsEmpty(Container(9300).ListItem.MPAA)</visible>
				</control>
				<control type="label">
					<width max="560">auto</width>
					<height>26</height>
					<font>label_20</font>
					<textcolor>text_meta</textcolor>
					<label>$VAR[Home_PosterMeta]</label>
					<visible>!$EXP[Home_MetaWraps]</visible>
				</control>
			</control>
			<control type="label">
				<top>6</top>
				<width>566</width>
				<height>26</height>
				<font>label_20</font>
				<textcolor>text_meta</textcolor>
				<label>$VAR[Home_PosterMeta]</label>
				<visible>$EXP[Home_MetaWraps]</visible>
			</control>
			<!-- instruments -->
			<control type="group">
				<top>44</top>
				<width>566</width>
				<height>230</height>
				<!-- rating -->
				<control type="group">
					<left>0</left>
					<top>0</top>
					<width>180</width>
					<height>220</height>
					<include content="Orbit_GaugeRating">
						<param name="S" value="180"/>
						<param name="rating" value="Container(9300).ListItem.Rating"/>
						<param name="value_font" value="mono_40"/>
					</include>
					<control type="label">
						<left>0</left>
						<top>194</top>
						<width>180</width>
						<height>24</height>
						<align>center</align>
						<font>label_20</font>
						<textcolor>text_secondary</textcolor>
						<label>$LOCALIZE[563]</label>
					</control>
				</control>
				<!-- runtime clock sector (films, episodes) -->
				<control type="group">
					<left>244</left>
					<top>0</top>
					<width>180</width>
					<height>220</height>
					<visible>Integer.IsGreater(Container(9300).ListItem.Duration(mins),0)</visible>
					<include content="Orbit_GaugeRuntime">
						<param name="S" value="180"/>
						<param name="c" value="90"/>
						<param name="mins" value="Container(9300).ListItem.Duration(mins)"/>
					</include>
					<control type="label">
						<!-- 460 wide (centre 90): "2h 12m  ·  ends 10:14 PM" on a 12 h region is ~317 px in mono_22 -->
						<left>-140</left>
						<top>192</top>
						<width>460</width>
						<height>28</height>
						<align>center</align>
						<font>mono_22</font>
						<textcolor>text_primary</textcolor>
						<label>$VAR[Home_PosterRuntime]  ·  ends [COLOR accent]$VAR[Home_PosterEnds][/COLOR]</label>
					</control>
				</control>
				<!-- show progress (in-progress shows band) -->
				<control type="group">
					<left>244</left>
					<top>0</top>
					<width>180</width>
					<height>220</height>
					<visible>$EXP[Home_ItemIsShow]</visible>
					<include content="Orbit_GaugeProgress">
						<param name="S" value="180"/>
						<param name="info" value="Container(9300).ListItem.Property(WatchedEpisodePercent)"/>
						<param name="value_font" value="mono_34"/>
						<param name="value" value="$INFO[Container(9300).ListItem.Property(WatchedEpisodePercent),,[COLOR text_dim]%[/COLOR]]"/>
					</include>
					<control type="label">
						<left>-60</left>
						<top>192</top>
						<width>300</width>
						<height>28</height>
						<align>center</align>
						<font>mono_22</font>
						<textcolor>text_primary</textcolor>
						<label>$VAR[Home_ShowProgressLabel]</label>
					</control>
				</control>
			</control>
			<control type="textbox">
				<top>26</top>
				<width>566</width>
				<height max="76">auto</height>
				<font>text_26</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[Home_PosterLine]</label>
			</control>
		</control>

		<!-- Music -->
		<control type="grouplist">
			<left>1340</left>
			<top>300</top>
			<width>516</width>
			<height>700</height>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<visible>$EXP[Home_AlbumArcReady]</visible>
			<include>Home_ArcReveal</include>
			<include content="Home_Kicker">
				<param name="list" value="9301"/>
			</include>
			<include content="Fit_HomeMusic">
				<param name="top" value="22"/>
				<param name="label" value="$INFO[Container(9301).ListItem.Label]"/>
			</include>
			<control type="label">
				<top>14</top>
				<width>516</width>
				<height>40</height>
				<font>text_30_med</font>
				<textcolor>text_primary</textcolor>
				<label>$INFO[Container(9301).ListItem.Artist]</label>
			</control>
			<control type="grouplist">
				<top>8</top>
				<width>516</width>
				<height>26</height>
				<orientation>horizontal</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<font>mono_20</font>
					<textcolor>text_meta</textcolor>
					<label>$INFO[Container(9301).ListItem.Year,,  ·  ]</label>
				</control>
				<control type="label">
					<width max="500">auto</width>
					<height>26</height>
					<font>label_20</font>
					<textcolor>text_meta</textcolor>
					<label>$INFO[Container(9301).ListItem.Genre]</label>
				</control>
			</control>
			<control type="label">
				<top>40</top>
				<width>516</width>
				<height>28</height>
				<font>label_20</font>
				<textcolor>text_dim</textcolor>
				<label>$LOCALIZE[31236]</label>
				<visible>Control.HasFocus(9301)</visible>
			</control>
		</control>

		<!-- Settings -->
		<control type="grouplist">
			<left>1340</left>
			<top>420</top>
			<width>516</width>
			<height>400</height>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<visible>$EXP[Home_KindSettings]</visible>
			<include>Home_ArcReveal</include>
			<include content="Home_Kicker">
				<param name="list" value="9310"/>
				<param name="label" value="$LOCALIZE[31020]"/>
			</include>
			<include content="Fit_HomeStation">
				<param name="top" value="22"/>
				<param name="label" value="$INFO[Container(9310).ListItem.Label]"/>
			</include>
			<control type="textbox">
				<top>18</top>
				<width>516</width>
				<height max="76">auto</height>
				<font>text_26</font>
				<textcolor>text_secondary</textcolor>
				<label>$INFO[Container(9310).ListItem.Label2]</label>
			</control>
		</control>
	</include>

	<!-- ================================================================ search station -->
	<include name="Home_SearchStation">
		<control type="group">
			<visible>$EXP[Home_KindSearch]</visible>
			<include>Home_ArcReveal</include>
			<control type="image">
				<left>830</left>
				<top>370</top>
				<width>340</width>
				<height>340</height>
				<texture>rings/dial_clock_260.png</texture>
				<visible>!$EXP[RingMinimal]</visible>
			</control>
			<control type="image">
				<left>830</left>
				<top>370</top>
				<width>340</width>
				<height>340</height>
				<texture>rings/dial_min_260.png</texture>
				<visible>$EXP[RingMinimal]</visible>
			</control>
			<control type="image">
				<left>952</left>
				<top>492</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="accent">icons/search.png</texture>
			</control>
			<control type="grouplist">
				<left>1290</left>
				<top>420</top>
				<width>566</width>
				<height>400</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>566</width>
					<height>24</height>
					<font>label_20</font>
					<textcolor>text_secondary</textcolor>
					<label>$LOCALIZE[31237]</label>
				</control>
				<control type="label">
					<top>22</top>
					<width>566</width>
					<height>66</height>
					<font>wide_56</font>
					<textcolor>text_primary</textcolor>
					<label>$LOCALIZE[137]</label>
				</control>
				<control type="textbox">
					<top>18</top>
					<width>566</width>
					<height>76</height>
					<font>text_26</font>
					<textcolor>text_secondary</textcolor>
					<label>$LOCALIZE[31238]</label>
				</control>
			</control>
		</control>
	</include>

	<!-- ================================================================ now playing -->
	<!-- While something plays: compact readout under the dial (mono time, title, amber progress) -->
	<include name="Home_NowPlaying">
		<control type="group">
			<left>64</left>
			<top>900</top>
			<width>640</width>
			<height>120</height>
			<visible>Player.HasMedia</visible>
			<animation effect="fade" start="0" end="100" time="200">Visible</animation>
			<animation effect="fade" start="100" end="0" time="140">Hidden</animation>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>640</width>
				<height>24</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[31017]</label>
			</control>
			<control type="label">
				<left>0</left>
				<top>30</top>
				<width>640</width>
				<height>40</height>
				<font>text_30_med</font>
				<textcolor>text_primary</textcolor>
				<label>$VAR[OSDTitle]</label>
			</control>
			<control type="progress">
				<left>0</left>
				<top>80</top>
				<width>420</width>
				<height>3</height>
				<texturebg colordiffuse="line">common/white.png</texturebg>
				<midtexture colordiffuse="accent">common/white.png</midtexture>
				<info>Player.Progress</info>
			</control>
			<control type="label">
				<left>440</left>
				<top>66</top>
				<width>200</width>
				<height>30</height>
				<font>mono_22</font>
				<textcolor>text_primary</textcolor>
				<label>$INFO[Player.Time]</label>
			</control>
		</control>
	</include>
</includes>
