<?xml version="1.0" encoding="UTF-8"?>
<!--
	Daylight view picker (custom dialog 1161; docs/requests/library-panel/BRIEF.md). Opened by the View
	pill of the card header and View in the Library panel. One schematic preview per view valid for the
	content underneath (the views' own Container.Content conditions), its name and an accent dot +
	"Current" under the view on screen. The previews are layered white-alpha PNGs tinted with the live
	mood colours, so they look like the page at any time of day (_src/make_view_previews.py).
	OK = Container.SetViewMode(id), closes, focus back on the view; Back closes with no change.
	Opens on the current view: SetFocus(100,k,absolute), k = its place among the valid views (generated).
	The card centres itself on the number of previews (Container(100).NumItems counts visible items).
	GENERATED by _src/make_library_panel.py.
-->
<window type="dialog" id="1161">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<onload>SetFocus(100,0,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,Wall) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(100,1,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,Episodes) + [Container.Content(episodes)] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(100,2,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,List) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + [Container.Content(episodes)]">SetFocus(100,3,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,List) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + ![Container.Content(episodes)]">SetFocus(100,2,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,List) + ![Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + [Container.Content(episodes)]">SetFocus(100,1,absolute)</onload>
	<onload condition="Window.IsActive(music) + String.IsEqual(Container.Viewmode,List) + [Container.Content(albums) | Container.Content(artists) | Container.Content(genres) | Container.Content(years)]">SetFocus(100,1,absolute)</onload>
	<controls>
		<control type="image">
			<description>backdrop dim</description>
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="$VAR[DL_DimDialog]">common/white.png</texture>
		</control>
		<control type="group">
			<left>180</left>
			<top>330</top>
			<width>1560</width>
			<height>420</height>
			<animation effect="slide" end="570,0" time="0" condition="Integer.IsEqual(Container(100).NumItems,1)">Conditional</animation>
			<animation effect="slide" end="380,0" time="0" condition="Integer.IsEqual(Container(100).NumItems,2)">Conditional</animation>
			<animation effect="slide" end="190,0" time="0" condition="Integer.IsEqual(Container(100).NumItems,3)">Conditional</animation>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>420</width>
				<height>420</height>
				<visible>Integer.IsEqual(Container(100).NumItems,1)</visible>
				<include>DL_Card</include>
			</control>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>800</width>
				<height>420</height>
				<visible>Integer.IsEqual(Container(100).NumItems,2)</visible>
				<include>DL_Card</include>
			</control>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>1180</width>
				<height>420</height>
				<visible>Integer.IsEqual(Container(100).NumItems,3)</visible>
				<include>DL_Card</include>
			</control>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>1560</width>
				<height>420</height>
				<visible>Integer.IsEqual(Container(100).NumItems,4)</visible>
				<include>DL_Card</include>
			</control>
			<control type="label">
				<left>48</left>
				<top>16</top>
				<width>600</width>
				<height>56</height>
				<aligny>center</aligny>
				<font>serif_28</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<label>View</label>
			</control>
			<control type="label">
				<left>124</left>
				<top>19</top>
				<width>600</width>
				<height>56</height>
				<aligny>center</aligny>
				<font>small_20</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$VAR[LibPanel_Where]</label>
			</control>
			<control type="list" id="100">
				<left>20</left>
				<top>76</top>
				<width>1520</width>
				<height>330</height>
				<orientation>horizontal</orientation>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<scrolltime tween="cubic" easing="out">160</scrolltime>
				<itemlayout width="380" height="330">
					<include>Pick_Item</include>
				</itemlayout>
				<focusedlayout width="380" height="330">
					<include content="Pick_Item"><param name="focused" value="true"/></include>
				</focusedlayout>
				<content>
				<item>
					<label>Grid</label>
					<label2>$VAR[Pick_Cur_Grid]</label2>
					<property name="prev">views/grid</property>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(500)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]</visible>
				</item>
				<item>
					<label>Wall</label>
					<label2>$VAR[Pick_Cur_Wall]</label2>
					<property name="prev">views/wall</property>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(501)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]</visible>
				</item>
				<item>
					<label>Episodes</label>
					<label2>$VAR[Pick_Cur_Episodes]</label2>
					<property name="prev">views/episodes</property>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(503)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos) + [Container.Content(episodes)]</visible>
				</item>
				<item>
					<label>List</label>
					<label2>$VAR[Pick_Cur_List]</label2>
					<property name="prev">views/list</property>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(50)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos)</visible>
				</item>
				<item>
					<label>Grid</label>
					<label2>$VAR[Pick_Cur_Grid]</label2>
					<property name="prev">views/music_grid</property>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(504)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(music) + [Container.Content(albums) | Container.Content(artists) | Container.Content(genres) | Container.Content(years)]</visible>
				</item>
				<item>
					<label>List</label>
					<label2>$VAR[Pick_Cur_List]</label2>
					<property name="prev">views/music_list</property>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(50)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(music)</visible>
				</item>
				</content>
			</control>
		</control>
	</controls>
</window>
