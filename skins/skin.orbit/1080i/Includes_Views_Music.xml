<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library views (MyMusicNav.xml) in the Orbit language.
	504 ARC: album covers / artist discs on the library circle, the lens album's record peeks out of
	     its sleeve ("record dial"); albums, artists, genres-with-art.
	505 GRID: covers for scanning.
	50  DIAL LIST + item panel (songs, genres, files, everything).
	Option bar (menucontrol 9000, bottom left): Albums / Artists / Songs / Genres / Sort / View.
-->
<includes>
	<expression name="MusicView_ArcContent">Container.Content(albums) | Container.Content(artists)</expression>
	<variable name="MusicView_Title">
		<value condition="!$EXP[Music_AtTabRoot] + !String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value>$LOCALIZE[2]</value>
	</variable>
	<variable name="MusicView_Cover">
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="MusicView_Kicker">
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Genre]</value>
		<value>$INFO[ListItem.Artist]</value>
	</variable>
	<variable name="MusicView_Description">
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Property(Artist_Description)]</value>
		<value>$INFO[ListItem.Property(Album_Description)]</value>
	</variable>
	<variable name="MusicView_MetaRest">
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Property(Artist_Type)]$INFO[ListItem.Property(Artist_Born),  ·  ,]$INFO[ListItem.Property(Artist_Formed),  ·  ,]</value>
		<value>$INFO[ListItem.Genre]$INFO[ListItem.Property(Album_Label),  ·  ,]</value>
	</variable>

	<!-- ================================================================ 504 arc -->
	<include name="Music_View_504">
		<control type="group">
			<visible>Control.IsVisible(504)</visible>
			<include>Anim_VisibleFade</include>
			<control type="image">
				<left>1090</left>
				<top>0</top>
				<width>830</width>
				<height>1080</height>
				<texture>rings/lib_arc.png</texture>
			</control>
			<control type="fixedlist" id="504">
				<left>1300</left>
				<top>535</top>
				<include>Arc_HiddenListSquare</include>
				<onleft>9000</onleft>
				<onright>ActivateWindow(1160)</onright>  <!-- 0.9.9: Right = Library panel -->
				<viewtype label="31312">list</viewtype>
				<visible>$EXP[MusicView_ArcContent]</visible>
			</control>
			<!-- record dial: the lens album's record slides out of its sleeve when focus rests -->
			<control type="group">
				<left>940</left>
				<top>360</top>
				<width>360</width>
				<height>360</height>
				<visible>Container.Content(albums) + !ListItem.IsParentFolder</visible>
				<animation effect="slide" start="180,0" end="0,0" time="360" delay="160" tween="cubic" easing="out" condition="[!Container(504).OnNext + !Container(504).OnPrevious] + !Skin.HasSetting(orbit.reducemotion)" reversible="false">Conditional</animation>
				<animation effect="slide" start="180,0" end="0,0" time="0" delay="0" tween="cubic" easing="out" condition="[!Container(504).OnNext + !Container(504).OnPrevious] + Skin.HasSetting(orbit.reducemotion)" reversible="false">Conditional</animation>
				<control type="image">
					<left>58</left>
					<top>58</top>
					<width>244</width>
					<height>244</height>
					<texture background="true" diffuse="masks/circle.png">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>360</width>
					<height>360</height>
					<texture>music/vinyl.png</texture>
				</control>
				<control type="image">
					<left>168</left>
					<top>168</top>
					<width>24</width>
					<height>24</height>
					<texture>music/spindle.png</texture>
				</control>
			</control>
			<include content="Arc_LibrarySquares">
				<param name="id" value="504"/>
			</include>
			<!-- info block -->
			<control type="grouplist">
				<left>64</left>
				<top>236</top>
				<width>780</width>
				<height>700</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<visible>!ListItem.IsParentFolder</visible>
				<control type="label">
					<width>780</width>
					<height>24</height>
					<font>label_20</font>
					<textcolor>text_secondary</textcolor>
					<label>$VAR[MusicView_Kicker]</label>
				</control>
				<include content="Fit_MusicArc">
					<param name="top" value="14"/>
					<param name="label" value="$INFO[ListItem.Label]"/>
				</include>
				<control type="grouplist">
					<top>12</top>
					<width>780</width>
					<height>26</height>
					<orientation>horizontal</orientation>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width>auto</width>
						<height>26</height>
						<font>mono_20</font>
						<textcolor>text_meta</textcolor>
						<label>$INFO[ListItem.Year,,  ·  ]</label>
					</control>
					<control type="label">
						<width max="760">auto</width>
						<height>26</height>
						<font>label_20</font>
						<textcolor>text_meta</textcolor>
						<label>$VAR[MusicView_MetaRest]</label>
					</control>
				</control>
				<control type="textbox">
					<top>26</top>
					<width>740</width>
					<height max="152">auto</height>
					<font>text_26</font>
					<textcolor>text_plot</textcolor>
					<label>$VAR[MusicView_Description]</label>
				</control>
				<!-- instrument: album rating when the album has one -->
				<control type="group">
					<top>36</top>
					<width>740</width>
					<height>230</height>
					<visible>!String.IsEmpty(ListItem.Rating)</visible>
					<include content="Orbit_GaugeRating">
						<param name="S" value="180"/>
						<param name="value_font" value="mono_40"/>
					</include>
					<control type="label">
						<left>0</left>
						<top>194</top>
						<width>180</width>
						<height>24</height>
						<align>center</align>
						<font>label_20</font>
						<textcolor>text_secondary</textcolor>
						<label>$LOCALIZE[563]</label>
					</control>
				</control>
			</control>
			<control type="group">
				<visible>ListItem.IsParentFolder</visible>
				<control type="label">
					<left>64</left>
					<top>470</top>
					<width>780</width>
					<height>80</height>
					<font>wide_66</font>
					<textcolor>text_primary</textcolor>
					<label>$LOCALIZE[31251]</label>
				</control>
			</control>
		</control>
	</include>

	<!-- ================================================================ 505 grid -->
	<include name="Music_View_505">
		<control type="group">
			<visible>Control.IsVisible(505)</visible>
			<include>Anim_VisibleFade</include>
			<control type="grouplist">
				<left>64</left>
				<top>166</top>
				<width>1500</width>
				<height>44</height>
				<orientation>horizontal</orientation>
				<itemgap>24</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="980">auto</width>
					<height>44</height>
					<font>wide_30</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[Music_ItemLabel]</label>
				</control>
				<control type="label">
					<top>8</top>
					<width max="700">auto</width>
					<height>32</height>
					<font>text_24_med</font>
					<textcolor>text_meta</textcolor>
					<label>$INFO[ListItem.Artist]$INFO[ListItem.Year,  ·  ,]</label>
				</control>
			</control>
			<control type="panel" id="505">
				<left>40</left>
				<top>224</top>
				<width>1840</width>
				<height>756</height>
				<orientation>vertical</orientation>
				<onleft>9000</onleft>
				<onright>ActivateWindow(1160)</onright>  <!-- 0.9.9: Right = Library panel -->
				<onup>noop</onup>
				<ondown>9000</ondown>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<preloaditems>2</preloaditems>
				<viewtype label="31313">icon</viewtype>
				<visible>Container.Content(albums) | Container.Content(artists) | Container.Content(genres)</visible>
				<itemlayout width="262" height="262">
					<control type="group">
						<left>24</left>
						<top>24</top>
						<width>214</width>
						<height>214</height>
						<animation effect="fadediffuse" start="ffb0b0b0" end="ffb0b0b0" time="0" condition="true">Conditional</animation>
						<include content="Orbit_Artwork">
							<param name="art" value="$VAR[MusicView_Cover]"/>
							<param name="mask" value="masks/square_r4.png"/>
						</include>
					</control>
				</itemlayout>
				<focusedlayout width="262" height="262">
					<control type="group">
						<left>24</left>
						<top>24</top>
						<width>214</width>
						<height>214</height>
						<animation effect="zoom" start="100" end="106" center="auto" time="160" tween="cubic" easing="out" condition="!Skin.HasSetting(orbit.reducemotion)">Focus</animation>
						<!-- reduce motion: a time-0 Conditional, not a second Focus animation (Kodi resets only the first Focus on unfocus; a twin stayed at 106 %) -->
						<animation effect="zoom" start="100" end="106" center="auto" time="0" condition="Skin.HasSetting(orbit.reducemotion) + Control.HasFocus(505)">Conditional</animation>
						<include content="Orbit_Artwork">
							<param name="art" value="$VAR[MusicView_Cover]"/>
							<param name="mask" value="masks/square_r4.png"/>
						</include>
						<include content="Orbit_Brackets">
							<param name="out" value="-12"/>
						</include>
					</control>
				</focusedlayout>
			</control>
		</control>
	</include>

	<!-- ================================================================ 50 dial list -->
	<include name="Music_View_50">
		<include>View_50_List</include>
	</include>
</includes>
