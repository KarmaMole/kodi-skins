				<visible>Control.IsVisible(1005)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>475</top>
				<width>640</width>
				<height>68</height>
				<texture colordiffuse="card_lift">common/white.png</texture>
				<visible>Control.IsVisible(1006)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>543</top>
				<width>640</width>
				<height>68</height>
				<texture colordiffuse="card_lift">common/white.png</texture>
				<visible>Control.IsVisible(1007)</visible>
