<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are NAMES from colors/defaults.xml. $VAR works in colordiffuse="" and <textcolor>,
	NOT in diffuse="" or border="". Area-specific variables live in their Includes_* file.
-->
<includes>
	<!-- ===================================================================== colours -->
	<!-- Void has no accent: anything the engine marked "accent" is the warm white -->
	<variable name="ColorAccent"><value>text</value></variable>
	<variable name="ColorRule"><value>hairline</value></variable>
	<variable name="ColorRuleStrong"><value>hairline_strong</value></variable>
	<variable name="ColorCaption"><value>grey</value></variable>
	<!-- retired engine textures (Void draws no frames / outlines): empty -->
	<variable name="FocusFrame"><value></value></variable>
	<variable name="FocusFrameAlways"><value></value></variable>
	<variable name="ButtonFill"><value></value></variable>
	<variable name="ButtonOutline"><value></value></variable>
	<!-- Ambient artwork level (setting void.ambientlevel: empty = 70 %) -->
	<variable name="AmbientLevel">
		<value condition="String.IsEqual(Skin.String(void.ambientlevel),50)">art_50</value>
		<value condition="String.IsEqual(Skin.String(void.ambientlevel),90)">art_90</value>
		<value>art_70</value>
	</variable>

	<!-- ====================================================================== labels -->
	<variable name="ClockLabel"><value>$INFO[System.Time]</value></variable>
	<variable name="DateLabel"><value>$INFO[System.Date(DDD)] $INFO[System.Date(d MMM)]</value></variable>
	<variable name="Dot"><value>[COLOR sep_light]  ·  [/COLOR]</value></variable>

	<!-- Poster/thumb for any list item -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- "2 h 10 min" / "48 min" (ListItem context) -->
	<variable name="Runtime">
		<value condition="Integer.IsGreater(ListItem.Duration(h),0) + Integer.IsGreater(ListItem.Duration(m),0)">$INFO[ListItem.Duration(h),, h ]$INFO[ListItem.Duration(m),, min]</value>
		<value condition="Integer.IsGreater(ListItem.Duration(h),0)">$INFO[ListItem.Duration(h),, h]</value>
		<value>$INFO[ListItem.Duration(m),, min]</value>
	</variable>
	<!-- Kodi stores US certifications as "Rated PG-13": show the bare code -->
	<variable name="MPAA">
		<value condition="String.StartsWith(ListItem.MPAA,Rated )">$INFO[ListItem.MPAA]</value>
		<value>$INFO[ListItem.MPAA]</value>
	</variable>
	<!-- S02E04 (zero padded) -->
	<variable name="EpCode">
		<value condition="String.IsEmpty(ListItem.Episode)"></value>
		<value condition="Integer.IsLess(ListItem.Season,10) + Integer.IsLess(ListItem.Episode,10)">S0$INFO[ListItem.Season]E0$INFO[ListItem.Episode]</value>
		<value condition="Integer.IsLess(ListItem.Season,10)">S0$INFO[ListItem.Season]E$INFO[ListItem.Episode]</value>
		<value condition="Integer.IsLess(ListItem.Episode,10)">S$INFO[ListItem.Season]E0$INFO[ListItem.Episode]</value>
		<value>S$INFO[ListItem.Season]E$INFO[ListItem.Episode]</value>
	</variable>

	<!-- ======================================================================== OSD -->
	<variable name="OSDTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<variable name="OSDKicker">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.Season,S,]$INFO[VideoPlayer.Episode,E,]$INFO[VideoPlayer.Title,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ,]</value>
		<value>$INFO[VideoPlayer.Year]</value>
	</variable>
	<!-- left number: elapsed (or the seek target while seeking) -->
	<variable name="OSDElapsed">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]</value>
		<value>$INFO[Player.Time]</value>
	</variable>
	<!-- right number: "−57:20 · ends 22:44" -->
	<variable name="OSDRemaining">
		<value condition="!String.IsEmpty(Player.TimeRemaining)">−$INFO[Player.TimeRemaining][COLOR sep_light]  ·  [/COLOR]ends $INFO[Player.FinishTime]</value>
		<value>$INFO[Player.Duration]</value>
	</variable>
	<variable name="OSDStateLabel">
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$INFO[Player.SeekStepSize]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)">$INFO[Player.SeekOffset]</value>
		<value condition="Player.Paused">Paused</value>
		<value condition="Player.Forwarding | Player.Rewinding">$INFO[Player.PlaySpeed,,×]</value>
	</variable>
	<!-- kept for inherited OSD logic -->
	<variable name="OSDTimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]$INFO[Player.Duration, / ,]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
</includes>
