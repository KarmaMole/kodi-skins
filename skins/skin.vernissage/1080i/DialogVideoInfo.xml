<?xml version="1.0" encoding="UTF-8"?>
<!--
	"The placard" (SPEC 9, DESIGN 6 board 06, docs/skin.vernissage/screens/DialogVideoInfo_Placard.md): film, series,
	season, episode and set. The work (fanart cropped 6:5, or the poster with a wider placard) in its mat under the
	pool, the curator's card beside it exactly as tall as the mat, the action row at the card's foot. Pieces:
	Includes_VideoInfo.xml (GENERATED by _src/make_info.py: ids, focus map and Kodi's id contract are in its header).
	Kodi ids: 8 play / browse, 9 resume, 10 choose art, 11 trailer, 6 refresh (offscreen, ours SendClick them), 50 cast.
	Focus: the first action (always); Down -> the More card (cast row / rows); Back in More -> More; Back on the row
	closes the dialog. No window-level animation: the room stays, the content fades.
-->
<window>
	<defaultcontrol always="true">9930</defaultcontrol>
	<include>VidInfo_FirstFocus</include>
	<controls>
		<include>VN_Room</include>
		<include>VidInfo_Data</include>
		<control type="group">
			<include>Anim_WindowContent</include>
			<include>VidInfo_Stage</include>
		</control>
		<include>VidInfo_MoreCard</include>
	</controls>
</window>
