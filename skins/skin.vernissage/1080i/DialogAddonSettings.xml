<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Add-on settings (TMDb Helper, YouTube, subtitle services ...) - M4, Builder E.
	Full-screen Index page in the Settings.dc.html grid so it reads like Kodi's own settings:
	categories x96 w380, list x560 w860, aside x1500 w324 with OK / Cancel / Defaults and the
	description of the focused setting.
	Id contract (Estuary Omega): heading 2, categories grouplist 3 + template 10, control area 5,
	description 6, templates 7-15, buttons 28 / 29 / 30 in grouplist 9000, level button 20,
	scrollbar 60.
-->
<window>
	<defaultcontrol>5</defaultcontrol>
	<controls>
		<include>VN_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_DialogCard</include>
			<!-- ====== header: the add-on's name as the exhibition title (Kodi writes label 2), "Add-ons" beside it -->
			<control type="grouplist">
				<left>116</left>
				<top>58</top>
				<width>1500</width>
				<height>66</height>
				<orientation>horizontal</orientation>
				<itemgap>40</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label" id="2">
					<description>heading (Kodi)</description>
					<width max="1100">auto</width>
					<height>66</height>
					<font>font_exhibit</font>
				</control>
				<control type="label">
					<top>22</top>
					<width max="300">auto</width>
					<height>41</height>
					<font>font_body</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$LOCALIZE[24000]</label>
				</control>
			</control>
			<include>VN_Clock</include>
			<include>VN_TopRule</include>

			<!-- ====== categories + level -->
			<control type="grouplist" id="3">
				<description>categories</description>
				<left>page_margin</left>
				<top>content_top</top>
				<width>settings_cat_w</width>
				<height>576</height>
				<orientation>vertical</orientation>
				<onleft>noop</onleft>
				<onright>5</onright>
				<onup>20</onup>
				<ondown>20</ondown>
			</control>
			<include content="VN_SettingCategoryTemplate">
				<param name="width" value="settings_cat_w"/>
			</include>
			<control type="group">
				<left>page_margin</left>
				<top>760</top>
				<include content="VN_SettingLevelButton">
					<param name="width" value="settings_cat_w"/>
					<param name="onleft" value="noop"/>
				</include>
			</control>

			<!-- ====== settings list -->
			<control type="grouplist" id="5">
				<description>control area</description>
				<left>settings_list_x</left>
				<top>content_top</top>
				<width>860</width>
				<height>864</height>
				<pagecontrol>60</pagecontrol>
				<onleft>3</onleft>
				<onright>9000</onright>
				<onup>5</onup>
				<ondown>5</ondown>
			</control>
			<include content="VN_SettingTemplates">
				<param name="width" value="860"/>
			</include>
			<include content="VN_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1440"/>
				<param name="top" value="content_top"/>
				<param name="height" value="864"/>
				<param name="onleft" value="5"/>
				<param name="onright" value="9000"/>
			</include>

			<!-- ====== aside: buttons + description -->
			<control type="grouplist" id="9000">
				<left>1500</left>
				<top>content_top</top>
				<width>324</width>
				<height>216</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft>5</onleft>
				<onright>noop</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<include content="VN_DialogButton"><param name="id" value="28"/><param name="width" value="324"/><param name="height" value="dlg_btn_h"/></include>
				<include content="VN_DialogButton"><param name="id" value="29"/><param name="width" value="324"/><param name="height" value="dlg_btn_h"/></include>
				<include content="VN_DialogButton"><param name="id" value="30"/><param name="width" value="324"/><param name="height" value="dlg_btn_h"/></include>
			</control>
			<control type="group">
				<left>1500</left>
				<top>420</top>
				<width>324</width>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>324</width>
					<height>38</height>
					<font>font_small</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$LOCALIZE[31879]</label>
				</control>
				<include content="VN_Rule">
					<param name="top" value="32"/>
					<param name="left" value="0"/>
					<param name="width" value="324"/>
				</include>
				<control type="textbox" id="6">
					<description>description (Kodi)</description>
					<left>0</left>
					<top>52</top>
					<width>324</width>
					<height>532</height>  <!-- 14 lines of font_small (pitch 38): no half-clipped line at the bottom -->
					<font>font_small</font>
					<textcolor>$VAR[ink2]</textcolor>
					<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
				</control>
			</control>
		</control>
	</controls>
</window>
