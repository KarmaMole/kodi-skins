<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home = today's page (mockups/KeepsakeHome.html, renders/KeepsakeHome.png). An open album:
	  left page   "Monday, 19 October", the memory card (a year ago this week -> this month -> two years ago ->
	              where your diary begins), "you stopped ...", this year N films / M series, waiting five years or more
	  right page  "Pick up where you left off": the episode you're on (or the show), then two films in progress
	  bottom      pen words: films · series · music · search · settings (+ "playing" while something plays)
	Control ids
	  9110 memory prints (horizontal, one at a time: Left/Right browse the memories of that window)
	  9120 you stopped (1 item)         9130 episode in progress  9132 show in progress (fallback)
	  9140 films in progress (2)        9151 / 9152 this year / waiting since (stat words)
	  9000 nav grouplist: 9001 films, 9002 series, 9003 music, 9004 search, 9005 settings, 9006 playing
	  data: 9101-9104 memory windows, 9161/9162 counts this year, 9163 never played, 9164 oldest never played,
	        9171-9173 Skin Variables details (time of day), 9181/9182 title probes
	Focus: the memory print on open (or the nav word you left from). Back from anything -> the nav words.
	Down jumps page sections from any print; Up from a nav word goes to the section above it.
-->
<includes>
	<!-- ================================================================== expressions / variables -->
	<expression name="Home_HasMemory">Integer.IsGreater(Container(9110).NumItems,0)</expression>
	<expression name="Home_HasStopped">Integer.IsGreater(Container(9120).NumItems,0)</expression>
	<expression name="Home_HasEpisode">Integer.IsGreater(Container(9130).NumItems,0)</expression>
	<expression name="Home_HasShow">!Integer.IsGreater(Container(9130).NumItems,0) + Integer.IsGreater(Container(9132).NumItems,0)</expression>
	<expression name="Home_HasBig">Integer.IsGreater(Container(9130).NumItems,0) | Integer.IsGreater(Container(9132).NumItems,0)</expression>
	<expression name="Home_HasFilms">Integer.IsGreater(Container(9140).NumItems,0)</expression>
	<expression name="Home_SV">!Skin.HasSetting(keepsake.notime)</expression>
	<expression name="Home_MemSV">!Skin.HasSetting(keepsake.notime) + String.IsEqual(Container(9171).ListItem.DBID,Container(9110).ListItem.DBID) + !String.IsEmpty(Container(9171).ListItem.Property(lastplayed))</expression>
	<expression name="Home_LongMemTitle">Integer.IsGreater(Container(9181).NumPages,1)</expression>
	<expression name="Home_LongShowTitle">Integer.IsGreater(Container(9182).NumPages,1)</expression>

	<variable name="Home_MemoryPath">
		<value condition="Integer.IsGreater(Container(9101).NumItems,0)">$VAR[KS_Path_YAWeek]</value>
		<value condition="Integer.IsGreater(Container(9102).NumItems,0)">$VAR[KS_Path_YAMonth]</value>
		<value condition="Integer.IsGreater(Container(9103).NumItems,0)">$VAR[KS_Path_YA2]</value>
		<value>$VAR[KS_Path_Watched]</value>
	</variable>
	<variable name="Home_MemoryOrder">
		<value condition="!Integer.IsGreater(Container(9101).NumItems,0) + !Integer.IsGreater(Container(9102).NumItems,0) + !Integer.IsGreater(Container(9103).NumItems,0)">ascending</value>
		<value>descending</value>
	</variable>
	<variable name="Home_MemoryKicker">
		<value condition="Integer.IsGreater(Container(9101).NumItems,0)">a year ago this week</value>
		<value condition="Integer.IsGreater(Container(9102).NumItems,0)">a year ago this month</value>
		<value condition="Integer.IsGreater(Container(9103).NumItems,0)">two years ago this month</value>
		<value>where your diary begins</value>
	</variable>
	<!-- "on a Monday night," / "on a Monday," -->
	<variable name="Home_MemoryLine3">
		<value condition="$EXP[Home_MemSV]">on a $VAR[KS_MEM_Wd] $VAR[KS_T_MEM_Daypart],</value>
		<value condition="!String.IsEmpty(Container(9110).ListItem.LastPlayed)">on a $VAR[KS_MEM_Wd],</value>
	</variable>
	<!-- "just after nine." / "6 October 2025." -->
	<variable name="Home_MemoryLine4">
		<value condition="$EXP[Home_MemSV]">$VAR[KS_T_MEM_Spoken].</value>
		<value condition="!String.IsEmpty(Container(9110).ListItem.LastPlayed)">$VAR[KS_MEM_DM] $VAR[KS_MEM_Year].</value>
	</variable>
	<variable name="Home_MemoryCount">
		<value condition="Integer.IsGreater(Container(9110).NumItems,1)">$INFO[Container(9110).CurrentItem] of $INFO[Container(9110).NumItems]</value>
	</variable>

	<!-- relative day of a list item's last play: today / yesterday / on 18 October (2025) -->
	<variable name="KS_LP_Rel">
		<value condition="String.IsEqual(ListItem.LastPlayed,System.Date(dd/mm/yyyy))">today</value>
		<value condition="String.IsEqual(ListItem.LastPlayed,Window(Home).Property(keepsake.yesterday))">yesterday</value>
		<value condition="String.EndsWith(ListItem.LastPlayed,System.Date(yyyy))">on $VAR[KS_LP_DM]</value>
		<value condition="!String.IsEmpty(ListItem.LastPlayed)">on $VAR[KS_LP_DM] $VAR[KS_LP_Year]</value>
	</variable>
	<variable name="Home_EpRel">
		<value condition="String.IsEqual(Container(9130).ListItem.LastPlayed,System.Date(dd/mm/yyyy))">today</value>
		<value condition="String.IsEqual(Container(9130).ListItem.LastPlayed,Window(Home).Property(keepsake.yesterday))">yesterday</value>
		<value>$INFO[Container(9130).ListItem.LastPlayed]</value>
	</variable>
	<!-- "3:20 am today" under the episode -->
	<variable name="Home_EpWhen">
		<value condition="$EXP[Home_SV] + String.IsEqual(Container(9173).ListItem.DBID,Container(9130).ListItem.DBID) + !String.IsEmpty(Container(9173).ListItem.Property(lastplayed))">$VAR[KS_T_EP_Clock] $VAR[Home_EpRel]</value>
		<value>$VAR[Home_EpRel]</value>
	</variable>
	<!-- "21 minutes in," -->
	<variable name="KS_MinutesIn">
		<value condition="Integer.IsLess(ListItem.PercentPlayed,1)">just a few seconds in,</value>
		<value condition="String.IsEqual(ListItem.Duration(mins),1)">$VAR[KS_ResumeMin] minute in,</value>
		<value>$VAR[KS_ResumeMin] minutes in,</value>
	</variable>
	<variable name="Home_EpisodeLine">
		<value condition="Integer.IsGreater(ListItem.Season,1)">s$INFO[ListItem.Season], episode $INFO[ListItem.Episode],</value>
		<value>episode $INFO[ListItem.Episode],</value>
	</variable>

	<!-- this year: "25 films, 25 series" -->
	<variable name="Home_FilmsWord">
		<value condition="Integer.IsEqual(Container(9161).NumItems,1)">film,</value>
		<value>films,</value>
	</variable>
	<variable name="Home_WaitWord">
		<value condition="Integer.IsEqual(Container(9163).NumItems,1)">film, never played</value>
		<value>films, never played</value>
	</variable>

	<!-- ================================================================== data lists (always processed) -->
	<include name="Home_DataList">
		<param name="limit">1</param>
		<param name="sortby">lastplayed</param>
		<param name="sortorder">descending</param>
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>-40</left>
				<top>-40</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1"/>
				<focusedlayout width="1" height="1"/>
				<content target="videos" limit="$PARAM[limit]" sortby="$PARAM[sortby]" sortorder="$PARAM[sortorder]" browse="never">$PARAM[path]</content>
			</control>
		</definition>
	</include>
	<include name="Home_CountList">
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>-40</left>
				<top>-40</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1"/>
				<focusedlayout width="1" height="1"/>
				<content target="videos" browse="never">$PARAM[path]</content>
			</control>
		</definition>
	</include>
	<include name="Home_DataLists">
		<include content="Home_DataList"><param name="id" value="9101"/><param name="path" value="$VAR[KS_Path_YAWeek]"/></include>
		<include content="Home_DataList"><param name="id" value="9102"/><param name="path" value="$VAR[KS_Path_YAMonth]"/></include>
		<include content="Home_DataList"><param name="id" value="9103"/><param name="path" value="$VAR[KS_Path_YA2]"/></include>
		<include content="Home_CountList"><param name="id" value="9161"/><param name="path" value="$VAR[KS_Path_FilmsThisYear]"/></include>
		<include content="Home_CountList"><param name="id" value="9162"/><param name="path" value="$VAR[KS_Path_SeriesThisYear]"/></include>
		<include content="Home_CountList"><param name="id" value="9163"/><param name="path" value="$VAR[KS_Path_WaitingFive]"/></include>
		<include content="Home_DataList">
			<param name="id" value="9164"/>
			<param name="path" value="$VAR[KS_Path_Waiting]"/>
			<param name="sortby" value="dateadded"/>
			<param name="sortorder" value="ascending"/>
		</include>
		<!-- Skin Variables: the raw last-played datetime gives the time of day -->
		<control type="group">
			<visible>$EXP[Home_SV]</visible>
			<include content="Home_CountList"><param name="id" value="9171"/><param name="path" value="plugin://script.skinvariables/?info=get_dbitem_movie_details&amp;dbid=$INFO[Container(9110).ListItem.DBID]"/></include>
			<include content="Home_CountList"><param name="id" value="9173"/><param name="path" value="plugin://script.skinvariables/?info=get_dbitem_episode_details&amp;dbid=$INFO[Container(9130).ListItem.DBID]"/></include>
		</control>
		<!-- title probes (NumPages = does it fit one line?) -->
		<control type="textbox" id="9181">
			<left>626</left>
			<top>335</top>
			<width>330</width>
			<height>84</height>
			<font>hand_64x</font>
			<textcolor>clear</textcolor>
			<label>$INFO[Container(9110).ListItem.Title]</label>
		</control>
		<control type="textbox" id="9182">
			<left>1572</left>
			<top>264</top>
			<width>236</width>
			<height>66</height>
			<font>ttl_54</font>
			<textcolor>clear</textcolor>
			<label>$VAR[Home_BigTitle]</label>
		</control>
	</include>
	<variable name="Home_BigTitle">
		<value condition="Integer.IsGreater(Container(9130).NumItems,0)">$INFO[Container(9130).ListItem.TVShowTitle]</value>
		<value>$INFO[Container(9132).ListItem.Title]</value>
	</variable>

	<!-- ================================================================== the print item layouts -->
	<!-- a lifted print inside a list slot. params: kind, unangle (minus the tilt), list (id), art, x, y -->
	<include name="Home_PrintSlot">
		<param name="x">70</param>
		<param name="y">70</param>
		<param name="corners">true</param>
		<definition>
			<control type="group">
				<left>$PARAM[x]</left>
				<top>$PARAM[y]</top>
				<width>$PARAM[w]</width>
				<height>$PARAM[h]</height>
				<include content="KS_TiltFixed"><param name="angle" value="$PARAM[angle]"/></include>
				<control type="group">
					<width>$PARAM[w]</width>
					<height>$PARAM[h]</height>
					<include content="KS_LiftOnFocus">
						<param name="unangle" value="$PARAM[unangle]"/>
						<param name="focus" value="Control.HasFocus($PARAM[list])"/>
					</include>
					<include content="KS_Print_$PARAM[kind]">
						<param name="art" value="$PARAM[art]"/>
						<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
						<param name="stamped" value="!String.IsEmpty(ListItem.LastPlayed)"/>
						<param name="corners" value="$PARAM[corners]"/>
						<param name="lift" value="Control.HasFocus($PARAM[list])"/>
						<param name="title" value="$INFO[ListItem.Label]"/>
					</include>
				</control>
			</control>
		</definition>
	</include>

	<!-- ================================================================== left page -->
	<include name="Home_LeftPage">
		<!-- date header + label line -->
		<control type="label">
			<left>112</left>
			<top>40</top>
			<width>840</width>
			<height>130</height>
			<font>hand_100</font>
			<textcolor>ink</textcolor>
			<label>$INFO[System.Date(DDD)], $INFO[System.Date(d)] $INFO[System.Date(MMM)]</label>
		</control>
		<control type="label">
			<left>118</left>
			<top>169</top>
			<width>820</width>
			<height>27</height>
			<font>lbl_20</font>
			<textcolor>label</textcolor>
			<label>$LOCALIZE[31338]</label>
		</control>

		<!-- memory card: print list 9110 (one at a time, Left/Right browse) -->
		<control type="list" id="9110">
			<left>48</left>
			<top>182</top>
			<width>600</width>
			<height>400</height>
			<orientation>horizontal</orientation>
			<scrolltime tween="cubic" easing="out">260</scrolltime>
			<preloaditems>1</preloaditems>
			<onup>noop</onup>
			<ondown condition="$EXP[Home_HasStopped]">9120</ondown>
			<ondown>9151</ondown>
			<onright condition="$EXP[Home_HasEpisode]">9130</onright>
			<onright condition="$EXP[Home_HasShow]">9132</onright>
			<onright condition="$EXP[Home_HasFilms]">9140</onright>
			<onright>9152</onright>
			<onback>9001</onback>
			<itemlayout width="600" height="400">
				<include content="Home_PrintSlot">
					<param name="kind" value="Memory"/><param name="w" value="460"/><param name="h" value="271"/>
					<param name="angle" value="0"/><param name="unangle" value="0"/><param name="list" value="9110"/>
					<param name="art" value="$VAR[KS_LandscapeArt]"/><param name="corners" value="false"/>
				</include>
			</itemlayout>
			<focusedlayout width="600" height="400">
				<include content="Home_PrintSlot">
					<param name="kind" value="Memory"/><param name="w" value="460"/><param name="h" value="271"/>
					<param name="angle" value="0"/><param name="unangle" value="0"/><param name="list" value="9110"/>
					<param name="art" value="$VAR[KS_LandscapeArt]"/><param name="corners" value="false"/>
				</include>
			</focusedlayout>
			<content target="videos" limit="6" sortby="lastplayed" sortorder="$VAR[Home_MemoryOrder]" browse="never">$VAR[Home_MemoryPath]</content>
		</control>
		<!-- washi tape holding the memory print (mockup: 250x64 at 212,224, rotate -4deg) -->
		<control type="image">
			<left>212</left>
			<top>224</top>
			<width>250</width>
			<height>64</height>
			<texture colordiffuse="tape">ks/tape.png</texture>
			<animation effect="rotate" end="4" center="auto" time="0" condition="true">Conditional</animation>
			<visible>$EXP[Home_HasMemory]</visible>
		</control>
		<control type="label">
			<left>118</left>
			<top>540</top>
			<width>460</width>
			<height>40</height>
			<align>right</align>
			<font>hand_30</font>
			<textcolor>ink_faint</textcolor>
			<label>$VAR[Home_MemoryCount]</label>
			<visible>Control.HasFocus(9110)</visible>
		</control>
		<!-- the memory sentence -->
		<control type="group">
			<visible>$EXP[Home_HasMemory]</visible>
			<control type="label">
				<left>622</left>
				<top>259</top>
				<width>320</width>
				<height>27</height>
				<font>lbl_20</font>
				<textcolor>label_hi</textcolor>
				<label>$VAR[Home_MemoryKicker]</label>
			</control>
			<control type="label">
				<left>620</left>
				<top>289</top>
				<width>330</width>
				<height>60</height>
				<font>hand_44</font>
				<textcolor>ink</textcolor>
				<label>$LOCALIZE[31339]</label>
			</control>
			<!-- short title: one line, Caveat bold 64, pen underline -->
			<control type="group">
				<visible>!$EXP[Home_LongMemTitle]</visible>
				<control type="label">
					<left>626</left>
					<top>335</top>
					<width>330</width>
					<height>84</height>
					<font>hand_64x</font>
					<textcolor>ink_bold</textcolor>
					<label>$INFO[Container(9110).ListItem.Title]</label>
				</control>
				<control type="image">
					<left>616</left>
					<top>398</top>
					<width>190</width>
					<height>22</height>
					<texture colordiffuse="ink">ks/pen_line.png</texture>
				</control>
				<control type="label">
					<left>620</left>
					<top>406</top>
					<width>340</width>
					<height>60</height>
					<font>hand_44</font>
					<textcolor>ink</textcolor>
					<label>$VAR[Home_MemoryLine3]</label>
				</control>
				<control type="label">
					<left>620</left>
					<top>455</top>
					<width>340</width>
					<height>60</height>
					<font>hand_44</font>
					<textcolor>ink</textcolor>
					<label>$VAR[Home_MemoryLine4]</label>
				</control>
			</control>
			<!-- long title: two lines of Caveat 44 bold, the sentence moves down a line -->
			<control type="group">
				<visible>$EXP[Home_LongMemTitle]</visible>
				<control type="textbox">
					<left>620</left>
					<top>354</top>
					<width>330</width>
					<height>104</height>
					<font>hand_44b</font>
					<textcolor>ink_bold</textcolor>
					<label>$INFO[Container(9110).ListItem.Title]</label>
				</control>
				<control type="label">
					<left>620</left>
					<top>455</top>
					<width>340</width>
					<height>60</height>
					<font>hand_44</font>
					<textcolor>ink</textcolor>
					<label>$VAR[Home_MemoryLine3]</label>
				</control>
				<control type="label">
					<left>620</left>
					<top>504</top>
					<width>340</width>
					<height>60</height>
					<font>hand_44</font>
					<textcolor>ink</textcolor>
					<label>$VAR[Home_MemoryLine4]</label>
				</control>
			</control>
		</control>
		<!-- empty album (no film watched yet) -->
		<control type="textbox">
			<left>118</left>
			<top>262</top>
			<width>800</width>
			<height>200</height>
			<font>hand_44</font>
			<textcolor>ink_faint</textcolor>
			<label>$LOCALIZE[31340]</label>
			<visible>!$EXP[Home_HasMemory] + !Container(9110).IsUpdating</visible>
		</control>

		<!-- you stopped: list 9120 (print + sentence + pen progress inside the layout: resume minutes are per item) -->
		<control type="list" id="9120">
			<left>60</left>
			<top>530</top>
			<width>880</width>
			<height>330</height>
			<orientation>horizontal</orientation>
			<preloaditems>1</preloaditems>
			<onup condition="$EXP[Home_HasMemory]">9110</onup>
			<ondown>9151</ondown>
			<onright condition="$EXP[Home_HasFilms]">9140</onright>
			<onright condition="$EXP[Home_HasEpisode]">9130</onright>
			<onright condition="$EXP[Home_HasShow]">9132</onright>
			<onleft>noop</onleft>
			<onback>9001</onback>
			<itemlayout width="880" height="330">
				<include>Home_StoppedItem</include>
			</itemlayout>
			<focusedlayout width="880" height="330">
				<include>Home_StoppedItem</include>
			</focusedlayout>
			<content target="videos" limit="1" sortby="lastplayed" sortorder="descending" browse="never">$VAR[KS_Path_Stopped]</content>
		</control>
		<control type="group">
			<visible>!$EXP[Home_HasStopped] + !Container(9120).IsUpdating</visible>
			<control type="label">
				<left>118</left>
				<top>601</top>
				<width>700</width>
				<height>27</height>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$LOCALIZE[31341]</label>
			</control>
			<control type="textbox">
				<left>116</left>
				<top>629</top>
				<width>760</width>
				<height>130</height>
				<font>hand_42</font>
				<textcolor>ink2</textcolor>
				<label>$LOCALIZE[31342]</label>
			</control>
		</control>

		<!-- this year / waiting since -->
		<control type="button" id="9151">
			<left>104</left>
			<top>842</top>
			<width>368</width>
			<height>112</height>
			<texturefocus />
			<texturenofocus />
			<onup condition="$EXP[Home_HasStopped]">9120</onup>
			<onup condition="$EXP[Home_HasMemory]">9110</onup>
			<onright>9152</onright>
			<ondown>9001</ondown>
			<onleft>noop</onleft>
			<onback>9001</onback>
			<onclick>SetProperty(keepsake.navfrom,9151,home)</onclick>
			<onclick>ActivateWindow(1161)</onclick>
		</control>
		<control type="button" id="9152">
			<left>488</left>
			<top>842</top>
			<width>440</width>
			<height>112</height>
			<texturefocus />
			<texturenofocus />
			<onup condition="$EXP[Home_HasStopped]">9120</onup>
			<onup condition="$EXP[Home_HasMemory]">9110</onup>
			<onleft>9151</onleft>
			<onright condition="$EXP[Home_HasFilms]">9140</onright>
			<onright condition="$EXP[Home_HasEpisode]">9130</onright>
			<onright condition="$EXP[Home_HasShow]">9132</onright>
			<ondown>9003</ondown>
			<onback>9001</onback>
			<onclick>SetProperty(keepsake.navfrom,9152,home)</onclick>
			<onclick>ActivateWindow(1160)</onclick>
		</control>
		<control type="label">
			<left>118</left>
			<top>851</top>
			<width>360</width>
			<height>27</height>
			<font>lbl_20</font>
			<textcolor>label</textcolor>
			<label>$LOCALIZE[31343]</label>
		</control>
		<control type="grouplist">
			<left>116</left>
			<top>862</top>
			<width>380</width>
			<height>90</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<control type="label">
				<width>auto</width>
				<height>84</height>
				<font>hand_66x</font>
				<textcolor>ink_bold</textcolor>
				<label>$INFO[Container(9161).NumItems]</label>
			</control>
			<control type="label">
				<top>21</top>
				<width>auto</width>
				<height>60</height>
				<font>hand_44</font>
				<textcolor>$VAR[Home_StatColor1]</textcolor>
				<label>$VAR[Home_FilmsWord]</label>
			</control>
			<control type="label">
				<width>auto</width>
				<height>84</height>
				<font>hand_66x</font>
				<textcolor>ink_bold</textcolor>
				<label>$INFO[Container(9162).NumItems]</label>
			</control>
			<control type="label">
				<top>21</top>
				<width>auto</width>
