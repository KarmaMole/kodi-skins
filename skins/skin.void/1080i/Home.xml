<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home: one item at a time on true black (VoidHome / VoidAmbient mockups; docs/skin.void/SPEC.md).
	Includes_Home.xml is GENERATED by _src/make_home.py.

	Focus map
	  Up / Down      previous / next item of the shelf (rolodex; neighbours are the faint lines)
	  Left / Right   previous / next shelf (wraps): Next up, Unwatched rated, Newest, Albums, Shows,
	                 Library (Movies, TV, Music, ... Settings, Power), Search
	  Select         movie / episode: play or resume at once; show / album / folder: open it
	  Info           Kodi's information page for the item.  Back: first item of the shelf.
	Home is kept in memory: shelves keep their position; Window(Home).Property(void.shelf) remembers
	the shelf for the session.
-->
<window>
	<defaultcontrol always="true">9111</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<onload condition="String.IsEmpty(Window(Home).Property(void.shelf))">SetProperty(void.shelf,1,home)</onload>
	<!-- new stamp each time Home opens: the Next up plugin path changes, so it refreshes after playback -->
	<onload>SetProperty(void.reload,$INFO[System.Time(hh:mm:ss)],home)</onload>
	<onload>SetProperty(void.dir,none,home)</onload>
	<!-- stand-in first (always focusable), then the list (succeeds once it has items) -->
	<onload>SetFocus(911$INFO[Window(Home).Property(void.shelf)])</onload>
	<onload>SetFocus(910$INFO[Window(Home).Property(void.shelf)])</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include>Home_Ambient</include>
		<include>Home_Drivers</include>
		<include>Home_Furniture</include>
		<include>Home_Shelves</include>
		<include>Home_NowPlaying</include>
	</controls>
</window>
