	<!-- Segmented control, DESIGN 7.7: 1px border_control frame; selected option filled bone with
	     bold ink text (accent fill when the row has focus); others regular text_secondary.
	     Dlg_SegOption params: left, width, label, selected (condition), row (row button id)
	     Dlg_SegFrame params: left, width (draw AFTER the options) -->
	<include name="Dlg_SegOption">
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>25</top>
				<width>$PARAM[width]</width>
				<height>50</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<texture border="10" colordiffuse="$VAR[SectionText]">$VAR[ButtonFill]</texture>
					<visible>[$PARAM[selected]] + !Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<texture border="10" colordiffuse="ink">$VAR[ButtonFill]</texture>
					<visible>[$PARAM[selected]] + Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<align>center</align>
					<font>bold_22</font>
					<textcolor>paper</textcolor>
					<label>$PARAM[label]</label>
					<visible>$PARAM[selected]</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<align>center</align>
					<font>ui_22</font>
					<textcolor>$VAR[SectionText2]</textcolor>
					<label>$PARAM[label]</label>
					<visible>![$PARAM[selected]]</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="Dlg_SegFrame">
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>25</top>
				<width>$PARAM[width]</width>
				<height>50</height>
				<texture border="10" colordiffuse="ink">$VAR[ButtonOutline]</texture>
			</control>
