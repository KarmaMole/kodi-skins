<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library (Includes_Views_Music.xml). Kodi id contract (Estuary Omega MyMusicNav.xml /
	GUIWindowMusicNav.cpp): views in <views>, 3 sort by / 4 sort order (hidden, clicked by the option words).
	Reserved by Kodi here and not reused: 2, 5, 8, 12, 15, 16, 17, 19, 20.
	Keepsake ids: 530 instant prints (albums), 531 prints (artists), 50 list; 9000 section words (9320-9323),
	9310 option words (9324-9326), 60 list scrollbar.
	Focus: the view; Up = option words, Up again = section words. Section words ReplaceWindow, so Back from any
	section returns to where music was opened from (Home) in one press.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<backgroundcolor>paper</backgroundcolor>
	<views>530,531,50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>KS_Page</include>
		<include>Music_View_530</include>
		<include>Music_View_531</include>
		<include>View_50_List</include>
		<control type="textbox">
			<left>112</left>
			<top>262</top>
			<width>1200</width>
			<height>110</height>
			<font>hand_46</font>
			<textcolor>ink_faint</textcolor>
			<label>This page is empty. Up for albums, artists or songs.</label>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
		</control>
		<include>Music_Header</include>
		<include>Music_NowPlayingBar</include>
	</controls>
</window>
