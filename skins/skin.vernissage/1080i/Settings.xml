<?xml version="1.0" encoding="UTF-8"?>
<!-- Engine forked from skin.groove 1.0.1 (M1); the Vernissage settings page in M4 (skin-developer, 2026-10-21). -->
<!--
	Kodi settings home (window "settings"), screens/Settings.md: the room, the exhibition title "Kodi settings", one
	column of placard rows (list 9000 at 120, 196, 900 x 768: icon 40 at x 24 in ink2 -> ink, label font_body, focus =
	ink + the 2 px hairline), and on the wall at the right the focused entry's name and what it holds (1100, 196), a few
	facts at the bottom. No Kodi-owned ids; entries as Estuary Omega's Settings.xml, Vernissage's Skin settings first.
	Focus: list 9000 (rest; Up / Down stop at the ends). Back closes (Kodi: back to Home and its back office).
	No window-level animation (MOTION 3).
-->
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<controls>
		<include>VN_Room</include>
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="VN_SettingsHead">
				<param name="title" value="$LOCALIZE[31621]"/>
				<param name="sub" value="$LOCALIZE[31585]"/>
			</include>
			<control type="list" id="9000">
				<left>120</left>
				<top>196</top>
				<width>900</width>
				<height>768</height>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<include>Anim_ScrollRow</include>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="900"/>
					<param name="height" value="64"/>
					<param name="list_id" value="9000"/>
				</include>
				<content>
					<item>
						<label>$LOCALIZE[31021]</label>
						<label2>$LOCALIZE[31024]</label2>
						<icon>vn/icons/skin.png</icon>
						<property name="help">$LOCALIZE[31579]</property>
						<onclick>ActivateWindow(skinsettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14200]</label>
						<icon>vn/icons/play.png</icon>
						<property name="help">$LOCALIZE[31881]</property>
						<onclick>ActivateWindow(PlayerSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14211]</label>
						<icon>vn/icons/albums.png</icon>
						<property name="help">$LOCALIZE[31882]</property>
						<onclick>ActivateWindow(MediaSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14206]</label>
						<icon>vn/icons/view.png</icon>
						<property name="help">$LOCALIZE[31883]</property>
						<onclick>ActivateWindow(InterfaceSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[24001]</label>
						<icon>vn/icons/addons.png</icon>
						<property name="help">$LOCALIZE[31884]</property>
						<onclick>ActivateWindow(addonbrowser)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14036]</label>
						<icon>vn/icons/update.png</icon>
						<property name="help">$LOCALIZE[31885]</property>
						<onclick>ActivateWindow(ServiceSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13000]</label>
						<icon>vn/icons/system.png</icon>
						<property name="help">$LOCALIZE[31886]</property>
						<onclick>ActivateWindow(SystemSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[10003]</label>
						<icon>vn/icons/files.png</icon>
						<property name="help">$LOCALIZE[31887]</property>
						<onclick>ActivateWindow(filemanager)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[138]</label>
						<icon>vn/icons/info.png</icon>
						<property name="help">$LOCALIZE[31888]</property>
						<onclick>ActivateWindow(systeminfo)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31855]</label>
						<icon>vn/icons/liner.png</icon>
						<property name="help">$LOCALIZE[31889]</property>
						<onclick>ActivateWindow(eventlog)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13200]</label>
						<icon>vn/icons/artists.png</icon>
						<property name="help">$LOCALIZE[31890]</property>
						<onclick>ActivateWindow(Profiles)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14204]</label>
						<icon>vn/icons/livetv.png</icon>
						<property name="help">$LOCALIZE[31891]</property>
						<onclick>ActivateWindow(PVRSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[15016]</label>
						<icon>vn/icons/games.png</icon>
						<property name="help">$LOCALIZE[31892]</property>
						<onclick>ActivateWindow(GameSettings)</onclick>
						<visible>System.GetBool(gamesgeneral.enable)</visible>
					</item>
				</content>
			</control>
			<!-- what the focused entry holds, on the wall at the right -->
			<control type="group">
				<left>1100</left>
				<top>196</top>
				<width>700</width>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>700</width>
					<height>44</height>
					<font>font_placard</font>
					<label>$INFO[Container(9000).ListItem.Label]</label>
				</control>
				<control type="image">
					<left>0</left>
					<top>60</top>
					<width>vn_rule_w</width>
					<height>vn_rule_h</height>
					<texture colordiffuse="$VAR[placard_rule]">vn/white.png</texture>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>78</top>
					<width>700</width>
					<height>152</height>
					<font>font_small</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[Container(9000).ListItem.Property(help)]</label>
				</control>
				<control type="group">
					<top>560</top>
					<include content="Dlg_FactRow"><param name="top" value="0"/><param name="label" value="Kodi"/><param name="value" value="$INFO[System.BuildVersion]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="44"/><param name="label" value="$LOCALIZE[31580]"/><param name="value" value="$INFO[System.AddonVersion(skin.vernissage)]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="88"/><param name="label" value="$LOCALIZE[31894]"/><param name="value" value="$INFO[Network.IPAddress]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="132"/><param name="label" value="$LOCALIZE[31895]"/><param name="value" value="$INFO[System.ScreenResolution]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="176"/><param name="label" value="$LOCALIZE[31896]"/><param name="value" value="$INFO[System.Uptime]"/><param name="valuew" value="520"/></include>
				</control>
			</control>
		</control>
	</controls>
</window>
