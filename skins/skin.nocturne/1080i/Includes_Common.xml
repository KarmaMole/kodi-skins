<?xml version="1.0" encoding="UTF-8"?>
<!--
	Common building blocks: page background, top-bar furniture, focus frames, posters,
	watched markers, buttons. Prefix: Noc_. Parameterised includes document their params.
-->
<includes>
	<!-- ============================================================ page -->

	<!-- Flat page background (bg). Use as the first control of every full-screen window. -->


	<!-- 1px horizontal rule. params: top, left (default page margin), width (default page width), color -->
	<include name="Noc_Rule">
		<param name="top">0</param>
		<param name="left">page_margin</param>
		<param name="width">page_width</param>
		<param name="color">$VAR[ColorRule]</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>rule_h</height>
				<texture colordiffuse="$PARAM[color]">common/hairline.png</texture>
			</control>
		</definition>
	</include>

	<!-- Header rule at the bottom of the 120px top bar -->
	<include name="Noc_TopRule">
		<description>the cornice carries its own shadow line</description>
	</include>

	<!-- Date + clock, right side of the top bar (DESIGN 7.4) -->


	<!-- Page header for library / settings windows: mono index (accent) + page name.
	     params: index ("02"), title (label), sub (optional mono caption after the title) -->
	<include name="Noc_PageHeader">
		<param name="index"></param>
		<param name="title"></param>
		<param name="sub"></param>
		<definition>
			<include content="Noc_Crumbs">
				<param name="first" value="$PARAM[title]"/>
				<param name="second" value="$PARAM[sub]"/>
			</include>
		</definition>
	</include>

	<!-- Full top bar for non-Home windows: header + clock + rule -->
	<include name="Noc_TopBar">
		<param name="index"></param>
		<param name="title"></param>
		<param name="sub"></param>
		<definition>
			<include>Noc_CorniceImage</include>
			<include content="Noc_Crumbs">
				<param name="first" value="$PARAM[title]"/>
				<param name="second" value="$PARAM[sub]"/>
			</include>
			<include>Noc_Clock</include>
		</definition>
	</include>

	<!-- ===================================================== focus frames -->
	<!-- Put inside a group sized to the item; the frame grows 7px on each side (DESIGN 7.2).
	     param visible: condition (e.g. Control.HasFocus(9110)); omit inside focusedlayouts. -->
	<include name="Noc_FocusFrame">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="16" colordiffuse="light">$VAR[FocusFrame]</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- Same, but never hidden by the "Off" setting (buttons, menus, dialogs) -->
	<include name="Noc_FocusFrameAlways">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="16" colordiffuse="light">$VAR[FocusFrameAlways]</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ========================================================== posters -->
	<!-- Poster/cover image with corner mask chosen at window load (DESIGN 7.1; changing the
	     corners setting runs ReloadSkin()). Sits inside a group of the poster size.
	     params: art (infolabel), mask_round, mask_square, title (fallback label) -->
	<include name="Noc_Artwork">
		<param name="art">$INFO[ListItem.Art(poster)]</param>
		<param name="mask_round">masks/poster_round8.png</param>
		<param name="mask_square">masks/poster_square.png</param>
		<param name="title">$INFO[ListItem.Label]</param>
		<definition>
			<!-- fallback: raised block + title, covered by the artwork when it loads -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="bg_raised">common/white.png</texture>
			</control>
			<control type="label">
				<left>12</left>
				<right>12</right>
				<top>12</top>
				<height>60</height>
				<font>sans_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$PARAM[title]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<texture background="true" diffuse="$PARAM[mask_round]">$PARAM[art]</texture>
				<visible>false</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<texture background="true">$PARAM[art]</texture>
				<visible>true</visible>
			</control>
		</definition>
	</include>

	<!-- Watched markers for a movie/episode poster (DESIGN 7.3 / SPEC 6). Inside the poster group. -->
	<include name="Noc_WatchedMarkers">
		<include content="Noc_Pin">
			<param name="visible" value="$EXP[ShowWatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemWatched]"/>
		</include>
		<control type="progress">
			<left>0</left>
			<right>0</right>
			<bottom>-14</bottom>
			<height>2</height>
			<texturebg colordiffuse="brass_dim">common/white.png</texturebg>
			<midtexture colordiffuse="brass_light">common/white.png</midtexture>
			<info>ListItem.PercentPlayed</info>
			<visible>ListItem.IsResumable</visible>
		</control>
	</include>

	<!-- ========================================================== buttons -->
	<!-- Button textures (static texture names so rounded/square is picked at window load) -->
	<include name="Noc_Tex_ButtonPrimary">
		<texturefocus border="30,0,30,0">noc/rail_on.png</texturefocus>
		<texturenofocus border="26,0,26,0">noc/plaque_dim.png</texturenofocus>
	</include>
	<include name="Noc_Tex_ButtonPrimary_Round">
		<texturefocus border="10" colordiffuse="light">common/rect_round8.png</texturefocus>
		<texturenofocus border="10" colordiffuse="light">common/rect_round8.png</texturenofocus>
	</include>
	<include name="Noc_Tex_ButtonSecondary">
		<texturefocus border="30,0,30,0">noc/rail_on.png</texturefocus>
		<texturenofocus border="26,0,26,0">noc/plaque_dim.png</texturenofocus>
	</include>
	<include name="Noc_Tex_ButtonSecondary_Round">
		<texturefocus border="10" colordiffuse="text_primary">common/rect_outline_1_round8.png</texturefocus>
		<texturenofocus border="10" colordiffuse="border_button">common/rect_outline_1_round8.png</texturenofocus>
	</include>

	<!-- Primary (accent fill, ink text) / secondary (1px outline) action buttons, 58px.
	     Each lives in its own group so the focus frame can grow around it.
	     params: id, left, top, width, label, onclick, visible, onleft, onright, onup, ondown, icon;
	     onleft_if/onleft_then, onright_if/onright_then = an extra conditional action run before onleft/onright -->
	<include name="Noc_ButtonPrimary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="icon"></param>
		<param name="onup"></param>
		<param name="ondown"></param>
		<param name="onleft"></param>
		<param name="onleft_if">false</param>
		<param name="onleft_then">noop</param>
		<param name="onright"></param>
		<param name="onright_if">false</param>
		<param name="onright_then">noop</param>
		<param name="onback"></param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>btn_22</font>
					<textcolor>brass_word</textcolor>
					<focusedcolor>ink</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>8</textoffsetx>
					<include>Noc_Tex_ButtonPrimary</include>
					<onclick>$PARAM[onclick]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft condition="$PARAM[onleft_if]">$PARAM[onleft_then]</onleft>
					<onleft>$PARAM[onleft]</onleft>
					<onright condition="$PARAM[onright_if]">$PARAM[onright_then]</onright>
					<onright>$PARAM[onright]</onright>
					<onback>$PARAM[onback]</onback>
				</control>
			</control>
		</definition>
	</include>
	<include name="Noc_ButtonSecondary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="focus_also">false</param>
		<param name="onclick2">noop</param>
		<param name="onup"></param>
		<param name="ondown"></param>
		<param name="onleft"></param>
		<param name="onleft_if">false</param>
		<param name="onleft_then">noop</param>
		<param name="onright"></param>
		<param name="onright_if">false</param>
		<param name="onright_then">noop</param>
		<param name="onback"></param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>btn_22</font>
					<textcolor>brass_word</textcolor>
					<focusedcolor>ink</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>8</textoffsetx>
					<include>Noc_Tex_ButtonSecondary</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft condition="$PARAM[onleft_if]">$PARAM[onleft_then]</onleft>
					<onleft>$PARAM[onleft]</onleft>
					<onright condition="$PARAM[onright_if]">$PARAM[onright_then]</onright>
					<onright>$PARAM[onright]</onright>
					<onback>$PARAM[onback]</onback>
				</control>
			</control>
		</definition>
	</include>

	<!-- Mono sub-nav button (library header bar, OSD text buttons): accent fill + ink on focus.
	     params: id, label, onclick, visible -->
	<include name="Noc_SubNavButton">
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>subnav_h</height>
				<font>caps_20</font>
				<aligny>center</aligny>
				<textcolor>8cc8b8a0</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<textoffsetx>14</textoffsetx>
				<texturefocus colordiffuse="light">noc/glow_word.png</texturefocus>
				<texturenofocus />
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Off-screen object (template/hidden controls Kodi needs but the user never sees) -->
	<include name="Noc_Hidden">
		<left>offscreen</left>
		<top>offscreen</top>
		<width>1</width>
		<height>1</height>
		<texturefocus />
		<texturenofocus />
	</include>
</includes>
