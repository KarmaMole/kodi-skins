<?xml version="1.0" encoding="UTF-8"?>
<!--
	Library views and the generic list window (SPEC 6).
	View ids: 50 List (M1, generic fallback) | 500 Poster Showcase | 501 Big Poster | 502 Wall |
	503 Episodes | 504 Albums | 505 Big Album (M2). Every view gates itself with Container.Content.
	Header bar (grouplist 9000) replaces Estuary's side blade; uses Kodi's media-window ids
	(3 = sort by, 4 = sort order, 10 = watched filter in video windows).
-->
<includes>
	<!-- ============================================================ View 50 -->
	<!-- List: rows on the left page (focused row = a strip of washi tape, dark ink), the focused item's
	     print + title + plot on the right page. Used by MyVideoNav, MyMusicNav, add-ons and generic windows. -->
	<include name="KS_RowLabel">
		<!-- focusedlayout label in two inks: dark on the tape while the list has focus, else the given colour.
		     params: list, left, right (no width: Kodi sizes it from the layout), height, font, label, color, align -->
		<param name="align">left</param>
		<param name="color">ink_bold</param>
		<param name="top">0</param>
		<definition>
			<control type="label">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<right>$PARAM[right]</right>
				<height>$PARAM[height]</height>
				<align>$PARAM[align]</align>
				<aligny>center</aligny>
				<font>$PARAM[font]</font>
				<textcolor>on_tape</textcolor>
				<selectedcolor>on_tape</selectedcolor>
				<label>$PARAM[label]</label>
				<visible>Control.HasFocus($PARAM[list])</visible>
			</control>
			<control type="label">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<right>$PARAM[right]</right>
				<height>$PARAM[height]</height>
				<align>$PARAM[align]</align>
				<aligny>center</aligny>
				<font>$PARAM[font]</font>
				<textcolor>$PARAM[color]</textcolor>
				<selectedcolor>$PARAM[color]</selectedcolor>
				<label>$PARAM[label]</label>
				<visible>!Control.HasFocus($PARAM[list])</visible>
			</control>
		</definition>
	</include>
	<include name="KS_TapeRow">
		<!-- the tape strip behind a focused row. params: list, width, height -->
		<definition>
			<control type="image">
				<left>-14</left>
				<top>2</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texture>
				<visible>Control.HasFocus($PARAM[list])</visible>
			</control>
		</definition>
	</include>
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<control type="list" id="50">
				<left>126</left>
				<top>236</top>
				<width>800</width>
				<height>768</height>
				<onup condition="Control.IsVisible(9310)">9310</onup>
				<onup>9000</onup>
				<onleft>noop</onleft>
				<onright>60</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<itemlayout width="800" height="64">
					<control type="label">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>64</height>
						<aligny>center</aligny>
						<font>ttt_28</font>
						<textcolor>ink2</textcolor>
						<selectedcolor>ink2</selectedcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>570</left>
						<top>0</top>
						<width>210</width>
						<height>64</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>lbln_20</font>
						<textcolor>label</textcolor>
						<selectedcolor>label</selectedcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>
				<focusedlayout width="800" height="64">
					<include content="KS_TapeRow"><param name="list" value="50"/><param name="width" value="808"/><param name="height" value="60"/></include>
					<include content="KS_RowLabel">
						<param name="list" value="50"/><param name="left" value="0"/><param name="right" value="240"/><param name="height" value="64"/>
						<param name="font" value="ttt_28"/><param name="label" value="$INFO[ListItem.Label]"/>
					</include>
					<include content="KS_RowLabel">
						<param name="list" value="50"/><param name="left" value="570"/><param name="right" value="20"/><param name="height" value="64"/>
						<param name="font" value="lbln_20"/><param name="label" value="$INFO[ListItem.Label2]"/><param name="align" value="right"/><param name="color" value="label_hi"/>
					</include>
				</focusedlayout>
			</control>
			<include content="KS_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="948"/>
				<param name="top" value="240"/>
				<param name="height" value="760"/>
				<param name="onleft" value="50"/>
				<param name="onright" value="50"/>
			</include>
			<!-- the focused item on the right page -->
			<control type="group">
				<left>1080</left>
				<top>236</top>
				<width>740</width>
				<control type="group">
					<width>248</width>
					<height>348</height>
					<visible>!Window.IsActive(music) + [!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster))]</visible>
					<include content="KS_TiltFixed"><param name="angle" value="-1.2"/></include>
					<include content="KS_Print_PosterM">
						<param name="art" value="$VAR[KS_PosterArt]"/>
						<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
						<param name="stamped" value="Integer.IsGreater(ListItem.PlayCount,0) + !String.IsEmpty(ListItem.LastPlayed)"/>
					</include>
				</control>
				<control type="group">
					<width>408</width>
					<height>242</height>
					<visible>!Window.IsActive(music) + String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + [!String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(thumb))] + !ListItem.IsParentFolder</visible>
					<include content="KS_TiltFixed"><param name="angle" value="1.2"/></include>
					<include content="KS_Print_Land">
						<param name="art" value="$VAR[KS_LandscapeArt]"/>
						<param name="aspect" value="keep"/>
						<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
						<param name="stamped" value="Integer.IsGreater(ListItem.PlayCount,0) + !String.IsEmpty(ListItem.LastPlayed)"/>
					</include>
				</control>
				<control type="group">
					<width>234</width>
					<height>280</height>
					<visible>Window.IsActive(music) + !String.IsEmpty(ListItem.Art(thumb)) + !ListItem.IsParentFolder</visible>
					<include content="KS_TiltFixed"><param name="angle" value="-1.4"/></include>
					<include content="KS_Print_Instant">
						<param name="art" value="$INFO[ListItem.Art(thumb)]"/>
						<param name="caption" value="$INFO[ListItem.Album]"/>
						<param name="corners" value="false"/>
						<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
						<param name="stamped" value="!String.IsEmpty(ListItem.LastPlayed)"/>
					</include>
				</control>
				<control type="label">
					<left>0</left>
					<top>392</top>
					<width>740</width>
					<height>60</height>
					<font>ttt_40</font>
					<textcolor>cream</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>!ListItem.IsParentFolder</visible>
				</control>
				<control type="label">
					<left>2</left>
					<top>458</top>
					<width>740</width>
					<height>27</height>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins),  ·  , min]$INFO[ListItem.Genre,  ·  ,]</label>
				</control>
				<control type="textbox">
					<left>2</left>
					<top>500</top>
					<width>740</width>
					<height>210</height>
					<font>body_26</font>
					<textcolor>body</textcolor>
					<label>$INFO[ListItem.Plot]</label>
					<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>
				</control>
				<control type="label">
					<left>0</left>
					<top>392</top>
					<width>740</width>
					<height>60</height>
					<font>hand_46</font>
					<textcolor>ink_faint</textcolor>
					<label>back a page</label>
					<visible>ListItem.IsParentFolder</visible>
				</control>
			</control>
		</control>
	</include>

	<!-- ===================================================== library header bar -->
	<!-- Sub-nav under the top rule. params: show_watched (true in video windows) -->
	<include name="KS_LibraryHeaderBar">
		<param name="show_watched">false</param>
		<definition>
			<control type="grouplist" id="9000">
				<left>subnav_left</left>
				<top>below_bar_top</top>
				<width>1300</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<itemgap>28</itemgap>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>50</ondown>
				<onback>50</onback>
				<include content="KS_SubNavButton">
					<param name="id" value="10"/>
					<param name="label" value="$LOCALIZE[16100]"/>
					<param name="visible" value="$PARAM[show_watched] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)]"/>
				</include>
				<include content="KS_SubNavButton">
					<param name="id" value="6053"/>
					<param name="label" value="$LOCALIZE[31010]: $INFO[Container.SortMethod]"/>
					<param name="onclick" value="SendClick(3)"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<include content="KS_SubNavButton">
					<param name="id" value="6052"/>
					<param name="label" value="$INFO[Container.SortOrder]"/>
					<param name="onclick" value="Container.SetSortDirection"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<include content="KS_SubNavButton">
					<param name="id" value="6051"/>
					<param name="label" value="$LOCALIZE[31011]: $INFO[Container.Viewmode]"/>
					<param name="onclick" value="Container.NextViewMode"/>
					<param name="visible" value="Integer.IsGreater(Container.ViewCount,1)"/>
				</include>
			</control>
			<!-- item count, right-aligned on the same line -->
			<control type="label">
				<left>page_margin</left>
				<top>below_bar_top</top>
				<width>page_width</width>
				<height>subnav_h</height>
				<align>right</align>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$INFO[Container.CurrentItem]$INFO[Container.NumItems, / ,]</label>
			</control>
			<!-- Kodi media-window buttons the sub-nav clicks into (sort by / sort order) -->
			<control type="button" id="3">
				<description>Sort by (Kodi)</description>
				<include>KS_Hidden</include>
			</control>
			<control type="button" id="4">
				<description>Sort order (Kodi)</description>
				<include>KS_Hidden</include>
			</control>
		</definition>
	</include>

	<!-- ========================================== generic list window (Minimal treatment) -->
	<!-- Background + top bar + header bar + view 50. params: index, title -->
	<include name="KS_GenericListWindow">
		<param name="index">01</param>
		<param name="title">$VAR[LibraryTitle]</param>
		<param name="show_watched">false</param>
		<definition>
			<include>KS_Background</include>
			<include content="KS_TopBar">
				<param name="index" value="$PARAM[index]"/>
				<param name="title" value="$PARAM[title]"/>
			</include>
			<include content="KS_LibraryHeaderBar">
				<param name="show_watched" value="$PARAM[show_watched]"/>
			</include>
			<include>View_50_List</include>
			<!-- empty folder / still loading -->
			<control type="label">
				<left>page_margin</left>
				<top>list_top</top>
				<width>list_w</width>
				<height>66</height>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$LOCALIZE[31012]</label>
				<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			</control>
		</definition>
	</include>
</includes>
