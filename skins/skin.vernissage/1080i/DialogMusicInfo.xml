<!--
	Album / artist / song placard (SPEC 9). Kodi also loads this file for songinformation (CGUIDialogSongInfo).
	Includes_ListeningRoom.xml MInfo_Body (GENERATED by _src/make_listening.py): sleeve 600 in a 20 px mat with the
	disc art behind it, the curator's card as tall as the mat, Play / Shuffle (helper) / Tracklist / More.
	Kodi id contract (Estuary Omega DialogMusicInfo.xml, GUIDialogMusicInfo.cpp / GUIDialogSongInfo.cpp):
	  50 the list Kodi fills (album: songs, artist: discography); 6 refresh, 8 play, 10 choose art, 12 artist / album
	  info stay offscreen (Kodi writes its own labels into them); our icon buttons SendClick(8) / SendClick(12).
	Focus map: action row 9910 (9911 Play, 9912 Shuffle with the helper, 9913 Tracklist / Discography, 9914 More) | Down -> 50; 50: Up / Back -> 9910.
	Back on the buttons closes the dialog (Kodi).
-->
<window>
	<defaultcontrol always="true">9910</defaultcontrol>
	<controls>
		<include>MInfo_Body</include>
	</controls>
</window>
