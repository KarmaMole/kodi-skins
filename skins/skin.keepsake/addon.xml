<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.keepsake" version="0.9.10" name="Keepsake" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required: Skin Variables URL-encodes the search query and reads the exact time you watched
		     something from the library. -->
		<import addon="script.skinvariables" version="2.1.21"/>
		<!-- Optional: TMDb Helper (trailers, cast pages). The skin runs without it. -->
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Keepsake - the skin that remembers.</summary>
		<description lang="en_GB">A black-paged photo album of your life with films: every film you watched is a print with the date stamped in the corner in orange camera digits, and handwritten notes tell you what you were watching a year ago this week, what you stopped, and what has been waiting since you added it. Built for the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#keepsake</website>
		<news>v0.9.10 - Settings: fixed text overlapping controls. "The words hide after" and "the menu shows" keep all their choices on the left page ("never" sat on the print's caption, "search" crossed the fold), and "hand-placed" no longer touches its pen circle.</news>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
		</assets>
	</extension>
</addon>
