				<width>640</width>
				<height>68</height>
				<texture colordiffuse="card_lift">common/white.png</texture>
				<visible>Control.IsVisible(1011)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>883</top>
				<width>640</width>
				<height>68</height>
				<texture colordiffuse="card_lift">common/white.png</texture>
				<visible>Control.IsVisible(1012)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>203</top>
				<width>640</width>
				<height>32</height>
				<texture colordiffuse="card_lift">common/white.png</texture>
				<animation effect="slide" end="0,68" time="0" condition="Control.IsVisible(1002)">Conditional</animation>
				<animation effect="slide" end="0,68" time="0" condition="Control.IsVisible(1003)">Conditional</animation>
				<animation effect="slide" end="0,68" time="0" condition="Control.IsVisible(1004)">Conditional</animation>
