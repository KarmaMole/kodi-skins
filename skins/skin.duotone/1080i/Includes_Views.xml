<?xml version="1.0" encoding="UTF-8"?>
<!--
	Generic list view (50) and the generic list window, Duotone language (DESIGN.md section 5.4).
	View ids: 50 List (every content type) | 500 Wall (video library) | 503 Episodes | 504 Albums wall |
	505 Tracks (music). Every view gates itself with Container.Content.
	Header: caption (y 76) + filter/sort bar (grouplist 9000, right side of the header row, ends before
	the clock) + 8px rule at y 136. Kodi media-window ids 3 = sort by, 4 = sort order.

	View 50: rows of 72 (Inter Tight 700 26) between 2px rules, focused row = ink bar + paper text;
	right column = the focused item printed in the section colour + Anton title, caption, plot.
-->
<includes>
	<constant name="list_x">64</constant>
	<constant name="list_y">176</constant>
	<constant name="list_wd">1000</constant>
	<constant name="list_row">72</constant>
	<constant name="panel_x">1160</constant>
	<constant name="panel_w">696</constant>

	<!-- Focused item art for the panel: poster (or thumb), printed -->
	<variable name="View_PanelArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
	</variable>
	<variable name="View_PanelTitle">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="View_PanelMeta">
		<value condition="ListItem.IsParentFolder">Parent folder  ·  OK goes up one level</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Artist]$INFO[ListItem.Year,  ·  ,]$INFO[ListItem.Genre,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,song)">$INFO[ListItem.Artist]$INFO[ListItem.Album,  ·  ,]$INFO[ListItem.Duration,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Genre]</value>
		<value condition="ListItem.IsFolder + String.IsEmpty(ListItem.DBType)">$INFO[ListItem.Label2]</value>
		<value>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins),  ·  , min]$INFO[ListItem.Rating,  ·  ,]$INFO[ListItem.Genre,  ·  ,]</value>
	</variable>

	<!-- ============================================================ View 50 -->
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<control type="list" id="50">
				<left>list_x</left>
				<top>list_y</top>
				<width>list_wd</width>
				<height>864</height>
				<onup>9000</onup>
				<ondown>50</ondown>
				<onleft condition="Window.IsActive(videos) | Window.IsActive(music)">ActivateWindow(1155)</onleft>  <!-- 0.9.9: Library panel -->
				<onleft>noop</onleft>
				<onright>60</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">160</scrolltime>
				<viewtype label="535">list</viewtype>
				<include content="DT_ListLayout">
					<param name="width" value="1000"/>
					<param name="height" value="72"/>
					<param name="list_id" value="50"/>
				</include>
			</control>
			<include content="DT_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1084"/>
				<param name="top" value="176"/>
				<param name="height" value="864"/>
				<param name="onleft" value="50"/>
				<param name="onright" value="$VAR[DT_Lib_ScrollRight]"/>
			</include>
			<include content="DT_RuleV">
				<param name="left" value="1112"/>
				<param name="top" value="176"/>
				<param name="height" value="864"/>
			</include>
			<include>View_FocusPanel</include>
		</control>
	</include>

	<!-- Right column: the focused item as a print (art 696x520, kept aspect, top-left), Anton title,
	     caption meta, 3-line plot. Used by list views of every window. -->
	<include name="View_FocusPanel">
		<control type="group">
			<left>panel_x</left>
			<top>176</top>
			<width>panel_w</width>
			<height>864</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>panel_w</width>
				<height>520</height>
				<aspectratio align="left" aligny="top">keep</aspectratio>
				<fadetime>120</fadetime>
				<texture background="true" colordiffuse="$VAR[SectionTint]">$VAR[View_PanelArt]</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>540</top>
				<width>panel_w</width>
				<height>80</height>
				<aligny>center</aligny>
				<font>an_72</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>![String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb)) + String.IsEmpty(ListItem.Art(fanart))]</visible>
			</control>
			<control type="textbox">
				<left>-4</left>
				<top>-16</top>
				<width>700</width>
				<height>520</height>
				<font>an_104</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<label>$VAR[View_PanelTitle]</label>
				<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb)) + String.IsEmpty(ListItem.Art(fanart))</visible>
			</control>
			<control type="label">
				<left>0</left>
				<top>632</top>
				<width>panel_w</width>
				<height>24</height>
				<font>cap_20</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<label>$VAR[View_PanelMeta]</label>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>676</top>
				<width>panel_w</width>
				<height>136</height>
				<font>body_24</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>
			</control>
		</control>
	</include>

	<!-- ===================================================== library header bar -->
	<!-- Filter / sort / view buttons, right side of the header row (ends at x 1660, before the clock).
	     params: show_watched (true in video windows) -->
	<include name="DT_LibraryHeaderBar">
		<param name="show_watched">false</param>
		<definition>
			<control type="grouplist" id="9000">
				<left>700</left>
				<top>68</top>
				<width>960</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>8</itemgap>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>50</ondown>
				<onback>50</onback>
				<include content="DT_SubNavButton">
					<param name="id" value="10"/>
					<param name="label" value="$LOCALIZE[16100]"/>
					<param name="visible" value="$PARAM[show_watched] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)]"/>
				</include>
				<include content="DT_SubNavButton">
					<param name="id" value="6053"/>
					<param name="label" value="$LOCALIZE[31010]: $INFO[Container.SortMethod]"/>
					<param name="onclick" value="SendClick(3)"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<include content="DT_SubNavButton">
					<param name="id" value="6052"/>
					<param name="label" value="$INFO[Container.SortOrder]"/>
					<param name="width" value="184"/>  <!-- 0.9.3: "DESCENDING" 156 + 28 -->
					<param name="align" value="center"/>
					<param name="onclick" value="Container.SetSortDirection"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<include content="DT_SubNavButton">
					<param name="id" value="6051"/>
					<param name="label" value="$LOCALIZE[31011]: $INFO[Container.Viewmode]"/>
					<param name="width" value="224"/>  <!-- 0.9.3: "VIEW: EPISODES" 196 + 28 -->
					<param name="align" value="center"/>
					<param name="onclick" value="Container.NextViewMode"/>
					<param name="visible" value="Integer.IsGreater(Container.ViewCount,1)"/>
				</include>
			</control>
			<!-- Kodi media-window buttons the bar clicks into (sort by / sort order) -->
			<control type="button" id="3">
				<description>Sort by (Kodi)</description>
				<include>DT_Hidden</include>
			</control>
			<control type="button" id="4">
				<description>Sort order (Kodi)</description>
				<include>DT_Hidden</include>
			</control>
		</definition>
	</include>

	<!-- Position caption "003 / 1360" (header row, x 760) -->
	<include name="DT_PositionCaption">
		<param name="left">760</param>
		<definition>
			<control type="label">
				<left>$PARAM[left]</left>
				<top>76</top>
				<width>300</width>
				<height>24</height>
				<font>cap_20</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<label>$VAR[VidView_PosPad]$INFO[Container.CurrentItem]$INFO[Container.NumItems, / ,]</label>
				<visible>Integer.IsGreater(Container.NumItems,0)</visible>
			</control>
		</definition>
	</include>

	<!-- ========================================== generic list window -->
	<!-- Background + header + filter bar + view 50. params: title -->
	<include name="DT_GenericListWindow">
		<param name="index">01</param>
		<param name="title">$VAR[LibraryTitle]</param>
		<param name="show_watched">false</param>
		<definition>
			<include>DT_Background</include>
			<include content="DT_TopBar">
				<param name="title" value="$PARAM[title]"/>
			</include>
			<include content="DT_LibraryHeaderBar">
				<param name="show_watched" value="$PARAM[show_watched]"/>
			</include>
			<include>View_50_List</include>
			<!-- empty folder / still loading -->
			<control type="label">
				<left>list_x</left>
				<top>list_y</top>
				<width>list_wd</width>
				<height>72</height>
				<font>an_48</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<label>$LOCALIZE[31012]</label>
				<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			</control>
		</definition>
	</include>
</includes>
