<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Programs / program add-ons (SPEC 5: Minimal, Misc_MediaWindow). Builder F, M4.
	Kodi id contract (Estuary Omega MyPrograms.xml): view container 50 (Groove offers only the generic
	list), menucontrol 9000, hidden sort buttons 3 / 4, add-on settings 624, get more 621.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<views>50</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the sub-nav instead (as MyVideoNav/MyMusicNav) -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<controls>
		<include>VN_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Misc_MediaWindow">
				<param name="icon" value="vn/icons/addons.png"/>
				<param name="index" value="06"/>
				<param name="title" value="$LOCALIZE[10001]"/>
				<param name="sub" value="$INFO[Container.FolderName]"/>
				<param name="extra" value="Misc_Extra_Programs"/>
			</include>
		</control>
	</controls>
</window>
