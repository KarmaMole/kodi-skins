<?xml version="1.0" encoding="UTF-8"?>
<!--
	Keepsake Search (Custom_1150_Search.xml, SPEC 5 / T16). Owner: Builder A.
	Library-only: four result rows fed by library paths filtered with ?xsp= JSON (title / album / artist
	"contains" the query). No online search, no helper add-on.
	The query is the text of edit control 9001: $INFO[Control.GetLabel(9001).index(1)]. Paths are empty
	until something is typed, so opening the window costs nothing.
	Rows never hide (a hidden container is not processed, so it could never load the next query's
	results); an empty row shows "No matches" and focus skips it (empty containers can't take focus).
	Ids: 9001 edit, 9101 movies, 9102 TV shows, 9103 albums, 9104 artists.
-->
<includes>
	<!-- ================================================================ constants -->
	<constant name="search_query_y">160</constant>
	<constant name="search_edit_y">184</constant>
	<constant name="search_edit_h">80</constant>
	<constant name="search_poster_w">100</constant>
	<constant name="search_poster_h">150</constant>
	<constant name="search_poster_pitch">120</constant>  <!-- gap 20 -->
	<constant name="search_cover_w">120</constant>
	<constant name="search_cover_pitch">140</constant>
	<constant name="search_artist_w">240</constant>
	<constant name="search_artist_h">56</constant>
	<constant name="search_artist_pitch">256</constant>
	<constant name="search_pad">22</constant>             <!-- zoom/lift/frame room inside the list clip rect -->
	<constant name="search_list_x">84</constant>          <!-- items start at 96 -->

	<!-- ================================================================ expressions -->
	<expression name="Search_HasQuery">!String.IsEmpty(Control.GetLabel(9001).index(1))</expression>

	<!-- ================================================================ paths -->
	<!-- xsp JSON, URL-encoded except the query itself. $ESCINFO quotes the query and escapes " and \ as JSON
	     expects (QA 2026-10-18). Kodi has no URL-encode infolabel, so & % + in a query still break the path. -->
	<variable name="Search_PathMovies">
		<value condition="$EXP[Search_HasQuery]">videodb://movies/titles/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[Control.GetLabel(9001).index(1)]%5D%7D%5D%7D%2C%22type%22%3A%22movies%22%7D</value>
	</variable>
	<variable name="Search_PathTV">
		<value condition="$EXP[Search_HasQuery]">videodb://tvshows/titles/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22sorttitle%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[Control.GetLabel(9001).index(1)]%5D%7D%5D%7D%2C%22type%22%3A%22tvshows%22%7D</value>
	</variable>
	<variable name="Search_PathAlbums">
		<value condition="$EXP[Search_HasQuery]">musicdb://albums/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22album%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22album%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[Control.GetLabel(9001).index(1)]%5D%7D%5D%7D%2C%22type%22%3A%22albums%22%7D</value>
	</variable>
	<variable name="Search_PathArtists">
		<value condition="$EXP[Search_HasQuery]">musicdb://artists/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22artist%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B$ESCINFO[Control.GetLabel(9001).index(1)]%5D%7D%5D%7D%2C%22type%22%3A%22artists%22%7D</value>
	</variable>

	<!-- ================================================================ pieces (Keepsake) -->
	<!-- Row header: handwritten title + count (DM Mono) + the focused item on the right. params: id, top, title, detail -->
	<include name="Search_RowHeader">
		<definition>
			<control type="group">
				<top>$PARAM[top]</top>
				<control type="grouplist">
					<left>112</left>
					<top>0</top>
					<width>1000</width>
					<height>64</height>
					<orientation>horizontal</orientation>
					<itemgap>24</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width>auto</width>
						<height>62</height>
						<font>hand_48</font>
						<textcolor>$VAR[Search_HeadColor_$PARAM[id]]</textcolor>
						<label>$PARAM[title]</label>
					</control>
					<control type="label">
						<top>22</top>
						<width>auto</width>
						<height>27</height>
						<font>lbl_20</font>
						<textcolor>label</textcolor>
						<label>$VAR[Search_Count_$PARAM[id]]</label>
					</control>
				</control>
				<control type="label">
					<left>1000</left>
					<top>22</top>
					<width>808</width>
					<height>27</height>
					<align>right</align>
					<font>lbln_20</font>
					<textcolor>label_hi</textcolor>
					<label>$PARAM[detail]</label>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- one results row of prints. params: id, top, kind (Search / SearchSq), pw, ph, pitch, list_h, path, target, art, onup, ondown -->
	<include name="Search_Row">
		<param name="art">$VAR[KS_PosterArt]</param>
		<param name="target">videos</param>
		<param name="kind">Search</param>
		<param name="pw">170</param>
		<param name="ph">245</param>
		<param name="pitch">200</param>
		<param name="list_h">300</param>
		<param name="list_w">1800</param>
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>52</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[list_w]</width>
				<height>$PARAM[list_h]</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<preloaditems>1</preloaditems>
				<onup>$PARAM[onup]</onup>
				<ondown>$PARAM[ondown]</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<itemlayout width="$PARAM[pitch]" height="$PARAM[list_h]">
					<include content="Search_Print">
						<param name="kind" value="$PARAM[kind]"/><param name="pw" value="$PARAM[pw]"/><param name="ph" value="$PARAM[ph]"/>
						<param name="art" value="$PARAM[art]"/><param name="focused" value="false"/><param name="lift" value="false"/>
					</include>
				</itemlayout>
				<focusedlayout width="$PARAM[pitch]" height="$PARAM[list_h]">
					<include content="Search_Print">
						<param name="kind" value="$PARAM[kind]"/><param name="pw" value="$PARAM[pw]"/><param name="ph" value="$PARAM[ph]"/>
						<param name="art" value="$PARAM[art]"/><param name="focused" value="true"/><param name="lift" value="Control.HasFocus($PARAM[id])"/>
					</include>
				</focusedlayout>
				<content target="$PARAM[target]" limit="30">$PARAM[path]</content>
			</control>
		</definition>
	</include>
	<include name="Search_Print">
		<definition>
			<control type="group">
				<left>30</left>
				<top>26</top>
				<width>$PARAM[pw]</width>
				<height>$PARAM[ph]</height>
				<include>KS_TiltItem</include>
				<control type="group">
					<width>$PARAM[pw]</width>
					<height>$PARAM[ph]</height>
					<include condition="$PARAM[focused]">KS_TiltFocus</include>
					<include content="KS_Print_$PARAM[kind]">
						<param name="art" value="$PARAM[art]"/>
						<param name="lift" value="$PARAM[lift]"/>
						<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
						<param name="stamped" value="Integer.IsGreater(ListItem.PlayCount,0) + !String.IsEmpty(ListItem.LastPlayed)"/>
						<param name="title" value="$INFO[ListItem.Label]"/>
					</include>
				</control>
			</control>
		</definition>
	</include>
	<include name="Search_ArtistRow">
		<definition>
			<control type="list" id="$PARAM[id]">
				<left>52</left>
				<top>$PARAM[top]</top>
				<width>1680</width>
				<height>300</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<onup>$PARAM[onup]</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<itemlayout width="240" height="300">
					<include content="Search_Print">
						<param name="kind" value="SearchSq"/><param name="pw" value="210"/><param name="ph" value="210"/>
						<param name="art" value="$VAR[KS_SquareArt]"/><param name="focused" value="false"/><param name="lift" value="false"/>
					</include>
					<control type="label">
						<left>30</left>
						<top>250</top>
						<width>220</width>
						<height>44</height>
						<font>hand_34</font>
						<textcolor>ink_faint</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="240" height="300">
					<include content="Search_Print">
						<param name="kind" value="SearchSq"/><param name="pw" value="210"/><param name="ph" value="210"/>
						<param name="art" value="$VAR[KS_SquareArt]"/><param name="focused" value="true"/><param name="lift" value="Control.HasFocus($PARAM[id])"/>
					</include>
					<control type="label">
						<left>30</left>
						<top>250</top>
						<width>220</width>
						<height>44</height>
						<font>hand_34</font>
						<textcolor>ink_bold</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
				<content target="music" limit="30">$PARAM[path]</content>
			</control>
		</definition>
	</include>

	<include name="Search_Query">
		<control type="label">
			<left>118</left>
			<top>212</top>
			<width>1000</width>
			<height>27</height>
			<font>lbl_20</font>
			<textcolor>label</textcolor>
			<label>what are you looking for?</label>
		</control>
		<control type="edit" id="9001">
			<left>112</left>
			<top>236</top>
			<width>1696</width>
			<height>90</height>
			<font>hand_66</font>
			<textcolor>ink_bold</textcolor>
			<focusedcolor>ink_bold</focusedcolor>
			<disabledcolor>label</disabledcolor>
			<textoffsetx>0</textoffsetx>
			<aligny>center</aligny>
			<label></label>
			<hinttext>a title, an album, an artist</hinttext>
			<texturefocus />
			<texturenofocus />
			<onup>noop</onup>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<ondown>9101</ondown>
		</control>
		<control type="image">
			<left>106</left>
			<top>318</top>
			<width>760</width>
			<height>22</height>
			<texture colordiffuse="$VAR[Search_PenColor]">ks/pen_line.png</texture>
		</control>
	</include>
	<variable name="Search_PenColor">
		<value condition="Control.HasFocus(9001)">ink</value>
		<value>ink_ghost</value>
	</variable>
	<variable name="Search_HeadColor_9101"><value condition="Control.HasFocus(9101)">ink_bold</value><value>ink2</value></variable>
	<variable name="Search_HeadColor_9102"><value condition="Control.HasFocus(9102)">ink_bold</value><value>ink2</value></variable>
	<variable name="Search_HeadColor_9103"><value condition="Control.HasFocus(9103)">ink_bold</value><value>ink2</value></variable>
	<variable name="Search_HeadColor_9104"><value condition="Control.HasFocus(9104)">ink_bold</value><value>ink2</value></variable>
	<variable name="Search_Count_9101"><value condition="Container(9101).IsUpdating">looking</value><value condition="Integer.IsGreater(Container(9101).NumItems,0)">$INFO[Container(9101).NumItems] found</value><value>nothing</value></variable>
	<variable name="Search_Count_9102"><value condition="Container(9102).IsUpdating">looking</value><value condition="Integer.IsGreater(Container(9102).NumItems,0)">$INFO[Container(9102).NumItems] found</value><value>nothing</value></variable>
	<variable name="Search_Count_9103"><value condition="Container(9103).IsUpdating">looking</value><value condition="Integer.IsGreater(Container(9103).NumItems,0)">$INFO[Container(9103).NumItems] found</value><value>nothing</value></variable>
	<variable name="Search_Count_9104"><value condition="Container(9104).IsUpdating">looking</value><value condition="Integer.IsGreater(Container(9104).NumItems,0)">$INFO[Container(9104).NumItems] found</value><value>nothing</value></variable>

	<!-- Results: films / series / albums / artists, stacked; the page slides up to keep the focused row on screen -->
	<include name="Search_Results">
		<control type="group">
			<visible>$EXP[Search_HasQuery]</visible>
			<include>Anim_FadeVisible</include>
			<animation effect="slide" end="0,-330" time="240" tween="cubic" easing="out" condition="[Control.HasFocus(9103)] + !Skin.HasSetting(keepsake.reducemotion)">Conditional</animation>
			<animation effect="slide" end="0,-330" time="0" tween="cubic" easing="out" condition="[Control.HasFocus(9103)] + Skin.HasSetting(keepsake.reducemotion)">Conditional</animation>
			<animation effect="slide" end="0,-640" time="240" tween="cubic" easing="out" condition="[Control.HasFocus(9104)] + !Skin.HasSetting(keepsake.reducemotion)">Conditional</animation>
			<animation effect="slide" end="0,-640" time="0" tween="cubic" easing="out" condition="[Control.HasFocus(9104)] + Skin.HasSetting(keepsake.reducemotion)">Conditional</animation>
			<include content="Search_RowHeader">
				<param name="id" value="9101"/>
				<param name="top" value="366"/>
				<param name="title" value="films"/>
				<param name="detail" value="$INFO[Container(9101).ListItem.Label]$INFO[Container(9101).ListItem.Year,  ·  ,]"/>
			</include>
			<include content="Search_Row">
				<param name="id" value="9101"/>
				<param name="top" value="420"/>
				<param name="path" value="$VAR[Search_PathMovies]"/>
				<param name="onup" value="9001"/>
				<param name="ondown" value="9102"/>
			</include>
			<include content="Search_RowHeader">
				<param name="id" value="9102"/>
				<param name="top" value="720"/>
				<param name="title" value="series"/>
				<param name="detail" value="$INFO[Container(9102).ListItem.Label]$INFO[Container(9102).ListItem.Year,  ·  ,]"/>
			</include>
			<include content="Search_Row">
				<param name="id" value="9102"/>
				<param name="top" value="774"/>
				<param name="path" value="$VAR[Search_PathTV]"/>
				<param name="onup" value="9101"/>
				<param name="ondown" value="9103"/>
			</include>
			<include content="Search_RowHeader">
				<param name="id" value="9103"/>
				<param name="top" value="1074"/>
				<param name="title" value="albums"/>
				<param name="detail" value="$INFO[Container(9103).ListItem.Label]$INFO[Container(9103).ListItem.Artist,  ·  ,]"/>
			</include>
			<include content="Search_Row">
				<param name="id" value="9103"/>
				<param name="top" value="1128"/>
				<param name="kind" value="SearchSq"/>
				<param name="pw" value="210"/>
				<param name="ph" value="210"/>
				<param name="pitch" value="240"/>
				<param name="list_h" value="270"/>
				<param name="list_w" value="1680"/>
				<param name="target" value="music"/>
				<param name="art" value="$VAR[KS_SquareArt]"/>
				<param name="path" value="$VAR[Search_PathAlbums]"/>
				<param name="onup" value="9102"/>
				<param name="ondown" value="9104"/>
			</include>
			<include content="Search_RowHeader">
				<param name="id" value="9104"/>
				<param name="top" value="1400"/>
				<param name="title" value="artists"/>
				<param name="detail" value=""/>
			</include>
			<include content="Search_ArtistRow">
				<param name="id" value="9104"/>
				<param name="top" value="1454"/>
				<param name="path" value="$VAR[Search_PathArtists]"/>
				<param name="onup" value="9103"/>
			</include>
		</control>
		<control type="textbox">
			<left>112</left>
			<top>380</top>
			<width>1200</width>
			<height>120</height>
			<font>hand_44</font>
			<textcolor>ink_faint</textcolor>
			<label>Films and series by title, albums by name, artists by name. Only what is in your library.</label>
			<visible>!$EXP[Search_HasQuery]</visible>
		</control>
	</include>
</includes>
