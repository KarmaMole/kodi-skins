<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home (docs/concepts/round4/mockups/FoldHome.html). Ids and properties: Includes_Home.xml (generated by
	_src/make_home.py).

	Focus map
	  tabs 9001-9005 (Left/Right wrap; OK opens the section's library, Search page, or the system cards)
	    Down -> row A of the section (closed cards lift and tilt on focus) -> Down -> row B (cream cards; the page
	    slides up and row A folds flat). Up retraces. Back from any row -> its tab. Back on a tab: nothing
	    (Kodi switches to the playing video if something plays).
	  OK on a film / episode / album card opens the info spread / gatefold from the card's slot.
	Default focus on open: the tab of the section that was active when Home was left.
-->
<window>
	<defaultcontrol always="true">9001</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>table</backgroundcolor>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),series)">SetFocus(9002)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),music)">SetFocus(9003)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),search)">SetFocus(9004)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),settings)">SetFocus(9005)</onload>
	<onload>ClearProperty(fold.from,home)</onload>
	<onunload>SetProperty(fold.n.films,$INFO[Container(9191).NumItems],home)</onunload>
	<onunload>SetProperty(fold.n.series,$INFO[Container(9193).NumItems],home)</onunload>
	<onunload>SetProperty(fold.n.music,$INFO[Container(9194).NumItems],home)</onunload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Fold_Background</include>
		<include>Home_Counters</include>
		<include>Home_Content</include>
		<include>Home_Tabs</include>
		<include>Fold_Clock</include>
		<include>Home_NowPlaying</include>
	</controls>
</window>
