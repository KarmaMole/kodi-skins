<?xml version="1.0" encoding="UTF-8"?>
<!--
	Library views and the generic list window (SPEC 6).
	View ids: 50 List (M1, generic fallback) | 500 Poster Showcase | 501 Big Poster | 502 Wall |
	503 Episodes | 504 Albums | 505 Big Album (M2). Every view gates itself with Container.Content.
	Header bar (grouplist 9000) replaces Estuary's side blade; uses Kodi's media-window ids
	(3 = sort by, 4 = sort order, 10 = watched filter in video windows).
-->
<includes>
	<!-- ============================================================ View 50 -->
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include content="Anim_StandUp"><param name="bottom" value="1044"/></include>
			<!-- the sheet: a cream card the rows are printed on -->
			<control type="image">
				<left>-24</left>
				<top>60</top>
				<width>1352</width>
				<height>1080</height>
				<texture border="104">fold/shadow_spread.png</texture>
			</control>
			<control type="image">
				<left>72</left>
				<top>156</top>
				<width>1160</width>
				<height>888</height>
				<texture border="6" colordiffuse="cream">fold/rr4.png</texture>
			</control>
			<control type="image">
				<left>72</left>
				<top>156</top>
				<width>1160</width>
				<height>888</height>
				<texture diffuse="fold/rr4.png">fold/tooth_cream.png</texture>
			</control>
			<control type="image">
				<left>72</left>
				<top>156</top>
				<width>1160</width>
				<height>888</height>
				<texture border="4" colordiffuse="$VAR[FoldAccentEdge]">fold/edge_all.png</texture>
			</control>
			<control type="list" id="50">
				<left>96</left>
				<top>170</top>
				<width>1084</width>
				<height>858</height>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft condition="Window.IsActive(videos) | Window.IsActive(music)">ActivateWindow(1155)</onleft>  <!-- 0.9.7: the Library panel -->
				<onleft>noop</onleft>
				<onright>60</onright>
				<onback condition="$EXP[Lib_AtRoot]">9398</onback>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<include content="Fold_ListLayout">
					<param name="width" value="1084"/>
					<param name="height" value="66"/>
					<param name="list_id" value="50"/>
				</include>
			</control>
			<include content="Fold_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1204"/>
				<param name="top" value="176"/>
				<param name="height" value="846"/>
				<param name="onleft" value="50"/>
				<param name="onright" value="9000"/>
			</include>
			<!-- focused item: art as a tipped-in plate, title, meta, plot -->
			<control type="group">
				<left>1296</left>
				<top>170</top>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>528</width>
					<height>560</height>
					<aspectratio align="left" aligny="top">keep</aspectratio>
					<fadetime>120</fadetime>
					<bordertexture border="14">fold/plate_frame.png</bordertexture>
					<bordersize>12</bordersize>
					<texture background="true">$VAR[ListItemArt]</texture>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>584</top>
					<width>528</width>
					<height>100</height>
					<font>head_40</font>
					<textcolor>ink</textcolor>
					<label>$VAR[List_Title]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>690</top>
					<width>528</width>
					<height>32</height>
					<font>caps_20</font>
					<textcolor>$VAR[FoldAccentInk]</textcolor>
					<label>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins), · , min]$INFO[ListItem.Rating, · ,]$INFO[ListItem.Genre, · ,]</label>
				</control>
				<control type="textbox" id="9371">
					<left>0</left>
					<top>732</top>
					<width>528</width>
					<height>136</height>
					<font>body_24</font>
					<textcolor>body</textcolor>
					<label>$INFO[ListItem.Plot]</label>
				</control>
				<include content="Fold_PlotEllipsis"><param name="id" value="9371"/><param name="right" value="528"/><param name="top" value="834"/><param name="pitch" value="34"/><param name="font" value="body_24"/></include>
			</control>
		</control>
	</include>
	<variable name="List_Title">
		<value condition="ListItem.IsParentFolder">Up a level</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<!-- ===================================================== library header bar -->
	<!-- Sub-nav under the top rule. params: show_watched (true in video windows) -->
	<include name="Fold_LibraryHeaderBar">
		<param name="show_watched">false</param>
		<definition>
			<control type="grouplist" id="9000">
				<left>930</left>
				<top>112</top>
				<width>900</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<itemgap>28</itemgap>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>50</ondown>
				<onback>50</onback>
				<include content="Fold_SubNavButton">
					<param name="id" value="10"/>
					<param name="label" value="$LOCALIZE[16100]"/>
					<param name="visible" value="$PARAM[show_watched] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)]"/>
				</include>
				<include content="Fold_SubNavButton">
					<param name="id" value="6053"/>
					<param name="label" value="$LOCALIZE[31010]: $INFO[Container.SortMethod]"/>
					<param name="onclick" value="SendClick(3)"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<include content="Fold_SubNavButton">
					<param name="id" value="6052"/>
					<param name="label" value="$INFO[Container.SortOrder]"/>
					<param name="onclick" value="Container.SetSortDirection"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<include content="Fold_SubNavButton">
					<param name="id" value="6051"/>
					<param name="label" value="$LOCALIZE[31011]: $INFO[Container.Viewmode]"/>
					<param name="onclick" value="Container.NextViewMode"/>
					<param name="visible" value="Integer.IsGreater(Container.ViewCount,1)"/>
				</include>
			</control>
			<!-- item count: on the crumb line, under the clock -->
			<control type="label">
				<visible>false</visible>
				<left>page_margin</left>
				<top>below_bar_top</top>
				<width>page_width</width>
				<height>subnav_h</height>
				<align>right</align>
				<font>caps_20</font>
				<textcolor>cap</textcolor>
				<label>$INFO[Container.CurrentItem]$INFO[Container.NumItems, / ,]</label>
			</control>
			<!-- Kodi media-window buttons the sub-nav clicks into (sort by / sort order) -->
			<control type="button" id="3">
				<description>Sort by (Kodi)</description>
				<include>Fold_Hidden</include>
			</control>
			<control type="button" id="4">
				<description>Sort order (Kodi)</description>
				<include>Fold_Hidden</include>
			</control>
		</definition>
	</include>

	<!-- ========================================== generic list window (Minimal treatment) -->
	<!-- Background + top bar + header bar + view 50. params: index, title -->
	<include name="Fold_GenericListWindow">
		<param name="index">01</param>
		<param name="title">$VAR[LibraryTitle]</param>
		<param name="show_watched">false</param>
		<definition>
			<include>Fold_Background</include>
			<include content="Fold_TopBar">
				<param name="index" value="$PARAM[index]"/>
				<param name="title" value="$PARAM[title]"/>
			</include>
			<include content="Fold_LibraryHeaderBar">
				<param name="show_watched" value="$PARAM[show_watched]"/>
			</include>
			<include>View_50_List</include>
			<!-- empty folder / still loading -->
			<control type="label">
				<left>page_margin</left>
				<top>list_top</top>
				<width>list_w</width>
				<height>66</height>
				<font>caps_20</font>
				<textcolor>cap</textcolor>
				<label>$LOCALIZE[31012]</label>
				<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			</control>
		</definition>
	</include>
</includes>
