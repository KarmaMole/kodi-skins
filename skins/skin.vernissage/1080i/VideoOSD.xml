<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video OSD (SPEC 11, board 08, docs/skin.vernissage/screens/VideoOSD.md). Pieces: Includes_VideoOSD.xml (GENERATED
	by _src/make_playback.py). Always Evening. The corner placard (bottom left), the progress line with the seek line 87,
	the icon row at the bottom right in rule 6 order: Play/Pause 602, Stop 603, chapters 600 / 607 (only with
	chapters), Subtitles 70046, Audio 70049, Info 70043, Settings 70048. No seek buttons (Left / Right seek).
	Focus: opens on 602 (603 when pause is unavailable); Up -> 87 (Left / Right step, Down / Back -> 602); the row's
	ends stop. Back closes the OSD (Kodi). Auto-hide: Custom_1152.
-->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<controls>
		<include>VOSD_Window</include>
	</controls>
</window>
