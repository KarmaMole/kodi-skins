<?xml version="1.0" encoding="UTF-8"?>
<!--
	Films and Series: "The collection" (SPEC 7 / 8). Everything lives in Includes_LibViews.xml (header, views, Back to
	Home) and Includes_Library.xml (Library panel + Sets row, view picker, clean confirm, all in this window).
	Kodi id contract (Estuary Omega MyVideoNav.xml / CGUIWindowVideoNav): views listed in <views>; 3 sort by / 4 sort
	order (offscreen, clicked by the header and the panel); 14 watched toggle (SendClick only); defaultcontrol 50 =
	Kodi focuses the view on show. Views 500,510,50 (screens/LibraryWindows.md); Timers.xml sets the first visit per content once.
	Focus map: Includes_LibViews.xml header comment. No window-level animation: the content group fades.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9521</menucontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<views>500,510,50</views>
	<!-- empty folder: an empty view can't take focus, so the header has it (LESSONS 4) -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9522)</onload>
	<controls>
		<include content="Lib_Window">
			<param name="is_video" value="true"/>
			<param name="kind" value="video"/>
			<param name="view_id" value="9521"/>
			<param name="opt_id" value="9522"/>
			<param name="sort_id" value="9523"/>
			<param name="order_click" value="SendClick(4)"/>
		</include>
	</controls>
</window>
