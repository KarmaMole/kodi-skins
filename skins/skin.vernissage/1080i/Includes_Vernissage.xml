<?xml version="1.0" encoding="UTF-8"?>
<!--
	Vernissage look: constants, the helper guards, the clock with its room glyph, the lit work (mat + hairline frame +
	light / shadow), grey prints, the placard card, and the shared names the forked Groove windows call (VN_Page,
	VN_Clock, VN_Rim, VN_Glow, VN_ArtParts, VN_CoverParts). Prefix VN_. Hand-written (CONVENTIONS 2).
	Design: docs/skin.vernissage/DESIGN.md. Colours: ONLY room tokens $VAR[<token>] (Includes_Rooms.xml), the statics,
	or - inside list layouts, where a colordiffuse $VAR sticks at its build-time value (LESSONS Groove M3) - a
	day_ / eve_ colour on a control gated by $EXP[VN_Day] / $EXP[VN_Dark] (the room twins; check_tokens.py checks it).
-->
<includes>
	<!-- ============================================================ constants (DESIGN 6 / 8, 1920 x 1080) -->
	<constant name="vn_margin">120</constant>            <!-- left / right margin -->
	<constant name="vn_head_y">62</constant>             <!-- top of the exhibition title box and the clock box -->
	<constant name="vn_head_h">80</constant>             <!-- exhibition title box (Fraunces 60: baseline 64 below the top) -->
	<constant name="vn_clock_y">56</constant>             <!-- clock grouplist top (glyph y 56, time centred on it; screens README 1) -->
	<constant name="vn_clock_h">40</constant>
	<constant name="vn_glyph">40</constant>              <!-- room glyph (sun / moon) beside the clock -->
	<constant name="vn_glyph_gap">14</constant>
	<constant name="vn_hair">2</constant>                <!-- the hairline frame outside the mat -->
	<constant name="vn_frame_border">3</constant>        <!-- vn/frame.png 9-slice: 2 px ring + 1 px clear buffer -->
	<constant name="vn_icon">48</constant>
	<constant name="vn_placard_gap">32</constant>        <!-- placard 32 px right of the frame (DESIGN 6) -->
	<constant name="vn_rule_w">56</constant>             <!-- the rule inside a placard -->
	<constant name="vn_rule_h">2</constant>

	<!-- ============================================================ expressions -->
	<!-- KarmaMole Skin Helper (optional, SPEC 12.0): installed + enabled + its service running. Per feature, the
	     helper also lists the feature in KarmaMole.Helper.Active (an older 1.0.x helper has no such features = absent).
	     Timers, window-level <visible> and <autoscroll> don't expand $EXP: paste the text there. HasKMEasel arrives
	     with M2's easel walls (CONVENTIONS 8): the helper's easel / new lists (KARMAMOLE_HELPER_API 10). -->
	<expression name="HasKMGreyPrints">$EXP[HasKMHelper] + String.Contains(Window(Home).Property(KarmaMole.Helper.Active),greyprints) + !String.IsEmpty(Window(Home).Property(KarmaMole.Grey.Path))</expression>
	<expression name="HasKMEasel">$EXP[HasKMHelper] + String.Contains(Window(Home).Property(KarmaMole.Helper.Active),easel)</expression>
	<expression name="HasKMHelper">System.HasAddon(script.karmamole.helper) + System.AddonIsEnabled(script.karmamole.helper) + String.IsEqual(Window(Home).Property(KarmaMole.Helper.Running),true)</expression>
	<!-- Skin settings (SETTINGS.md): Grey prints default ON (stored inverted), Reduce motion default off -->
	<expression name="VN_GreyPrints">!Skin.HasSetting(vernissage.noprints)</expression>
	<expression name="VN_RM">Skin.HasSetting(vernissage.reducemotion)</expression>

	<!-- ============================================================ the room, pages -->
	<!-- A page = the room (forked windows call VN_Page; Vernissage windows call VN_Room directly) -->
	<include name="VN_Page">
		<include>VN_Room</include>
	</include>
	<!-- The room's flat wall as an opaque texture (for diffuse-masked scrims made of the ground itself, LESSONS Orbit) -->

	<!-- ============================================================ the clock (DESIGN 8: top right, y 62, room glyph 14 px left) -->
	<!-- Time in lowercase region format ("9:40 pm"). The glyph: sun in steps 0-1, moon from step 2 (SPEC 5). A
	     right-aligned grouplist keeps the glyph 14 px from the time whatever its width. -->
	<include name="VN_Clock">
		<control type="grouplist">
			<right>vn_margin</right>
			<top>vn_clock_y</top>
			<width>400</width>
			<height>vn_clock_h</height>
			<orientation>horizontal</orientation>
			<align>right</align>
			<itemgap>vn_glyph_gap</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<visible>!Window.IsVisible(fullscreenvideo) | Window.IsVisible(videoosd)</visible>
			<control type="image" id="9091">
				<width>vn_glyph</width>
				<height>vn_glyph</height>
				<texture colordiffuse="$VAR[ink2]">vn/icons/sun.png</texture>
				<visible>$EXP[VN_Day]</visible>
			</control>
			<control type="image" id="9092">
				<width>vn_glyph</width>
				<height>vn_glyph</height>
				<texture colordiffuse="$VAR[ink2]">vn/icons/moon.png</texture>
				<visible>$EXP[VN_Dark]</visible>
			</control>
			<control type="label" id="9093">
				<width max="300">auto</width>
				<height>vn_clock_h</height>
				<aligny>center</aligny>
				<font>font_clock</font>
				<textcolor>$VAR[ink]</textcolor>
				<label>[LOWERCASE]$INFO[System.Time][/LOWERCASE]</label>
			</control>
		</control>
	</include>

	<!-- ============================================================ the work -->
	<!-- The lit work, OUTSIDE list layouts (live $VAR tints): Day shadow, hairline frame, mat, the art, the mat's
	     falloff. Placed in a group at the FRAME's outer rect. params: width / height = the frame's outer size,
	     mat (px), art, aspect. The spotlight pool is window-level (VN_Pool), never inside a container (LESSONS
	     Groove M3: containers clip their layouts). -->
	<include name="VN_LitWork">
		<param name="aspect">scale</param>
		<param name="mat">14</param>
		<definition>
			<!-- Day shadow, 6 px right / 14 px down of the frame (DESIGN 5), 9-slice border 56 -->
			<control type="image">
				<left>-50</left>
				<top>-42</top>
				<width>$PARAM[shadow_w]</width>
				<height>$PARAM[shadow_h]</height>
				<texture border="56" colordiffuse="$VAR[shadow]">vn/shadow.png</texture>
				<include>VN_ShadowSteps</include>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture colordiffuse="$VAR[frame]">vn/white.png</texture>
			</control>
			<control type="image">
				<left>vn_hair</left>
				<top>vn_hair</top>
				<right>vn_hair</right>
				<bottom>vn_hair</bottom>
				<texture colordiffuse="$VAR[mat]">vn/white.png</texture>
			</control>
			<control type="image">
				<left>$PARAM[art_x]</left>
				<top>$PARAM[art_x]</top>
				<right>$PARAM[art_x]</right>
				<bottom>$PARAM[art_x]</bottom>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true">$PARAM[art]</texture>
			</control>
			<control type="image">
				<left>vn_hair</left>
				<top>vn_hair</top>
				<right>vn_hair</right>
				<bottom>vn_hair</bottom>
				<texture>vn/mat_falloff.png</texture>
				<visible>$EXP[VN_Dark]</visible>
			</control>
		</definition>
	</include>

	<!-- The spotlight pool (Evening light, DESIGN 5): about 2.05 x the frame's width and 1.5 x its height, centre 3 %
	     above the frame's centre. params: left, top, width, height (the pool rect, window coordinates), visible. -->
	<include name="VN_Pool">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture colordiffuse="$VAR[spot]">vn/spot.png</texture>
				<visible>$PARAM[visible]</visible>
				<include>VN_SpotSteps</include>
			</control>
		</definition>
	</include>


	<!-- The art-coloured light (SPEC 12.0, helper feature `colours`): a second pool over the warm one, tinted with the
	     focused art's colour (Groove.Color.Main, the helper steps it over 400 ms) at 30 %, the warm one under it at
	     70 %. Off with "Art-coloured spotlight" (vernissage.warmspot) or without the helper. params: the pool rect.
	     VN_ArtSpotPlayer: the same for the playing album (Groove.Player.Color.Main, the listening room). -->
	<expression name="VN_ArtSpotOn">$EXP[HasKMHelper] + String.Contains(Window(Home).Property(KarmaMole.Helper.Active),colours) + !Skin.HasSetting(vernissage.warmspot)</expression>
	<include name="VN_ArtSpot">
		<definition>
			<control type="group">
				<visible>$EXP[VN_ArtSpotOn] + !String.IsEmpty(Window(Home).Property(Groove.Color.Main))</visible>
				<animation effect="fade" start="100" end="30" time="0" condition="true">Conditional</animation>
				<control type="image">
					<left>$PARAM[left]</left>
					<top>$PARAM[top]</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture colordiffuse="$INFO[Window(Home).Property(Groove.Color.Main)]">vn/spot.png</texture>
					<include>VN_SpotSteps</include>
				</control>
			</control>
		</definition>
	</include>
	<include name="VN_ArtSpotPlayer">
		<definition>
			<control type="group">
				<visible>$EXP[VN_ArtSpotOn] + !String.IsEmpty(Window(Home).Property(Groove.Player.Color.Main))</visible>
				<animation effect="fade" start="100" end="30" time="0" condition="true">Conditional</animation>
				<control type="image">
					<left>$PARAM[left]</left>
					<top>$PARAM[top]</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture colordiffuse="$INFO[Window(Home).Property(Groove.Player.Color.Main)]">vn/spot.png</texture>
					<include>VN_SpotSteps</include>
				</control>
			</control>
		</definition>
	</include>

	<!-- Inside list layouts the room twins (day_ / eve_ images gated VN_Day / VN_Dark), grey prints, ghosts and lit
	     works: Home and the library views get them from the generators (_src/vnxml.py: print_layers, lit_layers,
	     twin_img); the includes below serve the hand-built / other generated windows (Search). -->
	<!-- A print inside an <itemlayout> (DESIGN 6, SPEC 12.1). params: left / top / width / height, art, grey
	     (<kind>/<dbid>.jpg), has_grey (condition: the item has a print of that kind), aspect. -->
	<include name="VN_PrintInLayout">
		<param name="aspect">scale</param>
		<param name="grey">none.jpg</param>
		<param name="has_grey">false</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<texture background="true" fallback="vn/print_blank.png">$INFO[Window(Home).Property(KarmaMole.Grey.Path)]day/$PARAM[grey]</texture>
				<visible>$EXP[VN_GreyPrints] + $EXP[HasKMGreyPrints] + [$PARAM[has_grey]] + $EXP[VN_Day]</visible>
			</control>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<texture background="true" fallback="vn/print_blank.png">$INFO[Window(Home).Property(KarmaMole.Grey.Path)]evening/$PARAM[grey]</texture>
				<visible>$EXP[VN_GreyPrints] + $EXP[HasKMGreyPrints] + [$PARAM[has_grey]] + $EXP[VN_Dark]</visible>
			</control>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<texture background="true" colordiffuse="day_ghost_tint">$PARAM[art]</texture>
				<visible>$EXP[VN_GreyPrints] + ![$EXP[HasKMGreyPrints] + [$PARAM[has_grey]]] + $EXP[VN_Day]</visible>
			</control>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<texture background="true" colordiffuse="eve_ghost_tint">$PARAM[art]</texture>
				<visible>$EXP[VN_GreyPrints] + ![$EXP[HasKMGreyPrints] + [$PARAM[has_grey]]] + $EXP[VN_Dark]</visible>
			</control>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<texture background="true">$PARAM[art]</texture>
				<visible>!$EXP[VN_GreyPrints]</visible>
			</control>
		</definition>
	</include>
	<!-- The seen dot (DESIGN 6): 14 px ink dot in a 20 px wall ring, only on watched works. params: x, y -->
	<include name="VN_SeenDotInLayout">
		<control type="group">
			<left>$PARAM[x]</left>
			<top>$PARAM[y]</top>
			<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
			<control type="image">
				<width>20</width>
				<height>20</height>
				<texture colordiffuse="day_wall">vn/dot.png</texture>
				<visible>$EXP[VN_Day]</visible>
			</control>
			<control type="image">
				<width>20</width>
				<height>20</height>
				<texture colordiffuse="eve_wall">vn/dot.png</texture>
				<visible>$EXP[VN_Dark]</visible>
			</control>
			<control type="image">
				<left>3</left>
				<top>3</top>
				<width>14</width>
				<height>14</height>
				<texture colordiffuse="day_ink">vn/dot.png</texture>
				<visible>$EXP[VN_Day]</visible>
			</control>
			<control type="image">
				<left>3</left>
				<top>3</top>
				<width>14</width>
				<height>14</height>
				<texture colordiffuse="eve_ink">vn/dot.png</texture>
				<visible>$EXP[VN_Dark]</visible>
			</control>
		</control>
	</include>
	<!-- The lit work inside a focused layout: hairline frame + mat (room twins) + the colour art. Placed at the
	     FRAME's outer rect (left / top / width / height); art_x = mat + 2. -->
	<include name="VN_LitInLayout">
		<param name="aspect">scale</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture colordiffuse="day_frame">vn/white.png</texture>
					<visible>$EXP[VN_Day]</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture colordiffuse="eve_frame">vn/white.png</texture>
					<visible>$EXP[VN_Dark]</visible>
				</control>
				<control type="image">
					<left>vn_hair</left>
					<top>vn_hair</top>
					<right>vn_hair</right>
					<bottom>vn_hair</bottom>
					<texture colordiffuse="day_mat">vn/white.png</texture>
					<visible>$EXP[VN_Day]</visible>
				</control>
				<control type="image">
					<left>vn_hair</left>
					<top>vn_hair</top>
					<right>vn_hair</right>
					<bottom>vn_hair</bottom>
					<texture colordiffuse="eve_mat">vn/white.png</texture>
					<visible>$EXP[VN_Dark]</visible>
				</control>
				<control type="image">
					<left>$PARAM[art_x]</left>
					<top>$PARAM[art_x]</top>
					<right>$PARAM[art_x]</right>
					<bottom>$PARAM[art_x]</bottom>
					<aspectratio>$PARAM[aspect]</aspectratio>
					<texture background="true">$PARAM[art]</texture>
				</control>
			</control>
		</definition>
	</include>

	<!-- The placard card (DESIGN 6): a square card ground with a 1 px edge. Placed in a group at the placard rect;
	     params: width, height. The placard is exactly as tall as the work it labels: give it the frame's top + 2 and
	     the frame's height - 4 (the same constants as the work), content in a top group and a bottom group. -->
	<include name="VN_PlacardCard">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<texture colordiffuse="$VAR[card]">vn/white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<texture border="4" colordiffuse="$VAR[card_edge]">vn/card_edge.png</texture>
		</control>
	</include>


	<!-- ============================================================ Now playing (SPEC 6.5, screens README 1) -->
	<!-- A one-line card under the clock while audio plays: "Now playing · Morning · Beck". Static (nothing spins).
	     Right edge 1800, y 130 (below the library header words), h 52, auto width (min 200, max $PARAM[maxw]: a focused
	     button scrolls a label wider than itself, so the box is generous). The card's fill is a disabled twin of the
	     same auto width in a second right-aligned grouplist (it draws texturenofocus, LESSONS Passe-partout 0.9.2), so
	     fill and edge always match the label. OK = the listening room. params: maxw, nav (an include with the
	     onup / ondown / onback actions; Left / Right go on the grouplist and stop there). -->
	<variable name="VN_NowPlayingLabel">
		<value>[COLOR $VAR[ink2]]$LOCALIZE[31459]  ·  [/COLOR]$INFO[MusicPlayer.Title]$INFO[MusicPlayer.Artist,  ·  ,]</value>
	</variable>
	<!-- Search (Custom_1150): the card sits above the query 9001 -->
	<include name="Search_NowPlayingNav">
		<ondown>9001</ondown>
		<onback>9001</onback>
	</include>
	<include name="VN_NowPlaying">
		<param name="maxw">560</param>
		<definition>
			<control type="group">
				<visible>Player.HasAudio</visible>
				<control type="grouplist">
					<right>vn_margin</right>
					<top>130</top>
					<width>$PARAM[maxw]</width>
					<height>52</height>
					<orientation>horizontal</orientation>
					<align>right</align>
					<control type="button" id="9951">
						<width min="200" max="$PARAM[maxw]">auto</width>
						<height>52</height>
						<font>font_small</font>
						<textoffsetx>18</textoffsetx>
						<aligny>center</aligny>
						<textcolor>clear</textcolor>
						<disabledcolor>clear</disabledcolor>
						<texturenofocus colordiffuse="$VAR[card]">vn/white.png</texturenofocus>
						<texturefocus />
						<label>$VAR[VN_NowPlayingLabel]</label>
						<enable>false</enable>
					</control>
				</control>
				<control type="grouplist">
					<right>vn_margin</right>
					<top>130</top>
					<width>$PARAM[maxw]</width>
					<height>52</height>
					<orientation>horizontal</orientation>
					<align>right</align>
					<onleft>9950</onleft>
					<onright>9950</onright>
					<control type="button" id="9950">
						<width min="200" max="$PARAM[maxw]">auto</width>
						<height>52</height>
						<font>font_small</font>
						<textoffsetx>18</textoffsetx>
						<aligny>center</aligny>
						<textcolor>$VAR[ink]</textcolor>
						<focusedcolor>$VAR[ink]</focusedcolor>
						<texturenofocus border="4" colordiffuse="$VAR[card_edge]">vn/card_edge.png</texturenofocus>
						<texturefocus border="3" colordiffuse="$VAR[ink]">vn/frame.png</texturefocus>
						<label>$VAR[VN_NowPlayingLabel]</label>
						<onclick>ActivateWindow(visualisation)</onclick>
						<include content="$PARAM[nav]"/>
					</control>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================ names the forked windows call -->
	<!-- The focus rim on a lit cover (forked info / views): the hairline frame in ink. Inside the art group. -->
	<include name="VN_Rim">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>-4</left>
				<top>-4</top>
				<right>-4</right>
				<bottom>-4</bottom>
				<texture border="3" colordiffuse="$VAR[ink]">vn/frame.png</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- Groove's glow behind a lit item becomes Vernissage's spotlight pool (halo rect); the wash params are unused. -->
	<!-- Art with a fallback block + title and, when lit, the rim. Inside a group at the art rect.
	     params: art, lit, label, aspect, noart -->
	<include name="VN_ArtParts">
		<param name="lit">false</param>
		<param name="label"></param>
		<param name="aspect">scale</param>
		<param name="noart">true</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="$VAR[card]">vn/white.png</texture>
				<visible>$PARAM[noart]</visible>
			</control>
			<control type="label">
				<left>12</left>
				<right>12</right>
				<top>12</top>
				<bottom>12</bottom>
				<align>center</align>
				<aligny>center</aligny>
				<wrapmultiline>true</wrapmultiline>
				<font>font_small</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$PARAM[label]</label>
				<visible>$PARAM[noart]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true">$PARAM[art]</texture>
			</control>
			<include content="VN_Rim">
				<param name="visible" value="$PARAM[lit]"/>
			</include>
		</definition>
	</include>
	<include name="VN_CoverParts">
		<param name="lit">false</param>
		<param name="label"></param>
		<definition>
			<include content="VN_ArtParts">
				<param name="art" value="$PARAM[art]"/>
				<param name="lit" value="$PARAM[lit]"/>
				<param name="label" value="$PARAM[label]"/>
			</include>
		</definition>
	</include>
</includes>
