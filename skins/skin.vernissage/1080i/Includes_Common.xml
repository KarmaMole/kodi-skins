<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Common building blocks: page background, top-bar furniture, focus frames, posters,
	watched markers, buttons. Prefix: VN_. Parameterised includes document their params.
-->
<includes>
	<!-- ============================================================ page -->

	<!-- Flat page background (bg). Use as the first control of every full-screen window. -->

	<!-- 1px horizontal rule. params: top, left (default page margin), width (default page width), color -->
	<include name="VN_Rule">
		<param name="top">0</param>
		<param name="left">page_margin</param>
		<param name="width">page_width</param>
		<param name="color">$VAR[ColorRule]</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>rule_h</height>
				<texture colordiffuse="$PARAM[color]">common/hairline.png</texture>
			</control>
		</definition>
	</include>

	<!-- Header rule at the bottom of the 120px top bar -->
	<include name="VN_TopRule">
		<description>the cornice carries its own shadow line</description>
	</include>

	<!-- The page band of every "shared page" window (SPEC 19; screens/LibraryWindows.md header, screens/README 1): the
	     exhibition title in the serif (font_exhibit, ink, auto width max 900, ellipsis) and, on the same line, the
	     sub-line in font_body ink2 (child top 22, auto width max 560), the clock top right. Content starts at y 136
	     (sub-nav words) / 168-190 (lists). One serif title per screen (SPEC 2.2).
	     params: title, sub; icon and index are accepted from forked callers and not drawn (Vernissage pages have no
	     header icon). -->
	<include name="VN_TopBar">
		<param name="index"></param>
		<param name="title"></param>
		<param name="sub"></param>
		<param name="icon"></param>
		<definition>
			<control type="grouplist">
				<left>116</left>
				<top>58</top>
				<width>1500</width>
				<height>66</height>
				<orientation>horizontal</orientation>
				<itemgap>40</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="900">auto</width>
					<height>66</height>
					<aligny>center</aligny>
					<font>font_exhibit</font>
					<textcolor>$VAR[ink]</textcolor>
					<label>$PARAM[title]</label>
				</control>
				<control type="label">
					<top>22</top>
					<width max="560">auto</width>
					<height>41</height>
					<aligny>center</aligny>
					<font>font_body</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$PARAM[sub]</label>
				</control>
			</control>
			<include>VN_Clock</include>
		</definition>
	</include>

	<!-- ===================================================== focus frames -->
	<!-- Same, but never hidden by the "Off" setting (buttons, menus, dialogs) -->
	<include name="VN_FocusFrameAlways">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="16" colordiffuse="$VAR[ink]">$VAR[FocusFrameAlways]</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ========================================================== buttons -->
	<!-- Primary OSD button textures (forked OSD family, M3 lane): kept as they are -->
	<include name="VN_Tex_ButtonPrimary">
		<texturefocus border="30,0,30,0" colordiffuse="$VAR[focus_fill]">fork/rail_on.png</texturefocus>
		<texturenofocus border="26,0,26,0" colordiffuse="$VAR[placard_rule]">fork/plaque_dim.png</texturenofocus>
	</include>
	<include name="VN_Tex_ButtonPrimary_Round">
		<texturefocus border="10" colordiffuse="$VAR[ink]">common/rect_round8.png</texturefocus>
		<texturenofocus border="10" colordiffuse="$VAR[ink]">common/rect_round8.png</texturenofocus>
	</include>

	<!-- Secondary text button (subtitle / bookmark dialogs): the card kit's button (Includes_Dialogs Dlg_Tex_DialogButton:
	     1 px card_edge outline at rest, 2 px ink ring + ink text on focus). -->
	<!-- params: id, label, left, top, width, visible, onclick, onclick2, onup / ondown / onleft / onright (default noop:
	     these buttons sit in plain groups, where an empty direction does nothing either), onleft_if / onleft_then,
	     onright_if / onright_then. No onback: Back closes the dialog (Kodi). -->
	<include name="VN_ButtonSecondary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="focus_also">false</param>
		<param name="onclick2">noop</param>
		<param name="onup">noop</param>
		<param name="ondown">noop</param>
		<param name="onleft">noop</param>
		<param name="onleft_if">false</param>
		<param name="onleft_then">noop</param>
		<param name="onright">noop</param>
		<param name="onright_if">false</param>
		<param name="onright_then">noop</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>font_small</font>
					<textcolor>$VAR[ink2]</textcolor>
					<focusedcolor>$VAR[ink]</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>8</textoffsetx>
					<include>Dlg_Tex_DialogButton</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft condition="$PARAM[onleft_if]">$PARAM[onleft_then]</onleft>
					<onleft>$PARAM[onleft]</onleft>
					<onright condition="$PARAM[onright_if]">$PARAM[onright_then]</onright>
					<onright>$PARAM[onright]</onright>
				</control>
			</control>
		</definition>
	</include>

	<!-- Mono sub-nav button (library header bar, OSD text buttons): accent fill + ink on focus.
	     params: id, label, onclick, visible -->
	<include name="VN_SubNavButton">
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>subnav_h</height>
				<font>font_label</font>
				<aligny>center</aligny>
				<textcolor>$VAR[ink2]</textcolor>
				<focusedcolor>$VAR[ink]</focusedcolor>
				<textoffsetx>20</textoffsetx>
				<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
				<texturenofocus />
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Off-screen object (template/hidden controls Kodi needs but the user never sees) -->
	<include name="VN_Hidden">
		<left>offscreen</left>
		<top>offscreen</top>
		<width>1</width>
		<height>1</height>
		<texturefocus />
		<texturenofocus />
	</include>
</includes>
