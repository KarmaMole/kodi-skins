<?xml version="1.0" encoding="UTF-8"?>
<!--
	Orbit view picker (custom dialog 1161; docs/requests/library-panel/BRIEF.md). Opened by the VIEW
	pill of the option bar and View in the Library panel. One schematic preview per view valid for the
	content underneath (the views' own Container.Content conditions), its name and an amber dot +
	"current" under the view on screen. OK = Container.SetViewMode(id), closes, focus back on the view;
	Back closes with no change. Previews: media/views/ (_src/make_view_previews.py). Opens on the
	current view: SetFocus(100,k,absolute), k = its place among the views valid here (generated table).
	The panel centres itself on the number of cards (Container(100).NumItems counts visible items).
	GENERATED by _src/make_library_panel.py.
-->
<window type="dialog" id="1161">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<onload>SetFocus(100,0,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,$LOCALIZE[31313]) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(100,1,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,$LOCALIZE[31314]) + [Container.Content(episodes) | Container.Content(seasons)] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(100,2,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,$LOCALIZE[535]) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + [Container.Content(episodes) | Container.Content(seasons)]">SetFocus(100,3,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,$LOCALIZE[535]) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + ![Container.Content(episodes) | Container.Content(seasons)]">SetFocus(100,2,absolute)</onload>
	<onload condition="Window.IsActive(videos) + String.IsEqual(Container.Viewmode,$LOCALIZE[535]) + ![Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + [Container.Content(episodes) | Container.Content(seasons)]">SetFocus(100,1,absolute)</onload>
	<onload condition="Window.IsActive(music) + String.IsEqual(Container.Viewmode,$LOCALIZE[31313]) + [Container.Content(albums) | Container.Content(artists) | Container.Content(genres)] + [Container.Content(albums) | Container.Content(artists)]">SetFocus(100,1,absolute)</onload>
	<onload condition="Window.IsActive(music) + String.IsEqual(Container.Viewmode,$LOCALIZE[535]) + [Container.Content(albums) | Container.Content(artists)] + [Container.Content(albums) | Container.Content(artists) | Container.Content(genres)]">SetFocus(100,2,absolute)</onload>
	<onload condition="Window.IsActive(music) + String.IsEqual(Container.Viewmode,$LOCALIZE[535]) + [Container.Content(albums) | Container.Content(artists)] + ![Container.Content(albums) | Container.Content(artists) | Container.Content(genres)]">SetFocus(100,1,absolute)</onload>
	<onload condition="Window.IsActive(music) + String.IsEqual(Container.Viewmode,$LOCALIZE[535]) + ![Container.Content(albums) | Container.Content(artists)] + [Container.Content(albums) | Container.Content(artists) | Container.Content(genres)]">SetFocus(100,1,absolute)</onload>
	<controls>
		<control type="image">
			<description>backdrop dim</description>
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="dim_dialog">common/white.png</texture>
		</control>
		<control type="group">
			<left>180</left>
			<top>344</top>
			<width>1560</width>
			<height>392</height>
			<animation effect="slide" end="570,0" time="0" condition="Integer.IsEqual(Container(100).NumItems,1)">Conditional</animation>
			<animation effect="slide" end="380,0" time="0" condition="Integer.IsEqual(Container(100).NumItems,2)">Conditional</animation>
			<animation effect="slide" end="190,0" time="0" condition="Integer.IsEqual(Container(100).NumItems,3)">Conditional</animation>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>420</width>
				<height>392</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,1)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>800</width>
				<height>392</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,2)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1180</width>
				<height>392</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,3)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1560</width>
				<height>392</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,4)</visible>
			</control>
			<control type="label">
				<left>24</left>
				<top>0</top>
				<width>600</width>
				<height>56</height>
				<font>mono_13</font>
				<textcolor>accent</textcolor>
				<label>View  ·  $VAR[LibPanel_Where]</label>
			</control>
			<control type="list" id="100">
				<left>20</left>
				<top>56</top>
				<width>1520</width>
				<height>320</height>
				<orientation>horizontal</orientation>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<scrolltime tween="cubic" easing="out">160</scrolltime>
				<itemlayout width="380" height="320">
					<include>Pick_Item</include>
				</itemlayout>
				<focusedlayout width="380" height="320">
					<include content="Pick_Item"><param name="focused" value="true"/></include>
				</focusedlayout>
				<content>
				<item>
					<label>$LOCALIZE[31312]</label>
					<label2>$VAR[Pick_Cur_Arc]</label2>
					<icon>views/arc.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(500)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]</visible>
				</item>
				<item>
					<label>$LOCALIZE[31313]</label>
					<label2>$VAR[Pick_Cur_Grid]</label2>
					<icon>views/grid.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(501)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]</visible>
				</item>
				<item>
					<label>$LOCALIZE[31314]</label>
					<label2>$VAR[Pick_Cur_Episodes]</label2>
					<icon>views/episodes.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(502)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos) + [Container.Content(episodes) | Container.Content(seasons)]</visible>
				</item>
				<item>
					<label>$LOCALIZE[31315]</label>
					<label2>$VAR[Pick_Cur_List]</label2>
					<icon>views/list.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(50)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(videos)</visible>
				</item>
				<item>
					<label>$LOCALIZE[31312]</label>
					<label2>$VAR[Pick_Cur_Arc]</label2>
					<icon>views/music_arc.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(504)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(music) + [Container.Content(albums) | Container.Content(artists)]</visible>
				</item>
				<item>
					<label>$LOCALIZE[31313]</label>
					<label2>$VAR[Pick_Cur_Grid]</label2>
					<icon>views/music_grid.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(505)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(music) + [Container.Content(albums) | Container.Content(artists) | Container.Content(genres)]</visible>
				</item>
				<item>
					<label>$LOCALIZE[31315]</label>
					<label2>$VAR[Pick_Cur_List]</label2>
					<icon>views/music_list.png</icon>
					<onclick>Dialog.Close(1161,true)</onclick>
					<onclick>Container.SetViewMode(50)</onclick>
					<onclick>SetFocus(50)</onclick>
					<visible>Window.IsActive(music)</visible>
				</item>
				</content>
			</control>
		</control>
	</controls>
</window>
