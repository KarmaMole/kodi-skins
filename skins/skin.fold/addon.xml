<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.fold" version="0.9.10" name="Fold" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required: Skin Variables URL-encodes the search query (Includes_Search.xml, Search_Encoder). -->
		<import addon="script.skinvariables" version="2.1.21"/>
		<!-- Optional: next-aired details. The skin runs without it. -->
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Fold - everything unfolds.</summary>
		<description lang="en_GB">Your library as coloured card on a light table. Films are closed cards that swing open into a three-panel spread, seasons pull out like a concertina, albums open like a gatefold sleeve and the player controls fold up from the bottom edge. Built for the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#fold</website>
		<news>v0.9.10 - Settings: choose which main menu items to show. Home: up to three custom rows from any add-on, playlist or favourite.</news>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
