<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Yes/No, OK and progress dialogs (Kodi 21 routes all three through DialogConfirm) - M4, Builder E.
	Used by "Keep this skin?" - must always work. Like Estuary there is no <defaultcontrol>: Kodi
	focuses its own default button (yes or no, per caller).
	Id contract (Estuary Omega): heading 1, text 9, progress 20, buttons 11 (yes) / 10 (no) /
	12 (custom) in grouplist 9000, Estuary order 11, 10, 12. Kodi hides the unused ones.
-->
<window>
	<controls>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_DialogCard</include>
			<control type="group">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>960</width>
				<height>420</height>
				<include content="VN_GenericDialog">
					<param name="width" value="960"/>
					<param name="height" value="420"/>
					<param name="header_id" value="1"/>
				</include>
				<control type="textbox" id="9">
					<left>dialog_pad</left>
					<top>dialog_content_top</top>
					<width>880</width>
					<height>164</height>  <!-- 4 lines of font_body (pitch 41): no half-clipped line at the bottom -->
					<font>font_body</font>
					<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
				</control>
				<control type="progress" id="20">
					<left>dialog_pad</left>
					<top>300</top>
					<width>880</width>
					<height>2</height>
					<info>System.Progressbar</info>
				</control>
				<control type="grouplist" id="9000">
					<left>dialog_pad</left>
					<top>328</top>
					<width>880</width>
					<height>dialog_row_h</height>
					<orientation>horizontal</orientation>
					<align>right</align>
					<itemgap>16</itemgap>
					<onleft>9000</onleft>
					<onright>9000</onright>
					<onup>noop</onup>
					<ondown>noop</ondown>
					<include content="VN_DialogButton">
						<param name="id" value="11"/>
						<param name="width" value="240"/>
					</include>
					<include content="VN_DialogButton">
						<param name="id" value="10"/>
						<param name="width" value="240"/>
					</include>
					<include content="VN_DialogButton">
						<param name="id" value="12"/>
						<param name="width" value="240"/>
					</include>
				</control>
			</control>
		</control>
	</controls>
</window>
