<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Startup: black page + wordmark for the instant before Home. No splash timer.
	Goes to Kodi's configured startup window (default Home), like Estuary, so Omar's
	"Settings > Interface > Startup window" keeps working.
-->
<window>
	<!-- Vernissage: Home's first visit opens on Tonight even if Kodi focuses the rail before the wall fills
	     (Timers.xml vn_home_first) -->
	<onload>SetProperty(vn.home.first,yes,home)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls>
		<include>VN_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<control type="label">
				<left>page_margin</left>
				<top>460</top>
				<width>page_width</width>
				<height>140</height>
				<font>font_exhibit</font>
				<label>$LOCALIZE[31024]</label>
			</control>
		</control>
	</controls>
</window>
