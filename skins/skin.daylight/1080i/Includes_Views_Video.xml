<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library (mockup DaylightFilms): detail panel on the left, a soft card on the right with the
	grid / list. Used by MyVideoNav.xml; shared label variables are also used by DialogVideoInfo.

	View ids (each gates itself with Container.Content so VIEW only cycles valid views):
	  500 Grid + detail (movies, sets, tvshows, seasons, music videos)   184x276 posters, 5 columns
	  501 Wall (same content, no detail panel, 8 columns)
	  503 Episodes (episodes)                                              thumb rows in the card
	  50  List (everything: files, add-ons, genres, years ...)             rows in the card

	Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav): views listed in <views>;
	3 sort-by / 4 sort-order (hidden, clicked by the header pills); 14 watched toggle (SendClick).
	Daylight ids: 9400 nav pills group (9401 For now ... 9406 system menu, 9407 Options = Library panel 1160),
	9000 card header pills
	(menucontrol): 9322 Unwatched toggle, 9323 In progress (TV root), 9324 Sort, 9325 order, 9326 View (9327 in episodes, wider).

	Focus map: nav 9400 -Down-> header pills 9000 -Down-> view. View -Up (top row)-> 9000 -Up-> 9400.
	0.9.8: Library panel 1160 = Left / Right past the edges of any view, past either end of the pills,
	or Options (9407, top line). View pills 9326 / 9327 open the view picker 1161.
	Back = Kodi parent folder; Back on the pills returns to the view.
	Borrowed colour: TMDb Helper reads the focused item of the media window (ListItem prefix).
-->
<includes>
	<!-- ================================================================== constants -->
	<constant name="vv_top">168</constant>
	<constant name="vv_panel_w">500</constant>
	<constant name="vv_card_x">680</constant>
	<constant name="vv_card_w">1120</constant>
	<constant name="vv_card_h">848</constant>
	<constant name="vv_grid_x">702</constant>       <!-- card x + 40 - 18 pad -->
	<constant name="vv_grid_y">262</constant>       <!-- card y + 112 - 18 pad -->
	<constant name="vv_grid_w">1070</constant>      <!-- 5 x 214 -->
	<constant name="vv_grid_h">754</constant>       <!-- to the card bottom (1016) -->

	<!-- ================================================================== expressions -->
	<expression name="VidView_IsInProgressTV">String.StartsWith(Container.FolderPath,videodb://inprogresstvshows)</expression>
	<expression name="VidView_IsMoviesRoot">Container.Content(movies) + String.StartsWith(Container.FolderPath,videodb://movies/titles)</expression>
	<expression name="VidView_IsTVRoot">Container.Content(tvshows) + String.StartsWith(Container.FolderPath,videodb://tvshows/titles)</expression>
	<expression name="VidView_IsLibraryVideo">Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)</expression>
	<expression name="VidView_IsFilmsPage">Container.Content(movies) | Container.Content(sets) | String.StartsWith(Container.FolderPath,videodb://movies)</expression>
	<expression name="VidView_IsShowsPage">Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | String.StartsWith(Container.FolderPath,videodb://tvshows) | $EXP[VidView_IsInProgressTV]</expression>
	<expression name="VidView_IsFolderType">String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)</expression>
	<expression name="VidView_IsTVType">String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)</expression>
	<expression name="VidView_HasRating">!String.IsEmpty(ListItem.Rating) + !String.IsEqual(ListItem.Rating,0.0) + !String.IsEqual(ListItem.Rating,0)</expression>
	<expression name="VidView_TVDone">Integer.IsEqual(ListItem.Property(UnWatchedEpisodes),0) + Integer.IsGreater(ListItem.Property(TotalEpisodes),0)</expression>
	<expression name="VidView_SetDone">String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Total)) + String.IsEqual(ListItem.Property(Watched),ListItem.Property(Total))</expression>
	<expression name="VidView_IsPlayable">String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)</expression>
	<expression name="VidView_DetailOn">!Control.IsVisible(501) + Integer.IsGreater(Container.NumItems,0)</expression>

	<!-- ================================================================== variables -->
	<variable name="VidView_Title">
		<value condition="$EXP[VidView_IsMoviesRoot]">Films</value>
		<value condition="$EXP[VidView_IsTVRoot]">Shows</value>
		<value condition="$EXP[VidView_IsInProgressTV]">Shows in progress</value>
		<value condition="Container.Content(seasons) + !String.IsEmpty(Container.ListItem.TVShowTitle)">$INFO[Container.ListItem.TVShowTitle]</value>
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value>$LOCALIZE[3]</value>
	</variable>
	<variable name="VidView_Caption">
		<value condition="$EXP[VidView_IsTVRoot] + Integer.IsGreater(Container.NumItems,0)">$INFO[Container.CurrentItem,, of ]$INFO[Container.NumItems]</value>
		<value condition="Integer.IsGreater(Container.NumItems,0) + Integer.IsGreater(Container.TotalUnWatched,0)">$INFO[Container.CurrentItem,, of ]$INFO[Container.NumItems]  ·  $INFO[Container.TotalUnWatched,, unwatched]</value>
		<value condition="Integer.IsGreater(Container.NumItems,0)">$INFO[Container.CurrentItem,, of ]$INFO[Container.NumItems]</value>
	</variable>
	<variable name="VidView_FilterLabel">
		<value condition="System.Setting(hidewatched)">Unwatched only</value>
		<value>All</value>
	</variable>
	<variable name="VidView_SortArrow">
		<value condition="Container.SortDirection(descending)">↓</value>
		<value>↑</value>
	</variable>
	<!-- Kodi stores US certifications as "Rated PG-13": show the bare code -->
	<variable name="VidView_MPAA">
		<value condition="String.IsEqual(ListItem.MPAA,Rated R)">R</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated PG)">PG</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated G)">G</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated NR)">NR</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated NC-17)">NC-17</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated TV-MA)">TV-MA</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated TV-14)">TV-14</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated TV-PG)">TV-PG</value>
		<value>$INFO[ListItem.MPAA]</value>
	</variable>
	<variable name="VidView_MPAAMeta">
		<value condition="!String.IsEmpty(ListItem.MPAA)">  ·  $VAR[VidView_MPAA]</value>
	</variable>
	<variable name="VidView_Status">
		<value condition="String.IsEqual(ListItem.DBType,set) + $EXP[VidView_SetDone]">Watched</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + Integer.IsGreater(ListItem.Property(Watched),0)">In progress</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Unwatched</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Status)">$INFO[ListItem.Status]</value>
		<value condition="$EXP[VidView_IsTVType] + $EXP[VidView_TVDone]">Watched</value>
		<value condition="$EXP[VidView_IsTVType] + Integer.IsGreater(ListItem.Property(WatchedEpisodes),0)">In progress</value>
		<value condition="$EXP[VidView_IsTVType]">Unwatched</value>
		<value condition="ListItem.IsResumable">Resume at $INFO[ListItem.PercentPlayed]%</value>
		<value condition="Integer.IsGreater(ListItem.PlayCount,0)">Watched</value>
		<value>Unwatched</value>
	</variable>
	<variable name="VidView_EpCode">
		<value condition="String.IsEmpty(ListItem.Episode)"></value>
		<value>S$INFO[ListItem.Season] · E$INFO[ListItem.Episode]</value>
	</variable>
	<variable name="VidView_ItemTitle">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<!-- detail panel kicker -->
	<variable name="VidView_Kicker">
		<value condition="ListItem.IsParentFolder">Up one level</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">$VAR[VidView_EpCode]$INFO[ListItem.TVShowTitle,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]$INFO[ListItem.Property(TotalEpisodes),  ·  , episodes]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$VAR[VidView_Status]$VAR[VidView_SeasonsWord]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Collection$INFO[ListItem.Property(Total),  ·  , films]</value>
		<value condition="$EXP[VidView_IsPlayable]">$VAR[VidView_Status]$INFO[ListItem.DateAdded,  ·  added ,]</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
	<variable name="VidView_SeasonsWord">
		<value condition="Integer.IsEqual(ListItem.Property(TotalSeasons),1)">  ·  1 season</value>
		<value condition="Integer.IsGreater(ListItem.Property(TotalSeasons),1)">$INFO[ListItem.Property(TotalSeasons),  ·  , seasons]</value>
	</variable>
	<!-- meta line before the rating star: 2026 · PG-13 · 2h 25m · -->
	<variable name="VidView_MetaLeft">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Premiered,Aired ,]$INFO[ListItem.Duration(mins),  ·  , min]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$INFO[ListItem.Year]$INFO[ListItem.Property(TotalEpisodes),  ·  , episodes]$INFO[ListItem.Studio,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.Year]$INFO[ListItem.Property(WatchedEpisodes),  ·  , watched]</value>
		<value>$INFO[ListItem.Year]$VAR[VidView_MPAAMeta]$VAR[VidView_RuntimeMeta]</value>
	</variable>
	<variable name="VidView_RuntimeMeta">
		<value condition="Integer.IsGreater(ListItem.Duration(h),0)">  ·  $INFO[ListItem.Duration(h),,h ]$INFO[ListItem.Duration(m),,m]</value>
		<value condition="!String.IsEmpty(ListItem.Duration)">  ·  $INFO[ListItem.Duration(m),,m]</value>
	</variable>
	<variable name="VidView_Credits">
		<value condition="!String.IsEmpty(ListItem.Director)">Directed by [COLOR $VAR[DL_Ink]]$INFO[ListItem.Director][/COLOR]</value>
		<value condition="!String.IsEmpty(ListItem.Studio)">$INFO[ListItem.Studio]</value>
	</variable>
	<!-- When to watch (movies, episodes) -->
	<variable name="VidView_WhenTitle">
		<value condition="ListItem.IsResumable">$INFO[ListItem.Duration(mins),, min]  ·  pick it up again</value>
		<value condition="Integer.IsLessOrEqual(ListItem.Duration(mins),30)">$INFO[ListItem.Duration(mins),, min]  ·  a quick one</value>
		<value condition="Integer.IsLessOrEqual(ListItem.Duration(mins),95)">$INFO[ListItem.Duration(mins),, min]  ·  fits tonight</value>
		<value condition="Integer.IsLessOrEqual(ListItem.Duration(mins),125)">$INFO[ListItem.Duration(mins),, min]  ·  an easy evening</value>
		<value condition="Integer.IsLessOrEqual(ListItem.Duration(mins),150)">$INFO[ListItem.Duration(mins),, min]  ·  a full evening</value>
		<value>$INFO[ListItem.Duration(mins),, min]  ·  a long one</value>
	</variable>
	<variable name="VidView_WhenLine">
		<value condition="ListItem.IsResumable + $EXP[DL_CountdownOn]">Resume now and you're done by $INFO[ListItem.EndTimeResume].</value>
		<value condition="ListItem.IsResumable">Resume now and you're done by $INFO[ListItem.EndTimeResume].</value>
		<value condition="$EXP[DL_ItemFits]">Start now and it ends at $INFO[ListItem.EndTime], before $VAR[DL_BedWord].</value>
		<value condition="$EXP[DL_CountdownOn]">Start now and it ends at $INFO[ListItem.EndTime], after $VAR[DL_BedWord].</value>
		<value>Start now and you're done by $INFO[ListItem.EndTime].</value>
	</variable>
	<variable name="VidView_ProgressTitle">
		<value condition="String.IsEqual(ListItem.DBType,set)">$INFO[ListItem.Property(Watched),, of ]$INFO[ListItem.Property(Total),, films watched]</value>
		<value condition="$EXP[VidView_TVDone]">All $INFO[ListItem.Property(TotalEpisodes)] episodes watched</value>
		<value>$INFO[ListItem.Property(WatchedEpisodes),, of ]$INFO[ListItem.Property(TotalEpisodes),, episodes watched]</value>
	</variable>
	<variable name="VidView_ProgressLine">
		<value condition="String.IsEqual(ListItem.DBType,set)">A collection: OK opens its films.</value>
		<value condition="$EXP[VidView_TVDone]">Nothing left: a good time for something new.</value>
		<value>$INFO[ListItem.Property(UnWatchedEpisodes),, still to watch]</value>
	</variable>
	<!-- episode row line -->
	<variable name="VidView_EpLine">
		<value condition="ListItem.IsParentFolder">Up one level</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Duration(mins),, min]$INFO[ListItem.Premiered,  ·  aired ,]$INFO[ListItem.Rating,  ·  rated ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.Property(TotalEpisodes),, episodes]$INFO[ListItem.Property(WatchedEpisodes),  ·  , watched]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>
	<variable name="VidView_EpKicker">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$VAR[VidView_EpCode]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.Property(UnWatchedEpisodes),, unwatched]</value>
	</variable>
	<variable name="VidView_ThumbArt">
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value>$INFO[ListItem.Art(fanart)]</value>
	</variable>
	<variable name="VidView_PosterArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- ================================================================== art pieces -->
	<!-- ".." parent item tile: raised rounded block + back chevron -->
	<include name="VidView_ParentTile">
		<param name="icon">40</param>
		<param name="caption_visible">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture border="24" colordiffuse="$VAR[DL_Raised]">daylight/card20.png</texture>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>46%</centertop>
					<width>$PARAM[icon]</width>
					<height>$PARAM[icon]</height>
					<texture colordiffuse="$VAR[DL_Ink2]">daylight/icons/back.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<right>0</right>
					<bottom>24</bottom>
					<height>26</height>
					<align>center</align>
					<font>small_20_semibold</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$LOCALIZE[31245]</label>
					<visible>$PARAM[caption_visible]</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- Placeholder under the art (and the ".." tile). params: mask, label, label_visible -->
	<include name="VidView_ArtFallback">
		<param name="mask">masks/poster_round8.png</param>
		<param name="label">$INFO[ListItem.Label]</param>
		<param name="label_visible">String.IsEmpty(ListItem.Art(poster))</param>
		<param name="parent_icon">40</param>
		<param name="parent_caption">true</param>
		<definition>
			<include content="VidView_ParentTile">
				<param name="icon" value="$PARAM[parent_icon]"/>
				<param name="caption_visible" value="$PARAM[parent_caption]"/>
			</include>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<visible>!ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture diffuse="$PARAM[mask]" colordiffuse="$VAR[DL_Raised]">common/white.png</texture>
				</control>
				<control type="textbox">
					<left>16</left>
					<right>16</right>
					<top>14</top>
					<height>78</height>
					<font>small_20_semibold</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$PARAM[label]</label>
					<visible>$PARAM[label_visible]</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- One artwork image with a rounded mask. params: art, mask, color, visible, aspect, fade -->
	<include name="VidView_ArtImage">
		<param name="art">$INFO[ListItem.Art(poster)]</param>
		<param name="mask">masks/poster_round8.png</param>
		<param name="color">$VAR[DL_ArtDim]</param>
		<param name="visible">true</param>
		<param name="aspect">scale</param>
		<param name="fade">0</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio scalediffuse="false">$PARAM[aspect]</aspectratio>
				<fadetime>$PARAM[fade]</fadetime>
				<texture background="true" diffuse="$PARAM[mask]" colordiffuse="$PARAM[color]">$PARAM[art]</texture>
				<visible>$PARAM[visible] + !ListItem.IsParentFolder</visible>
			</control>
		</definition>
	</include>
	<!-- Show / season markers: unwatched count chip or a watched check -->
	<include name="VidView_TVMarkers">
		<!-- unwatched episodes: accent disc (1-2 digits) or a wider pill (3 digits); list layouts can't
		     hold grouplists (Kodi drops them: "unsupported control type"), so widths are fixed -->
		<control type="group">
			<right>10</right>
			<top>10</top>
			<width>40</width>
			<height>40</height>
			<visible>$EXP[ShowUnwatchedMarkers] + $EXP[VidView_IsTVType] + Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0) + Integer.IsLess(ListItem.Property(UnWatchedEpisodes),100)</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>40</width>
				<height>40</height>
				<texture colordiffuse="$VAR[DL_Accent]">daylight/circle_38.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>40</width>
				<height>40</height>
				<align>center</align>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$INFO[ListItem.Property(UnWatchedEpisodes)]</label>
			</control>
		</control>
		<control type="group">
			<right>10</right>
			<top>10</top>
			<width>60</width>
			<height>40</height>
			<visible>$EXP[ShowUnwatchedMarkers] + $EXP[VidView_IsTVType] + Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),99)</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>60</width>
				<height>40</height>
				<texture border="20,0,20,0" colordiffuse="$VAR[DL_Accent]">daylight/pill_40.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>60</width>
				<height>40</height>
				<align>center</align>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$INFO[ListItem.Property(UnWatchedEpisodes)]</label>
			</control>
		</control>
		<control type="image">
			<right>8</right>
			<top>8</top>
			<width>40</width>
			<height>40</height>
			<texture>markers/watched.png</texture>
			<visible>$EXP[ShowWatchedMarkers] + [[$EXP[VidView_IsTVType] + $EXP[VidView_TVDone]] | $EXP[VidView_SetDone]]</visible>
		</control>
	</include>

	<!-- One grid poster (500 / 501). params: id, w, h, pad, focused -->
	<include name="VidView_GridItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>$PARAM[pad]</left>
				<top>$PARAM[pad]</top>
				<width>$PARAM[w]</width>
				<height>$PARAM[h]</height>
				<animation type="Focus" reversible="true" condition="$PARAM[focused] + !$EXP[ReduceMotion]">
					<effect type="zoom" start="100" end="106" center="auto" time="160" tween="cubic" easing="out"/>
				</animation>
				<include content="VidView_ArtFallback">
					<param name="label_visible" value="String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb))"/>
				</include>
				<include content="VidView_ArtImage">
					<param name="art" value="$VAR[VidView_PosterArt]"/>
				</include>
				<control type="group">
					<visible>!ListItem.IsParentFolder</visible>
					<include>DL_WatchedMarkers</include>
					<include>VidView_TVMarkers</include>
				</control>
				<include content="DL_FocusRing" condition="$PARAM[focused]">
					<param name="r" value="20"/>
					<param name="visible" value="Control.HasFocus($PARAM[id])"/>
				</include>
			</control>
		</definition>
	</include>

	<!-- ================================================================== window pieces -->
	<!-- The soft card behind the views: next to the detail panel, or full width for the Wall -->
	<include name="VidView_Card">
		<control type="group">
			<left>vv_card_x</left>
			<top>vv_top</top>
			<width>vv_card_w</width>
			<height>vv_card_h</height>
			<visible>!Control.IsVisible(501)</visible>
			<include>DL_Card</include>
		</control>
		<control type="group">
			<left>page_margin</left>
			<top>vv_top</top>
			<width>page_width</width>
			<height>vv_card_h</height>
			<visible>Control.IsVisible(501)</visible>
			<include>DL_Card</include>
		</control>
	</include>
	<!-- fade at the card bottom so the third row reads as "more below" -->
	<include name="VidView_CardFade">
		<control type="image">
			<left>vv_card_x</left>
			<top>866</top>
			<width>vv_card_w</width>
			<height>150</height>
			<texture border="0,0,0,0" diffuse="daylight/mask_fade_card.png" colordiffuse="$VAR[DL_Surface]">daylight/fade_bottom_150.png</texture>
			<visible>!Control.IsVisible(501)</visible>
		</control>
		<control type="image">
			<left>page_margin</left>
			<top>866</top>
