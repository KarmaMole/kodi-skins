<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are returned as NAMES from colors/defaults.xml (never hex in windows).
	Note: $VAR works in colordiffuse="" and <textcolor>/<focusedcolor>, NOT in diffuse="" or border="".
-->
<includes>
	<!-- ===================================================================== colours -->

	<!-- Setting 1: accent. Skin.String(sixdegrees.accent) stores a keyword; empty = Signal.
	     A raw AARRGGBB value is also accepted (last-but-one line) so a hand-set hex never breaks. -->
	<variable name="ColorAccent">
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),cobalt)">l_lead</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),mint)">l_yg</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),amber)">l_dir</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),rose)">l_co</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),ice)">l_lead</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),bone)">ink</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),signal) | String.IsEmpty(Skin.String(sixdegrees.accent))">l_dir</value>
		<value condition="String.StartsWith(Skin.String(sixdegrees.accent),ff)">$INFO[Skin.String(sixdegrees.accent)]</value>
		<value>ink</value>
	</variable>

	<!-- Display name of the accent (settings stub) -->
	<variable name="AccentName">
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),cobalt)">$LOCALIZE[31061]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),mint)">$LOCALIZE[31062]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),amber)">$LOCALIZE[31063]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),rose)">$LOCALIZE[31064]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),ice)">$LOCALIZE[31065]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.accent),bone)">$LOCALIZE[31066]</value>
		<value>$LOCALIZE[31060]</value>
	</variable>

	<!-- Rules: solid greys on the flat page, white-alpha over the artwork background (DESIGN 2.2) -->
	<variable name="ColorRule">
		<value condition="$EXP[ArtBackgroundOn]">hair</value>
		<value>hair</value>
	</variable>
	<variable name="ColorRuleStrong">
		<value condition="$EXP[ArtBackgroundOn]">hair_strong</value>
		<value>hair_strong</value>
	</variable>
	<!-- Mono captions: promoted to text_secondary over artwork (DESIGN 2.5) -->
	<variable name="ColorCaption">
		<value condition="$EXP[ArtBackgroundOn]">ink2</value>
		<value>ink2</value>
	</variable>

	<!-- ==================================================================== textures -->

	<!-- Focus frame (setting 3 x setting 2). Empty when the outline is Off. 40x40, border 16,
	     placed at item rect +7px each side (constants focus_out / focus_grow). -->
	<variable name="FocusFrame">
		<value condition="$EXP[FocusOutlineOff]"></value>
		<value condition="$EXP[FocusOutlineMedium] + $EXP[IsRounded]">focus/outline_3_round.png</value>
		<value condition="$EXP[FocusOutlineMedium]">focus/outline_3.png</value>
		<value condition="$EXP[IsRounded]">focus/outline_2_round.png</value>
		<value>focus/outline_2.png</value>
	</variable>
	<!-- Frames for controls that must ALWAYS show focus (buttons, dialogs): never empty -->
	<variable name="FocusFrameAlways">
		<value condition="$EXP[FocusOutlineMedium] + $EXP[IsRounded]">focus/outline_3_round.png</value>
		<value condition="$EXP[FocusOutlineMedium]">focus/outline_3.png</value>
		<value condition="$EXP[IsRounded]">focus/outline_2_round.png</value>
		<value>focus/outline_2.png</value>
	</variable>

	<!-- Button fill / outline (32x32, border 10) -->
	<variable name="ButtonFill">
		<value condition="$EXP[IsRounded]">common/rect_round8.png</value>
		<value>common/rect_square.png</value>
	</variable>
	<variable name="ButtonOutline">
		<value condition="$EXP[IsRounded]">common/rect_outline_1_round8.png</value>
		<value>common/rect_outline_1.png</value>
	</variable>

	<!-- Watched markers (DESIGN 7.3) -->
	<variable name="MarkerUnwatched">
		<value condition="$EXP[IsRounded]">markers/unwatched_round.png</value>
		<value>markers/unwatched.png</value>
	</variable>
	<variable name="MarkerWatched">
		<value condition="$EXP[IsRounded]">markers/watched_round.png</value>
		<value>markers/watched.png</value>
	</variable>

	<!-- ====================================================================== labels -->

	<variable name="DateLabel">
		<value>$INFO[System.Date(DDD)] $INFO[System.Date(d MMM)]</value>
	</variable>
	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>

	<!-- Home spotlight (data list 9101) -->
	<variable name="SpotlightArt">
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(fanart))">$INFO[Container(9101).ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(landscape))">$INFO[Container(9101).ListItem.Art(landscape)]</value>
		<value>$INFO[Container(9101).ListItem.Art(poster)]</value>
	</variable>
	<variable name="SpotlightRuntime">
		<value condition="Integer.IsGreater(Container(9101).ListItem.Duration(h),0)">$INFO[Container(9101).ListItem.Duration(h),,h ]$INFO[Container(9101).ListItem.Duration(m),,m]</value>
		<value>$INFO[Container(9101).ListItem.Duration(m),,m]</value>
	</variable>
	<!-- Director (primary) + cast (secondary). ListItem.Cast is newline-separated, so this is shown in a
	     1-line textbox: "Director  ·  first cast member". M2 (T12) may switch to TMDb Helper cast properties. -->
	<variable name="SpotlightCredits">
		<value condition="!String.IsEmpty(Container(9101).ListItem.Director)">[COLOR ink]$INFO[Container(9101).ListItem.Director][/COLOR]$INFO[Container(9101).ListItem.Cast,  ·  ,]</value>
		<value>$INFO[Container(9101).ListItem.Cast]</value>
	</variable>

	<!-- Kodi stores US certifications as "Rated PG-13" (DATA.md 4.1): show the bare code -->
	<variable name="SpotlightMPAA">
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated R)">R</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated PG)">PG</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated G)">G</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated NR)">NR</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated NC-17)">NC-17</value>
		<value>$INFO[Container(9101).ListItem.MPAA]</value>
	</variable>

	<!-- Poster/thumb for any list item (view 50 art panel, dialogs) -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title (MyVideoNav / MyMusicNav header) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- OSD -->
	<variable name="OSDTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<variable name="OSDKicker">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.Season,S,]$INFO[VideoPlayer.Episode,E,]$INFO[VideoPlayer.Title,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ,]</value>
		<value>$INFO[VideoPlayer.Year]</value>
	</variable>
	<!-- ============================================================ skin settings -->
	<!-- Cycle helpers: SkinSettings buttons run Skin.SetString(name,$VAR[Next...]) - one action, so
	     there is no ordering issue between conditional onclicks. Defaults are stored as explicit
	     keywords (thin / faint / both / 15 / added) that the expressions treat exactly like empty. -->
	<variable name="NextFocusOutline">
		<value condition="String.IsEqual(Skin.String(sixdegrees.focusoutline),medium)">off</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.focusoutline),off)">thin</value>
		<value>medium</value>
	</variable>
	<variable name="LabelFocusOutline">
		<value condition="String.IsEqual(Skin.String(sixdegrees.focusoutline),medium)">$LOCALIZE[31071]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.focusoutline),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31070]</value>
	</variable>
	<variable name="NextArtBackground">
		<value condition="String.IsEqual(Skin.String(sixdegrees.artbackground),soft)">visible</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.artbackground),visible)">off</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.artbackground),off)">faint</value>
		<value>soft</value>
	</variable>
	<variable name="LabelArtBackground">
		<value condition="!System.AddonIsEnabled(plugin.video.themoviedb.helper)">$LOCALIZE[31072]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.artbackground),soft)">$LOCALIZE[31076]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.artbackground),visible)">$LOCALIZE[31077]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.artbackground),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31075]</value>
	</variable>
	<variable name="NextWatchedMarkers">
		<value condition="String.IsEqual(Skin.String(sixdegrees.watchedmarkers),unwatched)">watched</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.watchedmarkers),watched)">off</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.watchedmarkers),off)">both</value>
		<value>unwatched</value>
	</variable>
	<variable name="LabelWatchedMarkers">
		<value condition="String.IsEqual(Skin.String(sixdegrees.watchedmarkers),unwatched)">$LOCALIZE[31081]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.watchedmarkers),watched)">$LOCALIZE[31082]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.watchedmarkers),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31080]</value>
	</variable>
	<variable name="NextSpotlightRotate">
		<value condition="String.IsEqual(Skin.String(sixdegrees.spotlightrotate),30)">off</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.spotlightrotate),off)">8</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.spotlightrotate),8)">15</value>
		<value>30</value>
	</variable>
	<variable name="LabelSpotlightRotate">
		<value condition="String.IsEqual(Skin.String(sixdegrees.spotlightrotate),off)">$LOCALIZE[31072]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.spotlightrotate),8)">8 s</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.spotlightrotate),30)">30 s</value>
		<value>15 s</value>
	</variable>
	<variable name="NextHomeNewest">
		<value condition="String.IsEqual(Skin.String(sixdegrees.home.newest),release)">both</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.home.newest),both)">added</value>
		<value>release</value>
	</variable>
	<variable name="LabelHomeNewest">
		<value condition="String.IsEqual(Skin.String(sixdegrees.home.newest),release)">$LOCALIZE[31086]</value>
		<value condition="String.IsEqual(Skin.String(sixdegrees.home.newest),both)">$LOCALIZE[31087]</value>
		<value>$LOCALIZE[31085]</value>
	</variable>
	<!-- ==================================================================== OSD extras -->
	<variable name="OSDTimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]$INFO[Player.Duration, / ,]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
	<variable name="OSDStateLabel">
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$INFO[Player.SeekStepSize]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)">$INFO[Player.SeekOffset]</value>
		<value condition="Player.Paused">$LOCALIZE[112]</value>
		<value condition="Player.Forwarding | Player.Rewinding">$INFO[Player.PlaySpeed,,x]</value>
	</variable>
	<variable name="OSDHelpLabel">
		<value condition="Control.HasFocus(87)">$LOCALIZE[31120]</value>
		<value condition="Control.HasFocus(600)">$LOCALIZE[31121]</value>
		<value condition="Control.HasFocus(601)">$LOCALIZE[31122]</value>
		<value condition="Control.HasFocus(602)">$LOCALIZE[31123]</value>
		<value condition="Control.HasFocus(603)">$LOCALIZE[31124]</value>
		<value condition="Control.HasFocus(606)">$LOCALIZE[31125]</value>
		<value condition="Control.HasFocus(607)">$LOCALIZE[31126]</value>
		<value condition="Control.HasFocus(70046)">$LOCALIZE[31127]</value>
		<value condition="Control.HasFocus(70049)">$LOCALIZE[31128]</value>
		<value condition="Control.HasFocus(70048)">$LOCALIZE[31129]</value>
	</variable>
</includes>
