<?xml version="1.0" encoding="UTF-8"?>
<!-- Engine forked from skin.groove 1.0.1 (M1); the Vernissage settings page in M4 (skin-developer, 2026-10-21). -->
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...), screens/Settings.md: the room, the section
	name as the exhibition title (Kodi writes label 2), "Kodi settings" under it; categories (grouplist 3, Kodi clones
	template 10) at 120, 196, 420 x 768; the settings (grouplist 5, templates 7-15) at 600, 196, 1200 x 768, rows 72,
	values right-aligned inside 1780; the focused setting's description (textbox 6) on one line at 600, 980, scrolling
	when longer; the settings level (button 20) under the categories. Placard rows: ink2 at rest, ink + the 2 px
	hairline on focus.
	Escape hatch that must always work: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega SettingsCategory.xml): 2 section label, 3 categories + template 10, 5 control area,
	6 description, templates 7-15, 20 settings level, 60 scrollbar.
	Focus: categories 3 (Up stops, Down from the last -> 20) -Right-> settings 5 (Up / Down wrap, Right -> 60)
	-Left-> 3; 20 Up -> 3, Right -> 5. Back = Kodi (previous window).
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<controls>
		<include>VN_Room</include>
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="VN_SettingsHead">
				<param name="title" value="$INFO[Control.GetLabel(2)]"/>
				<param name="sub" value="$LOCALIZE[31621]"/>
			</include>

			<!-- ====== categories -->
			<control type="grouplist" id="3">
				<description>categories (Kodi clones template 10 into it)</description>
				<left>120</left>
				<top>196</top>
				<width>420</width>
				<height>768</height>
				<orientation>vertical</orientation>
				<onleft>noop</onleft>
				<onright>5</onright>
				<onup>noop</onup>
				<ondown>20</ondown>
			</control>
			<include content="VN_SettingCategoryTemplate">
				<param name="width" value="420"/>
			</include>
			<control type="group">
				<left>120</left>
				<top>972</top>
				<include content="VN_SettingLevelButton">
					<param name="width" value="420"/>
					<param name="onup" value="3"/>
					<param name="ondown" value="noop"/>
					<param name="onleft" value="noop"/>
					<param name="onright" value="5"/>
				</include>
			</control>

			<!-- ====== settings -->
			<control type="grouplist" id="5">
				<description>control area</description>
				<left>600</left>
				<top>196</top>
				<width>1200</width>
				<height>768</height>
				<pagecontrol>60</pagecontrol>
				<onleft>3</onleft>
				<onright>60</onright>
				<onup>5</onup>
				<ondown>5</ondown>
			</control>
			<include content="VN_SettingTemplates">
				<param name="width" value="1200"/>
			</include>
			<include content="VN_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1812"/>
				<param name="top" value="196"/>
				<param name="height" value="768"/>
				<param name="onleft" value="5"/>
				<param name="onright" value="noop"/>
			</include>

			<!-- ====== what the focused setting does: one line, scrolling when longer -->
			<control type="textbox" id="6">
				<description>description (Kodi)</description>
				<left>600</left>
				<top>980</top>
				<width>1200</width>
				<height>38</height>
				<font>font_small</font>
				<textcolor>$VAR[ink2]</textcolor>
				<autoscroll time="2500" delay="5000" repeat="5000">true</autoscroll>
			</control>

			<control type="label" id="2">
				<description>section label (Kodi writes it; shown as the title)</description>
				<visible>false</visible>
			</control>
		</control>
	</controls>
</window>
