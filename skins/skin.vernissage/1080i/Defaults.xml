<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Focus language (Vernissage, M4): rows and buttons in ink2 at rest, ink + a 2 px ink hairline under the row on
	focus (vn/row_rule.png: bottom border with a clear buffer row); edits rest in a 1 px card_edge outline. No fills,
	no colour (SPEC 2.1). Controls that draw their own textures keep them. Colours are room tokens ($VAR[...]).
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<selectedcolor>$VAR[ink]</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="$VAR[ink]">fork/dot_on.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[ink]">fork/dot_on.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="$VAR[placard_rule]">fork/dot_off.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="$VAR[placard_rule]">fork/dot_off.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="white_40">fork/dot_on.png</textureradioondisabled>
		<textureradiooffdisabled colordiffuse="white_40">fork/dot_off.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="$VAR[ink2]">vn/icons/chevron-right.png</textureup>
		<texturedown colordiffuse="$VAR[ink2]" flipx="true">vn/icons/chevron-right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[ink]">vn/icons/chevron-right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[ink]" flipx="true">vn/icons/chevron-right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[disabled]">vn/icons/chevron-right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[disabled]" flipx="true">vn/icons/chevron-right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="$VAR[ink2]">vn/icons/chevron-right.png</textureup>
		<texturedown colordiffuse="$VAR[ink2]" flipx="true">vn/icons/chevron-right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[ink]">vn/icons/chevron-right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[ink]" flipx="true">vn/icons/chevron-right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[disabled]">vn/icons/chevron-right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[disabled]" flipx="true">vn/icons/chevron-right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>6</sliderheight>
		<texturesliderbar colordiffuse="$VAR[placard_rule]">vn/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="$VAR[rule]">vn/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[ink2]">vn/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[ink]">vn/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[disabled]">vn/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="$VAR[placard_rule]">vn/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="$VAR[rule]">vn/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[ink2]">vn/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[ink]">vn/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[disabled]">vn/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>vn/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="$VAR[disabled]">vn/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<invalidcolor>$VAR[ink]</invalidcolor>
		<texturefocus border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texturefocus>
		<texturenofocus border="4" colordiffuse="$VAR[card_edge]">vn/card_edge.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="$VAR[placard_rule]">vn/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="$VAR[ink]">vn/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="$VAR[rule]">vn/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="$VAR[ink2]">vn/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="$VAR[ink]">vn/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
