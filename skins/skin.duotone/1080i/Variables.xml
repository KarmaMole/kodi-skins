<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	$VAR works in colordiffuse="" and <textcolor>/<focusedcolor> (verified: Majan on device, Arctic Fuse),
	NOT in diffuse="" or border="".

	THE SECTION SYSTEM (the heart of Duotone, DESIGN.md section 2)
	One section is "current" at any moment: films / series / music / paper. It is decided by the
	$EXP[DT_SecSeries] / $EXP[DT_SecMusic] / $EXP[DT_SecPaper] expressions (Expressions.xml; films is
	whatever is left). Every field, tint, rule and text colour reads one of these variables, so a
	section change recolours the whole screen in the same frame:
	  SectionColor   the field (vermilion / cobalt / acid / paper)
	  SectionText    text and icons ON the field (ink; paper on cobalt, the one dark field)
	  SectionText2   secondary text on the field (70%)
	  SectionText3   captions / disabled (45-55%)
	  SectionFaint   ghosted display type (the unfocused section names, 26%)
	  SectionTint    colordiffuse that turns artwork into the section's one-colour print
	Ink blocks (#111) carry paper text and section-colour captions ($VAR[SectionColor] reads well on ink
	for all four sections).
-->
<includes>
	<!-- ================================================================ section colours -->
	<variable name="SectionColor">
		<value condition="$EXP[DT_SecSeries]">cobalt</value>
		<value condition="$EXP[DT_SecMusic]">acid</value>
		<value condition="$EXP[DT_SecPaper]">paper</value>
		<value>vermilion</value>
	</variable>
	<variable name="SectionText">
		<value condition="$EXP[DT_SecSeries]">paper</value>
		<value>ink</value>
	</variable>
	<variable name="SectionText2">
		<value condition="$EXP[DT_SecSeries]">paper_80</value>
		<value>ink_80</value>
	</variable>
	<variable name="SectionText3">
		<value condition="$EXP[DT_SecSeries]">paper_55</value>
		<value>ink_55</value>
	</variable>
	<variable name="SectionFaint">
		<value condition="$EXP[DT_SecSeries]">paper_30</value>
		<value>ink_26</value>
	</variable>
	<!-- Monotone print tint (setting duotone.mono: empty = full print, light = soft wash, off = colour) -->
	<variable name="SectionTint">
		<value condition="String.IsEqual(Skin.String(duotone.mono),off)">white</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_SecSeries]">tintl_series</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_SecMusic]">tintl_music</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_SecPaper]">tintl_paper</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light)">tintl_films</value>
		<value condition="$EXP[DT_SecSeries]">tint_series</value>
		<value condition="$EXP[DT_SecMusic]">tint_music</value>
		<value condition="$EXP[DT_SecPaper]">tint_paper</value>
		<value>tint_films</value>
	</variable>
	<!-- Tint for a desaturated (TMDb Helper) source: the same colours at full strength -->
	<variable name="SectionPrint">
		<value condition="$EXP[DT_SecSeries]">cobalt</value>
		<value condition="$EXP[DT_SecMusic]">acid</value>
		<value condition="$EXP[DT_SecPaper]">tint_paper</value>
		<value>vermilion</value>
	</variable>
	<!-- Section name / number for headers -->
	<variable name="SectionName">
		<value condition="$EXP[DT_SecSeries]">Series</value>
		<value condition="$EXP[DT_SecMusic]">Music</value>
		<value condition="Window.IsActive(1150)">Search</value>
		<value condition="$EXP[DT_SecPaper]">System</value>
		<value>Films</value>
	</variable>

	<!-- Legacy names kept so forked engine code keeps resolving (all map to the Duotone language) -->
	<variable name="ColorAccent"><value>ink</value></variable>
	<variable name="ColorRule"><value>ink</value></variable>
	<variable name="ColorRuleStrong"><value>ink</value></variable>
	<variable name="ColorCaption"><value>$VAR[SectionText3]</value></variable>
	<variable name="AccentName"><value>Duotone</value></variable>

	<!-- ==================================================================== textures -->
	<!-- 8px ink frame, 48x48, border 16 (8 ring + 8 transparent buffer). Placed at item rect -8px. -->
	<variable name="FocusFrame">
		<value>focus/frame_8.png</value>
	</variable>
	<variable name="FocusFrameAlways">
		<value>focus/frame_8.png</value>
	</variable>
	<!-- Block fill / 8px bordered block (48x48, border 16) -->
	<variable name="ButtonFill">
		<value>common/rect_square.png</value>
	</variable>
	<variable name="ButtonOutline">
		<value>common/rect_outline_8.png</value>
	</variable>
	<variable name="MarkerUnwatched">
		<value>markers/unwatched.png</value>
	</variable>
	<variable name="MarkerWatched">
		<value>markers/watched.png</value>
	</variable>

	<!-- ====================================================================== labels -->

	<variable name="DateLabel">
		<value>$INFO[System.Date(DDD)] $INFO[System.Date(d MMM)]</value>
	</variable>
	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>

	<!-- Home spotlight (data list 9101) -->
	<variable name="SpotlightArt">
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(fanart))">$INFO[Container(9101).ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(landscape))">$INFO[Container(9101).ListItem.Art(landscape)]</value>
		<value>$INFO[Container(9101).ListItem.Art(poster)]</value>
	</variable>
	<variable name="SpotlightRuntime">
		<value condition="Integer.IsGreater(Container(9101).ListItem.Duration(h),0)">$INFO[Container(9101).ListItem.Duration(h),,h ]$INFO[Container(9101).ListItem.Duration(m),,m]</value>
		<value>$INFO[Container(9101).ListItem.Duration(m),,m]</value>
	</variable>
	<!-- Director (primary) + cast (secondary). ListItem.Cast is newline-separated, so this is shown in a
	     1-line textbox: "Director  ·  first cast member". M2 (T12) may switch to TMDb Helper cast properties. -->
	<variable name="SpotlightCredits">
		<value condition="!String.IsEmpty(Container(9101).ListItem.Director)">$INFO[Container(9101).ListItem.Director]$INFO[Container(9101).ListItem.Cast,  ·  ,]</value>
		<value>$INFO[Container(9101).ListItem.Cast]</value>
	</variable>

	<!-- Kodi stores US certifications as "Rated PG-13" (DATA.md 4.1): show the bare code -->
	<variable name="SpotlightMPAA">
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated R)">R</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated PG)">PG</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated G)">G</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated NR)">NR</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated NC-17)">NC-17</value>
		<value>$INFO[Container(9101).ListItem.MPAA]</value>
	</variable>

	<!-- Poster/thumb for any list item (view 50 art panel, dialogs) -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title (MyVideoNav / MyMusicNav header) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- OSD -->
	<variable name="OSDTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<variable name="OSDKicker">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.Season,S,]$INFO[VideoPlayer.Episode,E,]$INFO[VideoPlayer.Title,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ,]</value>
		<value>$INFO[VideoPlayer.Year]</value>
	</variable>
	<!-- ============================================================ skin settings -->
	<!-- Cycle helpers: SkinSettings buttons run Skin.SetString(name,$VAR[Next...]) - one action, so
	     there is no ordering issue between conditional onclicks. Defaults are stored as explicit
	     keywords (thin / faint / both / 15 / added) that the expressions treat exactly like empty. -->
	<variable name="NextFocusOutline">
		<value condition="String.IsEqual(Skin.String(duotone.focusoutline),medium)">off</value>
		<value condition="String.IsEqual(Skin.String(duotone.focusoutline),off)">thin</value>
		<value>medium</value>
	</variable>
	<variable name="LabelFocusOutline">
		<value condition="String.IsEqual(Skin.String(duotone.focusoutline),medium)">$LOCALIZE[31071]</value>
		<value condition="String.IsEqual(Skin.String(duotone.focusoutline),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31070]</value>
	</variable>
	<variable name="NextArtBackground">
		<value condition="String.IsEqual(Skin.String(duotone.artbackground),soft)">visible</value>
		<value condition="String.IsEqual(Skin.String(duotone.artbackground),visible)">off</value>
		<value condition="String.IsEqual(Skin.String(duotone.artbackground),off)">faint</value>
		<value>soft</value>
	</variable>
	<variable name="LabelArtBackground">
		<value condition="!System.AddonIsEnabled(plugin.video.themoviedb.helper)">$LOCALIZE[31072]</value>
		<value condition="String.IsEqual(Skin.String(duotone.artbackground),soft)">$LOCALIZE[31076]</value>
		<value condition="String.IsEqual(Skin.String(duotone.artbackground),visible)">$LOCALIZE[31077]</value>
		<value condition="String.IsEqual(Skin.String(duotone.artbackground),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31075]</value>
	</variable>
	<variable name="NextWatchedMarkers">
		<value condition="String.IsEqual(Skin.String(duotone.watchedmarkers),unwatched)">watched</value>
		<value condition="String.IsEqual(Skin.String(duotone.watchedmarkers),watched)">off</value>
		<value condition="String.IsEqual(Skin.String(duotone.watchedmarkers),off)">both</value>
		<value>unwatched</value>
	</variable>
	<variable name="LabelWatchedMarkers">
		<value condition="String.IsEqual(Skin.String(duotone.watchedmarkers),unwatched)">$LOCALIZE[31081]</value>
		<value condition="String.IsEqual(Skin.String(duotone.watchedmarkers),watched)">$LOCALIZE[31082]</value>
		<value condition="String.IsEqual(Skin.String(duotone.watchedmarkers),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31080]</value>
	</variable>
	<variable name="NextSpotlightRotate">
		<value condition="String.IsEqual(Skin.String(duotone.spotlightrotate),30)">off</value>
		<value condition="String.IsEqual(Skin.String(duotone.spotlightrotate),off)">8</value>
		<value condition="String.IsEqual(Skin.String(duotone.spotlightrotate),8)">15</value>
		<value>30</value>
	</variable>
	<variable name="LabelSpotlightRotate">
		<value condition="String.IsEqual(Skin.String(duotone.spotlightrotate),off)">$LOCALIZE[31072]</value>
		<value condition="String.IsEqual(Skin.String(duotone.spotlightrotate),8)">8 s</value>
		<value condition="String.IsEqual(Skin.String(duotone.spotlightrotate),30)">30 s</value>
		<value>15 s</value>
	</variable>
	<variable name="NextHomeNewest">
		<value condition="String.IsEqual(Skin.String(duotone.home.newest),release)">both</value>
		<value condition="String.IsEqual(Skin.String(duotone.home.newest),both)">added</value>
		<value>release</value>
	</variable>
	<variable name="LabelHomeNewest">
		<value condition="String.IsEqual(Skin.String(duotone.home.newest),release)">$LOCALIZE[31086]</value>
		<value condition="String.IsEqual(Skin.String(duotone.home.newest),both)">$LOCALIZE[31087]</value>
		<value>$LOCALIZE[31085]</value>
	</variable>
	<!-- ==================================================================== OSD extras -->
	<variable name="OSDTimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]$INFO[Player.Duration, / ,]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
	<variable name="OSDStateLabel">
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$INFO[Player.SeekStepSize]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)">$INFO[Player.SeekOffset]</value>
		<value condition="Player.Paused">$LOCALIZE[112]</value>
		<value condition="Player.Forwarding | Player.Rewinding">$INFO[Player.PlaySpeed,,x]</value>
	</variable>
	<variable name="OSDHelpLabel">
		<value condition="Control.HasFocus(87)">$LOCALIZE[31120]</value>
		<value condition="Control.HasFocus(600)">$LOCALIZE[31121]</value>
		<value condition="Control.HasFocus(601)">$LOCALIZE[31122]</value>
		<value condition="Control.HasFocus(602)">$LOCALIZE[31123]</value>
		<value condition="Control.HasFocus(603)">$LOCALIZE[31124]</value>
		<value condition="Control.HasFocus(606)">$LOCALIZE[31125]</value>
		<value condition="Control.HasFocus(607)">$LOCALIZE[31126]</value>
		<value condition="Control.HasFocus(70046)">$LOCALIZE[31127]</value>
		<value condition="Control.HasFocus(70049)">$LOCALIZE[31128]</value>
		<value condition="Control.HasFocus(70048)">$LOCALIZE[31129]</value>
	</variable>
</includes>
