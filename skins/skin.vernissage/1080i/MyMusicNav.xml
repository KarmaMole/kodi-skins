<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music: "The listening room" (SPEC 7 / 8 / 10). Everything lives in Includes_LibViews.xml (header, views, Back to
	Home) and Includes_Library.xml (Library panel + Sets row, view picker, clean confirm, all in this window).
	Kodi id contract (Estuary Omega MyMusicNav.xml / CGUIWindowMusicNav): views listed in <views>; 3 sort by / 4 sort
	order (offscreen, clicked by the header and the panel); defaultcontrol 50 =
	Kodi focuses the view on show. Views 500,510,50 (screens/LibraryWindows.md); Timers.xml sets the first visit per content once.
	Focus map: Includes_LibViews.xml header comment. No window-level animation: the content group fades.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9501</menucontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<views>500,510,50</views>
	<!-- empty folder: an empty view can't take focus, so the header has it (LESSONS 4) -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9502)</onload>
	<controls>
		<include content="Lib_Window">
			<param name="is_video" value="false"/>
			<param name="kind" value="music"/>
			<param name="view_id" value="9501"/>
			<param name="opt_id" value="9502"/>
			<param name="sort_id" value="9503"/>
			<param name="order_click" value="Container.SetSortDirection"/>
		</include>
	</controls>
</window>
