<?xml version="1.0" encoding="UTF-8"?>
<!--
	Void skin settings (docs/skin.void/SETTINGS.md). One column of rows on the x=160 axis: name on the
	left, value on the right; OK / Right = next value, Left = previous. The focused row is white and
	grows a little; what it does is explained on the right. Reset asks for a second OK.
	Ids: 9600 rows grouplist, 9601-9610 rows. No Kodi-owned ids (custom content of skinsettings).
-->
<window>
	<defaultcontrol always="true">9601</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<onload>ClearProperty(void.resetarmed,home)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include content="Void_TopBar">
			<param name="title" value="Settings"/>
			<param name="sub" value="Void"/>
		</include>
		<control type="label">
			<left>152</left>
			<top>150</top>
			<width>1100</width>
			<height>80</height>
			<aligny>top</aligny>
			<font>serif_72</font>
			<textcolor>text</textcolor>
			<label>Void</label>
		</control>
		<control type="grouplist" id="9600">
			<left>146</left>
			<top>260</top>
			<width>1120</width>
			<height>760</height>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<!-- 1 dwell pace -->
			<control type="button" id="9601">
				<include>SkinSet_Row</include>
				<label>Information arrives</label>
				<label2>$VAR[SkinSet_DwellLabel]</label2>
				<onclick>Skin.SetString(void.dwell,$VAR[SkinSet_DwellNext])</onclick>
				<onright>Skin.SetString(void.dwell,$VAR[SkinSet_DwellNext])</onright>
				<onleft>Skin.SetString(void.dwell,$VAR[SkinSet_DwellPrev])</onleft>
			</control>
			<!-- 2 ambient -->
			<control type="button" id="9602">
				<include>SkinSet_Row</include>
				<label>Artwork rises when you rest</label>
				<label2>$VAR[SkinSet_AmbientLabel]</label2>
				<onclick>Skin.ToggleSetting(void.noambient)</onclick>
				<onright>Skin.ToggleSetting(void.noambient)</onright>
				<onleft>Skin.ToggleSetting(void.noambient)</onleft>
			</control>
			<!-- 3 ambient level -->
			<control type="button" id="9603">
				<include>SkinSet_Row</include>
				<label>Artwork brightness</label>
				<label2>$VAR[SkinSet_LevelLabel]</label2>
				<onclick>Skin.SetString(void.ambientlevel,$VAR[SkinSet_LevelNext])</onclick>
				<onright>Skin.SetString(void.ambientlevel,$VAR[SkinSet_LevelNext])</onright>
				<onleft>Skin.SetString(void.ambientlevel,$VAR[SkinSet_LevelPrev])</onleft>
				<enable>!Skin.HasSetting(void.noambient)</enable>
			</control>
			<!-- 4 Ken Burns -->
			<control type="button" id="9604">
				<include>SkinSet_Row</include>
				<label>Slow zoom on the artwork</label>
				<label2>$VAR[SkinSet_KenBurnsLabel]</label2>
				<onclick>Skin.ToggleSetting(void.nokenburns)</onclick>
				<onright>Skin.ToggleSetting(void.nokenburns)</onright>
				<onleft>Skin.ToggleSetting(void.nokenburns)</onleft>
				<enable>!Skin.HasSetting(void.noambient) + !Skin.HasSetting(void.reducemotion)</enable>
			</control>
			<!-- 5 hints -->
			<control type="button" id="9605">
				<include>SkinSet_Row</include>
				<label>Quiet hints</label>
				<label2>$VAR[SkinSet_HintsLabel]</label2>
				<onclick>Skin.ToggleSetting(void.nohints)</onclick>
				<onright>Skin.ToggleSetting(void.nohints)</onright>
				<onleft>Skin.ToggleSetting(void.nohints)</onleft>
			</control>
			<!-- 6 clock -->
			<control type="button" id="9606">
				<include>SkinSet_Row</include>
				<label>Clock</label>
				<label2>$VAR[SkinSet_ClockLabel]</label2>
				<onclick>Skin.ToggleSetting(void.noclock)</onclick>
				<onright>Skin.ToggleSetting(void.noclock)</onright>
				<onleft>Skin.ToggleSetting(void.noclock)</onleft>
			</control>
			<!-- 7 OSD auto-hide -->
			<control type="button" id="9607">
				<include>SkinSet_Row</include>
				<label>Playback controls hide after</label>
				<label2>$VAR[SkinSet_OSDLabel]</label2>
				<onclick>Skin.SetString(void.osdhide,$VAR[SkinSet_OSDNext])</onclick>
				<onright>Skin.SetString(void.osdhide,$VAR[SkinSet_OSDNext])</onright>
				<onleft>Skin.SetString(void.osdhide,$VAR[SkinSet_OSDPrev])</onleft>
			</control>
			<!-- 8 offset strip position -->
			<control type="button" id="9608">
				<include>SkinSet_Row</include>
				<label>Subtitle and audio sync strip</label>
				<label2>$VAR[SkinSet_OffsetLabel]</label2>
				<onclick condition="String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,top)</onclick>
				<onclick condition="!String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,bottom)</onclick>
				<onright condition="String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,top)</onright>
				<onright condition="!String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,bottom)</onright>
				<onleft condition="String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,top)</onleft>
				<onleft condition="!String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,bottom)</onleft>
			</control>
			<!-- 9 reduce motion -->
			<control type="button" id="9609">
				<include>SkinSet_Row</include>
				<label>Reduce motion</label>
				<label2>$VAR[SkinSet_MotionLabel]</label2>
				<onclick>Skin.ToggleSetting(void.reducemotion)</onclick>
				<onright>Skin.ToggleSetting(void.reducemotion)</onright>
				<onleft>Skin.ToggleSetting(void.reducemotion)</onleft>
			</control>
			<!-- 10 reset (second OK confirms; conditions are read once per key press) -->
			<control type="button" id="9610">
				<include>SkinSet_Row</include>
				<label>Back to the defaults</label>
				<label2>$VAR[SkinSet_ResetLabel]</label2>
				<onclick condition="String.IsEmpty(Window(Home).Property(void.resetarmed))">SetProperty(void.resetarmed,1,home)</onclick>
				<onclick condition="!String.IsEmpty(Window(Home).Property(void.resetarmed))">Skin.ResetSettings</onclick>
				<onclick condition="!String.IsEmpty(Window(Home).Property(void.resetarmed))">ClearProperty(void.resetarmed,home)</onclick>
				<onunfocus>ClearProperty(void.resetarmed,home)</onunfocus>
			</control>
		</control>
		<!-- what the focused row does -->
		<control type="textbox">
			<left>1360</left>
			<top>276</top>
			<width>400</width>
			<height>502</height>
			<font>sans_24</font>
			<textcolor>grey</textcolor>
			<label>$VAR[SkinSet_Help]</label>
		</control>
		<control type="label">
			<left>160</left>
			<top>1000</top>
			<width>1600</width>
			<height>24</height>
			<aligny>top</aligny>
			<font>caps_20</font>
			<textcolor>grey_soft</textcolor>
			<label>OK or Right for the next value[COLOR sep]  ·  [/COLOR]Left for the previous[COLOR sep]  ·  [/COLOR]Kodi's own settings: Settings</label>
		</control>
	</controls>
</window>
