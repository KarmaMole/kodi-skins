<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	TV / Radio channels (SPEC 5: Minimal). Builder F, M4. PVR is unused by Omar: correct, readable,
	never stranding (empty state offers PVR settings, Back always works).
	Kodi id contract (Estuary Omega MyPVRChannels.xml + GUIWindowPVRBase.h): view container 50,
	menucontrol 9000, sort 3 / 4, channel-group button 28, header labels 29 / 30, filter radio 31,
	show-hidden radio 6. Estuary's second view (51) and side blade are not used.
-->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<views>50</views>
	<controls>
		<include>VN_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Misc_PVRFrame">
				<param name="title" value="$LOCALIZE[19019]"/>
				<param name="show_group" value="true"/>
				<param name="options" value="Misc_PVROptions_Channels"/>
			</include>
			<include content="Misc_PVRList">
				<param name="number" value="$INFO[ListItem.ChannelNumberLabel]"/>
				<param name="text_x" value="120"/>
				<param name="label2" value="$INFO[ListItem.Title]"/>
				<param name="progress" value="ListItem.HasEpg + !ListItem.IsRecording"/>
				<param name="empty_label" value="$LOCALIZE[31922]"/>
			</include>
		</control>
	</controls>
</window>
