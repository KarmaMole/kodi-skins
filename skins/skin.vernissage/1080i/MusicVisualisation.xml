<?xml version="1.0" encoding="UTF-8"?>
<!--
	Now Playing: "The listening room" (SPEC 10, board 07). Pieces: Includes_ListeningRoom.xml (NP_Room, NP_VizHint).
	Kodi id contract (Estuary Omega MusicVisualisation.xml): 2 = the visualisation control. Hidden unless Visualiser
	mode is on (LESSONS Nocturne: it draws over whatever sits behind it); Kodi creates the visualisation add-on only
	while it is visible (LESSONS Visualiser presets), so Presets exist only in that mode.
	Focus map: 9699, a clear full-screen button (LESSONS Passe-partout / Sentence): OK / Up / Down open the transport
	row (MusicOSD), Left / Right step back / forward. Back leaves Now Playing (Kodi). The transport row auto-hides after
	5 s idle in Visualiser mode (Custom_1152, which waits for the preset list, a select dialog, the queue and
	the context menu). Its onload opens the row, so the room shows it with Play/Pause focused (board 07).
	The row lives in MusicOSD, not here: Kodi's Visualisation keymap turns Left / Right into seeks and Up / Down into
	skips in this window (LESSONS 205 / 230), so buttons here could not be walked.
-->
<window>
	<defaultcontrol always="true">9699</defaultcontrol>
	<!-- the transport row is always up in the room (board 07); in Visualiser mode it auto-hides (Custom_1152) -->
	<onload condition="Player.HasAudio + !Window.IsVisible(musicosd)">ActivateWindow(musicosd)</onload>
	<backgroundcolor>wall_static</backgroundcolor>
	<controls>
		<control type="visualisation" id="2">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<visible>$EXP[NP_VizMode]</visible>
		</control>
		<include>NP_Room</include>
		<include>NP_VizHint</include>
		<control type="button" id="9699">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<label></label>
			<texturefocus />
			<onclick>ActivateWindow(musicosd)</onclick>
			<onup>ActivateWindow(musicosd)</onup>
			<ondown>ActivateWindow(musicosd)</ondown>
			<onleft>StepBack</onleft>
			<onright>StepForward</onright>
		</control>
	</controls>
</window>
