<?xml version="1.0" encoding="UTF-8"?>
<!--
	Info during playback (SPEC 11): the wide corner placard with four lines of plot, the band and the line. Evening.
	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button (default):
	Left/Right step seek, Up/Down chapter or big step, OK opens the OSD. Info / Back closes it (Kodi).
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<label></label>
			<texturefocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>
		<include>VOSD_FullScreenInfo</include>
	</controls>
</window>
