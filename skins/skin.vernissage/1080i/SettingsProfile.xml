<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Profiles (Settings > Profiles; SPEC 5: Minimal). Builder F, M4. Estuary splits this into a
	category list (9000) showing either the options or the profiles; Groove shows both at once:
	options on the left, profiles on the right. Kodi appends its own "Add profile..." item.
	Kodi id contract (Estuary Omega SettingsProfile.xml / GUIWindowSettingsProfile): profile
	container 2, login-screen radio 4, auto-login button 5.
-->
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<backgroundcolor>wall_static</backgroundcolor>
	<controls>
		<include>VN_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="VN_TopBar">
				<param name="index" value="15"/>
				<param name="title" value="$LOCALIZE[13200]"/>
				<param name="icon" value="vn/icons/artists.png"/>
			</include>
			<!-- ====== options -->
			<include content="Misc_Caption">
				<param name="left" value="page_margin"/>
				<param name="top" value="content_top"/>
				<param name="width" value="misc_menu_w"/>
				<param name="label" value="$LOCALIZE[128]"/>
			</include>
			<control type="grouplist" id="9001">
				<left>page_margin</left>
				<top>212</top>
				<width>misc_menu_w</width>
				<height>200</height>
				<orientation>vertical</orientation>
				<onleft>noop</onleft>
				<onright>2</onright>
				<onup>9001</onup>
				<ondown>9001</ondown>
				<control type="radiobutton" id="4">
					<description>Show login screen on startup</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
					<label>$LOCALIZE[10029]</label>
				</control>
				<control type="button" id="5">
					<description>Auto login profile</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
					<label>$LOCALIZE[33084]</label>
					<label2>$INFO[System.ProfileAutoLogin]</label2>
					<enable>!Window.IsVisible(ProfileSettings) + !System.HasLoginScreen</enable>
				</control>
			</control>
			<!-- ====== profiles -->
			<include content="Misc_Caption">
				<param name="left" value="misc_col_x"/>
				<param name="top" value="content_top"/>
				<param name="width" value="misc_col_w"/>
				<param name="label" value="$LOCALIZE[13200]"/>
			</include>
			<control type="list" id="2">
				<left>misc_col_x</left>
				<top>212</top>
				<width>1080</width>
				<height>800</height>
				<onup>2</onup>
				<ondown>2</ondown>
				<onleft>9001</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<itemlayout width="1080" height="100">
					<control type="image">
						<left>16</left>
						<top>14</top>
						<width>72</width>
						<height>72</height>
						<aspectratio>scale</aspectratio>
						<texture colordiffuse="$VAR[card]">vn/white.png</texture>
					</control>
					<control type="image">
						<left>16</left>
						<top>14</top>
						<width>72</width>
						<height>72</height>
						<aspectratio>scale</aspectratio>
						<texture background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>112</left>
						<top>14</top>
						<width>900</width>
						<height>40</height>
						<font>font_label</font>
						<textcolor>$VAR[ink2]</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>112</left>
						<top>54</top>
						<width>900</width>
						<height>30</height>
						<font>font_small</font>
						<textcolor>$VAR[ink2]</textcolor>
						<label>$INFO[ListItem.Label2,$LOCALIZE[31921]  ,]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>1080</width>
						<height>rule_h</height>
						<texture colordiffuse="$VAR[rule]">common/hairline.png</texture>
					</control>
				</itemlayout>
				<focusedlayout width="1080" height="100">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>1080</width>
						<height>100</height>
						<texture border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texture>
						<visible>Control.HasFocus(2)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>list_bar_w</width>
						<height>100</height>
						<texture colordiffuse="$VAR[ink]">fork/tick.png</texture>
						<visible>Control.HasFocus(2)</visible>
					</control>
					<control type="image">
						<left>16</left>
						<top>14</top>
						<width>72</width>
						<height>72</height>
						<aspectratio>scale</aspectratio>
						<texture background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>112</left>
						<top>14</top>
						<width>900</width>
						<height>40</height>
						<font>font_label</font>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>112</left>
						<top>54</top>
						<width>900</width>
						<height>30</height>
						<font>font_small</font>
						<textcolor>$VAR[ink2]</textcolor>
						<label>$INFO[ListItem.Label2,$LOCALIZE[31921]  ,]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>1080</width>
						<height>rule_h</height>
						<texture colordiffuse="$VAR[rule]">common/hairline.png</texture>
					</control>
				</focusedlayout>
			</control>
		</control>
	</controls>
</window>
