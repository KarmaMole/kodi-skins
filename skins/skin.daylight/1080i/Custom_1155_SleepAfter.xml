<?xml version="1.0" encoding="UTF-8"?>
<!--
	"Sleep after this" engine (OSD button 70060 sets Window(Home).Property(daylight.sleepafter)).
	An empty dialog that opens itself through its window-level <visible> (same pattern as the OSD
	auto-hide, Custom_1152) whenever the state needs a nudge, does it in onload, and closes again
	because the condition is no longer true:
	  playing, no alarm yet   -> AlarmClock(daylightsleep, PlayerControl(Stop), <time remaining>, silent)
	                             (stops before Up Next / the playlist can start the next item)
	  paused with an alarm    -> CancelAlarm (re-armed with the new remaining time on resume)
	  playback has ended      -> clear the request, cancel the alarm, ActivateScreensaver
	Builtins verified in Kodi 21 Omega source: AlarmClock (hh:mm:ss accepted, GUIBuiltins.cpp),
	CancelAlarm, System.HasAlarm(name) (GUIInfoManager), ActivateScreensaver (SystemBuiltins.cpp).
	Conditions written out in full (window-level visible does not expand $EXP).
-->
<window type="dialog" id="1155">
	<visible>!String.IsEmpty(Window(Home).Property(daylight.sleepafter)) + [[Player.HasVideo + !Player.Paused + !Player.Caching + !System.HasAlarm(daylightsleep) + Integer.IsGreater(Player.TimeRemaining(secs),5)] | [Player.Paused + System.HasAlarm(daylightsleep)] | !Player.HasMedia]</visible>
	<onload condition="Player.HasVideo + !Player.Paused + !System.HasAlarm(daylightsleep)">AlarmClock(daylightsleep,PlayerControl(Stop),$INFO[Player.TimeRemaining(hh:mm:ss)],silent)</onload>
	<onload condition="Player.Paused + System.HasAlarm(daylightsleep)">CancelAlarm(daylightsleep,silent)</onload>
	<onload condition="!Player.HasMedia">CancelAlarm(daylightsleep,silent)</onload>
	<onload condition="!Player.HasMedia">ClearProperty(daylight.sleepafter,home)</onload>
	<onload condition="!Player.HasMedia">ActivateScreensaver</onload>
	<controls/>
</window>
