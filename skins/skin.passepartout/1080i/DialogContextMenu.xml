				<animation effect="slide" end="0,68" time="0" condition="Control.IsVisible(1012)">Conditional</animation>
			</control>
			<!-- header: Kodi gives the context menu no item infolabels, so the card is titled "Options" -->
			<control type="label">
				<left>48</left>
				<top>36</top>
				<width>544</width>
				<height>58</height>
				<font>ttl_48</font>
				<label>$LOCALIZE[31158]</label>
			</control>
			<control type="image">
				<left>48</left>
				<top>122</top>
				<width>544</width>
				<height>1</height>
				<texture colordiffuse="rule">common/white.png</texture>
			</control>
			<control type="grouplist" id="996">
				<description>grouplist for context buttons</description>
				<left>0</left>
				<top>135</top>
				<width>640</width>
				<height max="816">auto</height>
				<usecontrolcoords>true</usecontrolcoords>
			</control>
		</control>
		<control type="button" id="1000">
			<description>button template</description>
			<left>0</left>
			<top>0</top>
			<width>640</width>
			<height>68</height>
			<font>body_28</font>
			<textoffsetx>48</textoffsetx>
		</control>
	</controls>
</window>
