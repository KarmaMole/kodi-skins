<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from skin.groove 1.0.1 by _src/fork_from_groove.py (M1, never re-run). Names, colours, fonts and textures are Vernissage's; prose references to screens / boards in the comments below are Groove's (docs/skin.groove/) until this file is redrawn. -->
<!--
	Picture details / EXIF (SPEC 5: Minimal). Builder F, M4. Right-hand panel; the picture itself
	is shown on the left unless the slideshow is behind the dialog.
	Kodi id contract (Estuary Omega DialogPictureInfo.xml): group 9000 holding info list 5 and its
	scrollbar 60. Left / Right on the list close the dialog and step to the previous / next picture
	(Estuary behaviour). Back closes.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_DialogCard</include>
			<!-- picture (not over the slideshow) -->
			<control type="group">
				<visible>!Window.IsActive(slideshow)</visible>
				<include>VN_Page</include>
				<control type="image">
					<left>page_margin</left>
					<top>content_top</top>
					<width>1060</width>
					<height>820</height>
					<aspectratio align="left" aligny="top">keep</aspectratio>
					<fadetime>120</fadetime>
					<texture background="true">$INFO[ListItem.FolderPath]</texture>
				</control>
			</control>
			<!-- info panel -->
			<control type="group">
				<left>1240</left>
				<top>0</top>
				<width>680</width>
				<height>1080</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>680</width>
					<height>1080</height>
					<texture colordiffuse="$VAR[wall]">vn/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>rule_h</width>
					<height>1080</height>
					<texture colordiffuse="$VAR[placard_rule]">common/hairline_v.png</texture>
				</control>
				<control type="label">
					<left>40</left>
					<top>topbar_item_top</top>
					<width>584</width>
					<height>topbar_item_h</height>
					<font>font_placard_l</font>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<include content="VN_Rule">
					<param name="left" value="0"/>
					<param name="top" value="topbar_rule_y"/>
					<param name="width" value="680"/>
					<param name="color" value="$VAR[rule]"/>
				</include>
				<control type="group" id="9000">
					<control type="list" id="5">
						<left>dialog_inset</left>
						<top>136</top>
						<width>600</width>
						<height>880</height>
						<orientation>vertical</orientation>
						<onleft>Dialog.Close(all,true)</onleft>
						<onleft>Action(left)</onleft>
						<onleft>info</onleft>
						<onright>Dialog.Close(all,true)</onright>
						<onright>Action(right)</onright>
						<onright>info</onright>
						<onup>5</onup>
						<ondown>5</ondown>
						<pagecontrol>60</pagecontrol>
						<scrolltime tween="cubic" easing="out">200</scrolltime>
						<itemlayout width="600" height="55">
							<control type="label">
								<left>16</left>
								<top>0</top>
								<width>260</width>
								<height>55</height>
								<font>font_small</font>
								<textcolor>$VAR[ink2]</textcolor>
								<label>$INFO[ListItem.Label]</label>
							</control>
							<control type="label">
								<left>280</left>
								<top>0</top>
								<width>304</width>
								<height>55</height>
								<align>right</align>
								<font>font_small</font>
								<textcolor>$VAR[ink2]</textcolor>
								<label>$INFO[ListItem.Label2]</label>
							</control>
							<control type="image">
								<left>0</left>
								<bottom>0</bottom>
								<width>600</width>
								<height>rule_h</height>
								<texture colordiffuse="$VAR[rule]">common/hairline.png</texture>
							</control>
						</itemlayout>
						<focusedlayout width="600" height="55">
							<control type="image">
								<left>0</left>
								<top>0</top>
								<width>600</width>
								<height>55</height>
								<texture border="0,0,0,3" colordiffuse="$VAR[ink]">vn/row_rule.png</texture>
								<visible>Control.HasFocus(5)</visible>
							</control>
							<control type="image">
								<left>0</left>
								<top>0</top>
								<width>list_bar_w</width>
								<height>55</height>
								<texture colordiffuse="$VAR[ink]">fork/tick.png</texture>
								<visible>Control.HasFocus(5)</visible>
							</control>
							<control type="label">
								<left>16</left>
								<top>0</top>
								<width>260</width>
								<height>55</height>
								<font>font_small</font>
								<label>$INFO[ListItem.Label]</label>
							</control>
							<control type="label">
								<left>280</left>
								<top>0</top>
								<width>304</width>
								<height>55</height>
								<align>right</align>
								<font>font_small</font>
								<scroll>true</scroll>
								<label>$INFO[ListItem.Label2]</label>
							</control>
						</focusedlayout>
					</control>
					<include content="VN_Scrollbar">
						<param name="id" value="60"/>
						<param name="left" value="640"/>
						<param name="top" value="136"/>
						<param name="height" value="880"/>
						<param name="onleft" value="5"/>
						<param name="onright" value="5"/>
					</include>
				</control>
			</control>
		</control>
	</controls>
</window>
