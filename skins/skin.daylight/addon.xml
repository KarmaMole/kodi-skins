<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.daylight" version="0.9.13" name="Daylight" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<import addon="script.skinvariables" version="2.1.21"/>
		<!-- Optional: borrowed artwork colour (TMDb Helper colour service) and true Next up (embuary). -->
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
		<import addon="script.embuary.helper" version="2.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Daylight - a skin that knows what time it is.</summary>
		<description lang="en_GB">Soft, rounded and calm. Its colours follow the day (pale morning, bright afternoon, amber evening, deep blue night) and Home suggests what fits right now: films that end before your bedtime, the next episode, something long when it rains (weather needs a weather add-on set in Kodi's Settings &gt; Services &gt; Weather). Built for the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#daylight</website>
		<news>v0.9.13 - Weather hides cleanly without a weather add-on and Skin settings say where to set one; the Mood row shows Kodi's clock.</news>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
			<screenshot>resources/screenshot-06.jpg</screenshot>
		</assets>
	</extension>
</addon>
