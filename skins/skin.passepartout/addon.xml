<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.passepartout" version="0.9.14" name="Passe-partout" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required: script.skinvariables URL-encodes the search query (get_encoded_string; unencoded_paths since 2.1.21). -->
		<import addon="script.skinvariables" version="2.1.21"/>
		<!-- Optional: the art-coloured paper (TMDb Helper colour service). The skin runs on neutral paper without it. -->
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
		<import addon="script.embuary.helper" version="2.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Passe-partout - every film, framed.</summary>
		<description lang="en_GB">Every picture hangs like a gallery print in a bevel-cut mat, and the paper takes its colour from the artwork in focus. Geist throughout, museum captions, no outlines. Built for the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#passepartout</website>
		<news>v0.9.14 - Settings: choose which main menu items to show. Home: up to three custom rows from any add-on, playlist or favourite.</news>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
